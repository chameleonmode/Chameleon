<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Chameleon.client.App"
             RequestedThemeVariant="Default"
			 Name="Chameleon">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://Chameleon.app.Avalonia/Fluent/Styling/Resources.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
		<FontFamily x:Key="ContentControlThemeFontFamily">avares://Chameleon.app.Avalonia/Assets/Fonts/Nunito#Nunito</FontFamily>
	</Application.Resources>

	<Application.Styles>
		<sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True"
								 TextVerticalAlignmentOverrideBehavior="AlwaysEnabled" />
		<StyleInclude Source="avares://Chameleon.app.Avalonia/Fluent/Styling/ChameleonStyles.axaml" />
	</Application.Styles>

	<NativeMenu.Menu>
		<NativeMenu>
			<NativeMenuItem Header="Chameleon" />
		</NativeMenu>
	</NativeMenu.Menu>
</Application>
