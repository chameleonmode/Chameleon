<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:folder="using:Chameleon.client.Features.ProfilesAndFolders.Search.ByTags"
			 xmlns:controls="using:Chameleon.client.Features.ProfilesAndFolders.Search.ByTags.Controls"
			 xmlns:models="using:Chameleon.client.Features.ProfilesAndFolders.Search"
			 x:DataType="models:MainAppSearchItem"
             x:Class="Chameleon.client.Features.ProfilesAndFolders.Search.ByTags.TagsView">
	<Border Padding="5" CornerRadius="5" >
		<ItemsControl ItemsSource="{Binding Items}">
			<ItemsControl.ItemTemplate>
				<folder:TagsTemplateSelector>
					<DataTemplate x:Key="Folder">
						<controls:TagFolderSearchControl/>
					</DataTemplate>
					<DataTemplate x:Key="Profile">
						<controls:TagProfilesSearchControl/>
					</DataTemplate>
				</folder:TagsTemplateSelector>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Border>
</UserControl>
