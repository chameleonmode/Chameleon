<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="850"
			 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:Chameleon.app.Avalonia.Controls"
			 xmlns:vm="using:Chameleon.client.Features.Automation.AI.ChameleonAIR"
             x:Class="Chameleon.client.Features.Automation.AI.ChameleonAIR.ChameleonAIRView"
			 x:DataType="vm:ChameleonAIRViewModel"
			 x:CompileBindings="True">
	<Grid RowDefinitions="Auto, *">
		<afv:ChameleonContentControl Title="AIR0bot"
									 TitleDescription="Taskforce AI Reimagined">
			
			<afv:ChameleonContentControl.Content>
				<TextBlock Text="Comming soon..."
					  	   Theme="{StaticResource SubtitleTextBlockStyle}"/>
			</afv:ChameleonContentControl.Content>
			
		</afv:ChameleonContentControl>
	</Grid>
</UserControl>
