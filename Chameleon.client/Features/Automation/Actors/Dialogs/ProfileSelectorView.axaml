<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
						 xmlns:afv="using:Chameleon.client.UI.Controls"
             xmlns:vm="using:Chameleon.client.Features.Automation.Actors.Dialogs"
             xmlns:profiles="using:Chameleon.client.Features.Projects.Profiles"
             xmlns:dd="using:DynamicData" 
			 xmlns:System="using:System"
             x:DataType="vm:ProfileSelectorViewModel"
             x:CompileBindings="True" x:Class="Chameleon.client.Features.Automation.Actors.Dialogs.ProfileSelectorView" MinHeight="250">

	<UserControl.Resources>
		<DataTemplate x:Key="ProfileItemTemplate" x:DataType="vm:ProfileOrFolderItem">
			<Grid ColumnDefinitions="Auto,*" Margin="25,0,0,0" IsVisible="{Binding IsProfile}">
				<CheckBox Grid.Column="0"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
				<profiles:UserProfileUserControl Grid.Column="1"
                                                 DataContext="{Binding Profile}" />
			</Grid>
		</DataTemplate>

	</UserControl.Resources>

	<afv:ChameleonDialogControl>
		<afv:ChameleonDialogControl.Content>
			<StackPanel Spacing="10">
				<TextBox Text="{Binding SearchText, Mode=TwoWay}"
						 Watermark="Search..."
						 Margin="0,0,0,5"
				/>

				<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
					<ItemsControl ItemsSource="{Binding DisplayGroups}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:GroupedProfiles">
								<Expander IsExpanded="False" Margin="0,0,0,5">
									<Expander.Header>
										<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
											<CheckBox IsThreeState="True" IsChecked="{Binding IsGroupSelected}"/>
											<TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,6,0,0"/>
										</StackPanel>
									</Expander.Header>
									<Expander.Content>
										<ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
											<ItemsControl ItemsSource="{Binding ProfileItems}"
														  ItemTemplate="{StaticResource ProfileItemTemplate}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<WrapPanel Orientation="Horizontal" />
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
											</ItemsControl>
										</ScrollViewer>
									</Expander.Content>
								</Expander>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

			</StackPanel>
		</afv:ChameleonDialogControl.Content>
	</afv:ChameleonDialogControl>
</UserControl>