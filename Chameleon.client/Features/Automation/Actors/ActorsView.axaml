<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="850"
			 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:Chameleon.app.Avalonia.Controls"
			 xmlns:vm="using:Chameleon.client.Features.Automation.Actors"
             x:Class="Chameleon.client.Features.Automation.Actors.ActorsView"
			 x:DataType="vm:ActorsViewModel"
			 x:CompileBindings="True">
	<Grid RowDefinitions="Auto, *">
		<afv:ChameleonContentControl Title="Agents"
									 TitleDescription="Mr. AI-Robot Automation Agents">
			
			<!-- <afv:ChameleonContentControl.Options>
				<Grid RowDefinitions="*, Auto">
						<ui:CommandBar Grid.Row="1"
									   HorizontalAlignment="Right" 
									   DefaultLabelPosition="Right"
									   OverflowButtonVisibility="Collapsed">
							<ui:CommandBar.PrimaryCommands>
								<ui:CommandBarButton HorizontalAlignment="Right"
									IconSource="Save"
									Label="Save"
									CommandParameter="Save"
									Command="{Binding AsyncCfVCommand}"/>
							</ui:CommandBar.PrimaryCommands>
						</ui:CommandBar>
				</Grid>
			</afv:ChameleonContentControl.Options> -->
			
			<afv:ChameleonContentControl.Content>
					<ListBox
						VerticalAlignment="Top"
						ItemsSource="{Binding Actors}"
						Theme="{StaticResource ListBoxNoScroller}"
						ItemContainerTheme="{StaticResource GridViewItem}">
						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="1"/>
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="50"/>
									</Grid.ColumnDefinitions>

									<!-- Title -->
									<TextBlock
										Grid.Column="0"
										Text="{Binding Title}"
										ToolTip.Tip="{Binding Description}"
										VerticalAlignment="Center"
										HorizontalAlignment="Left"
										Theme="{StaticResource BodyStrongTextBlockStyle}"
										TextTrimming="CharacterEllipsis"
										TextWrapping="NoWrap"
										Margin="5 5 10 5"/>

									<!-- Description -->
									<!--<TextBlock
										Grid.Column="1"
										Text="{Binding Description}"
										ToolTip.Tip="{Binding Description}"
										VerticalAlignment="Center"
										Theme="{StaticResource CaptionTextBlockStyle}"
										Margin="10 5 5 5"
										TextWrapping="NoWrap"/>-->

									<!-- PopUp Buttom -->
									<Button
									   Grid.Column="2"
									   Command="{Binding OpenParamsPopupCommand}"
									   CommandParameter="{Binding Title}"
									   IsVisible="{Binding HasParameters}"
									   ToolTip.Tip="Set Parameters"
									   Content="three-dots"
									   Theme="{DynamicResource SvgIconButton}">
									</Button>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

			</afv:ChameleonContentControl.Content>
			
		</afv:ChameleonContentControl>
	</Grid>
</UserControl>
