<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="1680"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:afv="using:Chameleon.client.UI.Controls"
			 xmlns:profiles="using:Chameleon.client.Features.Projects.Profiles"
			 xmlns:vm="using:Chameleon.client.Features.Automation.Actors"
			 xmlns:vmv="using:Chameleon.client.Features.Automation.Actors.ViewModels"
			 xmlns:models="using:Chameleon.AIR.Actors.Models"
			 xmlns:redditModels="using:Chameleon.AIR.Actors.Models.Reddit"
			 x:Class="Chameleon.client.Features.Automation.Actors.ActorsView"
			 x:DataType="vm:ActorsViewModel"
			 x:CompileBindings="True">
	<UserControl.Styles>
		<Style Selector="TextBox">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<Style Selector="ContentControl">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<Style Selector="ComboBox">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="ToggleSwitch">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto, *">
		<afv:ChameleonContentControl Title="Agents" TitleDescription="Robotic Automation Agents">
			<afv:ChameleonContentControl.TitleContent>
				<Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Right">
					<StackPanel Classes="zontal" Grid.Column="1" Margin="4">
					<ui:FAComboBox SelectedItem="{Binding Browser}" ItemsSource="{Binding BrowserOptions}">
						<ui:FAComboBox.ItemTemplate>
							<DataTemplate>
								<afv:SvgIcon IconName="{Binding IconName}" Height="20" Width="20" />
							</DataTemplate>
						</ui:FAComboBox.ItemTemplate>
					</ui:FAComboBox>
					<Button Content="Save"
							IsVisible="{Binding !SelectedActor.Running}"
							Command="{Binding SelectedActor.AsyncCfVCommand}"
							CommandParameter="Save"/>
					<Button Content="Run"
							IsVisible="{Binding !SelectedActor.Running}"
							Command="{Binding SelectedActor.AsyncCfVCommand}"
							CommandParameter="Run"/>
					<Button Content="Stop"
							IsVisible="{Binding SelectedActor.Running}"
							Command="{Binding SelectedActor.CfVCommand}"
							CommandParameter="Stop"/>
					</StackPanel>
				</Grid>
			</afv:ChameleonContentControl.TitleContent>
			<afv:ChameleonContentControl.Content>
				<ListBox ItemsSource="{Binding Actors}" Classes="uni">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:ActorViewModel">
							<ui:SettingsExpander IsExpanded="True">
								<ui:SettingsExpander.Header>
									<Panel>
										<TextBlock Text="{Binding EditableSettings.Start.Feature}"
												   Classes="b1"
												   VerticalAlignment="Center"
												   HorizontalAlignment="Left"/>
									</Panel>
								</ui:SettingsExpander.Header>
								
								<ui:SettingsExpanderItem>
									<StackPanel Spacing="6">
										<afv:ChameleonContentControl Title="Robotomation" TitleDescription="auto robo autonomous roboto automations">
											<afv:ChameleonContentControl.TitleContent>
												<Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Right">
													<StackPanel Classes="zontal" Grid.Column="1">
														<ToggleSwitch ToolTip.Tip="to start in a new tab (recommended)"
																	  IsChecked="{Binding EditableSettings.Start.New}" 
																	  OffContent="Active Tab" 
																	  OnContent="New Tab"/>
														<ToggleSwitch ToolTip.Tip="Run all actionable actions or one each"
																	  IsChecked="{Binding EditableSettings.AsQue}" 
																	  OffContent="Run All" 
																	  OnContent="One Each"/>
														<ToggleSwitch ToolTip.Tip="Run all selected automations for each profile, or run all profiles for each automation"
																	  IsChecked="{Binding EditableSettings.EachProfile}" 
																	  OffContent="Each Profile" 
																	  OnContent="Each Selection"/>
														<ToggleSwitch ToolTip.Tip="Close browser instances for the previous profile before moving to the next"
																	  IsChecked="{Binding EditableSettings.CloseOldBrowserProfileAfterRun}" 
																	  OffContent="Keep Open" 
																	  OnContent="Close"/>
													</StackPanel>
												</Grid>
											</afv:ChameleonContentControl.TitleContent>

											<afv:ChameleonContentControl.Header>
												<StackPanel>
													<StackPanel Spacing="6">
														<TextBlock Text="Tags"  Classes="b1" Margin="4 6"  ToolTip.Tip="select a tag that contain a grouping of profiles to inceptionalize" />
														<ScrollViewer ScrollViewer.HorizontalScrollBarVisibility="Auto">
															<ItemsControl ItemsPanel="{StaticResource HorizontalStackPanel}" ItemsSource="{Binding Tagz}">
																<ItemsControl.ItemTemplate>
																	<DataTemplate x:DataType="vm:Tag">
																		<ToggleButton IsChecked="{Binding IsSelected}" Content="{Binding Dto.Name}" ToolTip.Tip="{Binding ToolTipText}"/>
																	</DataTemplate>
																</ItemsControl.ItemTemplate>
															</ItemsControl>
														</ScrollViewer>

														<TextBlock Text="Profiles" Margin="4 12 4 6" ToolTip.Tip="selected profiles" Classes="b1"/>
														<Grid ColumnDefinitions="Auto,*">
															<Button Content="..."
																	Command="{Binding AsyncCfVCommand}"
																	CommandParameter="OpenProfileSelector"
																	Theme="{StaticResource AccentTextButton}"
																	ToolTip.Tip="Select N Edit"
																	Margin="4,6"/>
															<ScrollViewer Grid.Column="1" 
																		  ScrollViewer.HorizontalScrollBarVisibility="Auto">
																<ItemsControl ItemsPanel="{StaticResource HorizontalStackPanel}"
																			  ItemsSource="{Binding SelectedProfiles}">
																	<ItemsControl.ItemTemplate>
																		<DataTemplate x:DataType="profiles:ObsProfile">
																			<ToggleButton IsChecked="{Binding Active}"
																						  Content="{Binding Title}"/>
																		</DataTemplate>
																	</ItemsControl.ItemTemplate>
																</ItemsControl>
															</ScrollViewer>
														</Grid>

														<!-- <TextBlock Text="Automations"
																   ToolTip.Tip="auto robo autonomous roboto"
																   Margin="4 12 4 6"
																   Classes="b1"/>
														<ItemsControl ItemsSource="{Binding Selections}" ItemsPanel="{StaticResource HorizontalStackPanel}">
															<ItemsControl.ItemTemplate>
																<DataTemplate x:DataType="vm:Selection">
																	<ToggleButton IsChecked="{Binding Selected}" Content="{Binding Script.Title}"  ToolTip.Tip="{Binding Script.Description}"/>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl> -->
													</StackPanel>
												</StackPanel>
											</afv:ChameleonContentControl.Header>

											<afv:ChameleonContentControl.Content>
												<StackPanel Margin="0 8 0 0">

													<StackPanel Classes="shared" Margin="6 0 6 6">
														<afv:Inputter Title="Search:"
															 Description="comma seperated list of search terms"
															 Watermark="comma seperated list of search terms"
															 Text="{Binding EditableArgs.Search}"
															 Theme="{StaticResource Inputz}"/>																		
															<afv:Inputter Title="URL's:"
																 Description="(experimental) list of urls (&#x0a;https://www.reddit.com/r/*&#x0a;https://www.reddit.com/search/*&#x0a;https://www.reddit.com/r/*/search/*&#x0a;https://www.reddit.com/r/*/comments/*&#x0a;)">
																	<TextBox Text="{Binding EditableSettings.Start.Url}" AcceptsReturn="True" TextWrapping="Wrap"
																	 	Watermark="https://www.reddit.com/r/*&#x0a;https://www.reddit.com/search/*&#x0a;https://www.reddit.com/r/*/search/*&#x0a;https://www.reddit.com/r/*/comments/*" />
															</afv:Inputter>
														<UniformGrid Columns="3" Rows="1">
															<afv:Inputter Title="Scope:" Description="scope of the search">
																<ComboBox ItemsSource="{Binding EditableArgs.AvailableScopes}" SelectedItem="{Binding EditableArgs.SelectedScope}" />
															</afv:Inputter>
															<afv:Inputter Title="Sort:" Description="sort order of the search">
																<ComboBox ItemsSource="{Binding EditableArgs.AvailableSorts}" SelectedItem="{Binding EditableArgs.SelectedSort}" />
															</afv:Inputter>
															<afv:Inputter Title="Filter:" Description="filter to apply to the search">
																<ComboBox ItemsSource="{Binding EditableArgs.AvailableFilters}"  SelectedItem="{Binding EditableArgs.SelectedFilter}" />
															</afv:Inputter>
														</UniformGrid>


																	<StackPanel Classes="shared" DataContext="{Binding EditableSettings}">
																						<!-- <TextBlock Classes="caption"
																								   Margin="0 0 0 8">
																							<Run Text="Control settings for auto robo behavior and generation"/>
																						</TextBlock> -->
																		<afv:Inputter Title="Auto:" Description="auto robo generation and behavior">
																			<UniformGrid Rows="1">
																			 <UniformGrid.Styles>
																			 		<Style Selector="ui|NumberBox">
																						<Setter Property="SpinButtonPlacementMode" Value="Compact"/>
																						<Setter Property="Maximum" Value="999"/>
																					</Style>
																			 		<Style Selector="afv|Inputter">
																						<Setter Property="Margin" Value="4 0 0 0"/>
																					</Style>
																			 </UniformGrid.Styles>
																				<afv:Inputter Title="Terms:"
																								   Description="Adds AI related keywords based on search terms">
																					<ui:NumberBox Value="{Binding Start.Variations.Min}" />
																				</afv:Inputter>
																				<afv:Inputter Title="Runs:"
																								   Description="Number of times to run each automation per search term">
																					<ui:NumberBox Value="{Binding Start.Iterations.Min}" />
																				</afv:Inputter>
																				<afv:Inputter Title="Retry:"
																								   Description="Maximum re-try on unexpected situations">
																					<ui:NumberBox Value="{Binding Start.Attempts}"/>
																				</afv:Inputter>
																				<afv:Inputter Title="Rando:"
																								   Description="Min-max activity value for voting and joining">
																					<ui:NumberBox Value="{Binding Rando}" />
																				</afv:Inputter>
																				<afv:Inputter Title="Speed:"
																									 Description="robo movement speed in milliseconds">
																					<ui:NumberBox Value="{Binding Timeouts.Naps.Min}" />
																				</afv:Inputter>
																				<afv:Inputter Title="Delay:"
																									 Description="auto loop speed between runs in seconds">
																					<ui:NumberBox Value="{Binding Delay}" />
																				</afv:Inputter>
																			</UniformGrid>
																		</afv:Inputter>
																	</StackPanel>
													</StackPanel>

													<ContentControl Content="{Binding AiSettings}">
														<ContentControl.ContentTemplate>
															<DataTemplate x:DataType="models:AI">
																<StackPanel Spacing="6">
																	<Expander Header="Inception"
																			  Margin="0 6"
																			  IsExpanded="True">
																		<ContentControl Content="{Binding Decorators}">
																			<ContentControl.ContentTemplate>
																				<DataTemplate x:DataType="models:Decorations">
																					<StackPanel Classes="shared">
																						<TextBlock Classes="caption"
																								   Margin="0 0 0 8">
																							<Run Text="prompt decorations helps keep the auto robo model 'on brand'"/>
																						</TextBlock>
																						<afv:Inputter Title="System:"
																										   Description="most helpful for the model consistency"
																										   Watermark="You are helpful..."
																										   Text="{Binding System, Mode=TwoWay}"
																										   Theme="{StaticResource Inputz}"/>
																						<afv:Inputter Title="Human:"
																										   Description="Human persona description"
																										   Watermark="...(eg. reddit content creator, reddit user, etc.)"
																										   Text="{Binding Human, Mode=TwoWay}"
																										   Theme="{StaticResource Inputz}"/>
																						<afv:Inputter Title="Audience:"
																										   Description="Target audience"
																										   Watermark="...(eg: reddit users who are interested in..., reddit users who are looking for..., etc.)"
																										   Text="{Binding Audience, Mode=TwoWay}"
																										   Theme="{StaticResource Inputz}"/>
																						<afv:Inputter Title="Background:"
																										   Description="Background context"
																										   Watermark="...(eg: I am surfing reddit... You... etc.)"
																										   Text="{Binding Background, Mode=TwoWay}"
																										   Theme="{StaticResource Inputz}"/>
																						<afv:Inputter Title="Tone:"
																										   Description="Communication tone"
																										   Watermark="...(eg: friendly and professional with..., public figure, adaptive to the task, etc.)"
																										   Text="{Binding Tone, Mode=TwoWay}"
																										   Theme="{StaticResource Inputz}"/>
																					</StackPanel>
																				</DataTemplate>
																			</ContentControl.ContentTemplate>
																		</ContentControl>
																	</Expander>
																</StackPanel>
															</DataTemplate>
														</ContentControl.ContentTemplate>
													</ContentControl>

													<!-- <ContentControl Content="{Binding EditableSettings}">
														<ContentControl.ContentTemplate>
															<DataTemplate x:DataType="vmv:SettingsViewModel">
																<Expander Header="Run" IsExpanded="True" Margin="0 6">
																	<StackPanel Classes="shared">
																		<afv:Inputter Title="Auto:" 
																						   Description="Controls for auto robo behavior and keyword generation">
																			<UniformGrid Columns="4" Rows="1">
																			 <UniformGrid.Styles>
																			 		<Style Selector="ui|NumberBox">
																						<Setter Property="SpinButtonPlacementMode" Value="Compact"/>
																					</Style>
																			 </UniformGrid.Styles>
																				<afv:Inputter Title="Keywords:"
																								   Description="Adds AI related keywords based on search terms">
																					<ui:NumberBox Value="{Binding Start.Variations.Min}" />
																				</afv:Inputter>

																				<afv:Inputter Title="Runs:"
																								   Description="Number of times to run each automation per search term">
																					<ui:NumberBox Value="{Binding Start.Iterations.Min}" />
																				</afv:Inputter>

																				<afv:Inputter Title="Attempts:"
																								   Description="Maximum re-try on unexpected situations">
																					<ui:NumberBox Value="{Binding Start.Attempts}"/>
																				</afv:Inputter>

																				<afv:Inputter Title="Rando:"
																								   Description="Min-max activity value for voting and joining">
																					<ui:NumberBox Value="{Binding Rando}" />
																				</afv:Inputter>
																			</UniformGrid>
																		</afv:Inputter>

																		<afv:Inputter Title="Timers:" Description="in seconds">
																			<UniformGrid Columns="4" Rows="1">
																			 <UniformGrid.Styles>
																			 		<Style Selector="ui|NumberBox">
																						<Setter Property="SpinButtonPlacementMode" Value="Compact"/>
																					</Style>
																			 </UniformGrid.Styles>
																				<afv:Inputter Title="Delay:" Description="before starting the next task">
																					<ui:NumberBox Value="{Binding Delay}" />
																				</afv:Inputter>
																				<afv:Inputter Title="Navigate:" Description="for page load">
																					<ui:NumberBox Value="{Binding Timeouts.Navigate}" />
																				</afv:Inputter>
																				<afv:Inputter Title="Default:" Description="in general">
																					<ui:NumberBox Value="{Binding Timeouts.Default}" />
																				</afv:Inputter>
																				<afv:Inputter Title="Wait:" Description="for actions to complete">
																					<ui:NumberBox Value="{Binding Timeouts.Wait}" />
																				</afv:Inputter>
																			</UniformGrid>
																		</afv:Inputter>

																		<afv:Inputter Title="Sleepers:" Description="in milliseconds">
																			<UniformGrid Columns="3" Rows="1">
																				<afv:Inputter Title="Min:">
																					<ui:NumberBox Value="{Binding Timeouts.Naps.Min}"
																						 SpinButtonPlacementMode="Compact" />
																				</afv:Inputter>
																				<afv:Inputter Title="Max:">
																					<ui:NumberBox Value="{Binding Timeouts.Naps.Max}"
																						 SpinButtonPlacementMode="Compact" />
																				</afv:Inputter>
																				<afv:Inputter Title="Multi:" Description="time multiplier">
																					<ui:NumberBox Value="{Binding Timeouts.Naps.Multiplier, TargetNullValue='0'}"
																						 SpinButtonPlacementMode="Compact" />
																				</afv:Inputter>
																			</UniformGrid>
																		</afv:Inputter>
																	</StackPanel>
																</Expander>
															</DataTemplate>
														</ContentControl.ContentTemplate>
													</ContentControl> -->
												</StackPanel>
											</afv:ChameleonContentControl.Content>
										</afv:ChameleonContentControl>
									</StackPanel>
								</ui:SettingsExpanderItem>

								<ui:SettingsExpander.Footer>
														<ItemsControl ItemsSource="{Binding Selections}" ItemsPanel="{StaticResource HorizontalStackPanel}">
															<ItemsControl.ItemTemplate>
																<DataTemplate x:DataType="vm:Selection">
																	<ToggleButton IsChecked="{Binding Selected}" Content="{Binding Script.Title}"  ToolTip.Tip="{Binding Script.Description}"/>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>
								</ui:SettingsExpander.Footer>
							</ui:SettingsExpander>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</afv:ChameleonContentControl.Content>
		</afv:ChameleonContentControl>
	</Grid>
</UserControl>
