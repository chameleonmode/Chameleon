<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="850"
             xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Chameleon.client.Features.Automation.Actors"
             xmlns:vmv="using:Chameleon.client.Features.Automation.Actors.ViewModels"
             xmlns:models="using:Chameleon.AIR.Actors.Models"
			       xmlns:modelsObservable="using:Chameleon.app.Avalonia.Models.Observable"
             xmlns:redditModels="using:Chameleon.AIR.Actors.Models.Reddit"
             x:Class="Chameleon.client.Features.Automation.Actors.ActorsView"
             x:DataType="vm:ActorsViewModel"
             x:CompileBindings="True">
	<UserControl.Styles>
		<Style Selector="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0 0 4 0"/>
			<Setter Property="Cursor" Value="Help"/>
		</Style>

		<Style Selector="TextBox">
			<Setter Property="Margin" Value="4"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<Style Selector="ContentControl">
			<Setter Property="Margin" Value="4 0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<Style Selector="ComboBox">
			<Setter Property="Margin" Value="4"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="ToggleSwitch">
			<Setter Property="Margin" Value="4 0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
		</Style>

		<Style Selector="ui|NumberBox">
			<Setter Property="Margin" Value="4"/>
			<Setter Property="Minimum" Value="0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="SpinButtonPlacementMode" Value="Inline"/>
			<Setter Property="AcceptsExpression" Value="False"/>
			<Setter Property="ValidationMode" Value="InvalidInputOverwritten"/>
		</Style>
	</UserControl.Styles>

	<UserControl.Resources>
		<ResourceDictionary>
			<DataTemplate x:Key="AITemplate" x:DataType="models:Decorations">
				<Grid ColumnDefinitions="Auto,*"
					RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
					<TextBlock Text="System:"
						Grid.Row="0"
						ToolTip.Tip="System instructions" />
					<TextBox
						Grid.Row="0"
						Grid.Column="1"
						Watermark="You are a helpful assistant..."
						Text="{Binding System, Mode=TwoWay}"/>

					<TextBlock Text="Prefix:"
						Grid.Row="1"
						ToolTip.Tip="Text to add before the prompt" />
					<TextBox
						Grid.Row="1"
						Grid.Column="1"
						Watermark="As a... you know how to... consider the following:"
						Text="{Binding Prefix, Mode=TwoWay}"/>

					<TextBlock Text="Human:"
						Grid.Row="2"
						ToolTip.Tip="Human persona description" />
					<TextBox
						Grid.Row="2"
						Grid.Column="1"
						Watermark="I am... (eg. reddit content creator who...)"
						Text="{Binding Human, Mode=TwoWay}"/>

					<TextBlock Text="Audience:"
						Grid.Row="3"
						ToolTip.Tip="Target audience" />
					<TextBox
						Grid.Row="3"
						Grid.Column="1"
						Watermark="the target audience is... (eg: reddit users who...)"
						Text="{Binding Audience, Mode=TwoWay}"/>

					<TextBlock Text="Background:"
						Grid.Row="4"
						ToolTip.Tip="Background context" />
					<TextBox
						Grid.Row="4"
						Grid.Column="1"
						Watermark="up until this point... (eg: I... You... etc.)"
						Text="{Binding Background, Mode=TwoWay}"/>

					<TextBlock Text="Tone:"
						Grid.Row="5"
						ToolTip.Tip="Communication tone" />
					<TextBox
						Grid.Row="5"
						Grid.Column="1"
						Watermark="The tone in your communication is... (eg: friendly and professional with.. etc.)"
						Text="{Binding Tone, Mode=TwoWay}"/>

					<TextBlock Text="Suffix:"
						Grid.Row="6"
						ToolTip.Tip="Text to add after the prompt" />
					<TextBox
						Grid.Row="6"
						Grid.Column="1"
						Watermark="In you response and reasoning be as... (eg: creative as possible.)"
						Text="{Binding Suffix, Mode=TwoWay}"/>
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="ArgsTemplate" x:DataType="vmv:ArgsViewModel">
				<Grid ColumnDefinitions="Auto,*"
					RowDefinitions="Auto,Auto,Auto,Auto">
					<TextBlock Text="Search:"
						Grid.Row="0"
						ToolTip.Tip="comma seperated list of search terms" />
					<TextBox
						Grid.Row="0"
						Grid.Column="1"
						Watermark="comma seperated list of search terms"
						Text="{Binding Search, Mode=TwoWay}"/>

					<TextBlock Text="Scope:"
						ToolTip.Tip="scope of the search"
						Grid.Row="1" />
					<ComboBox
						Grid.Row="1"
						Grid.Column="1"
						ItemsSource="{Binding AvailableScopes}"
						SelectedItem="{Binding SelectedScope, Mode=TwoWay}" />

					<TextBlock Text="Sort:"
						ToolTip.Tip="sort order of the search"
						Grid.Row="2" />
					<ComboBox
						Grid.Row="2"
						Grid.Column="1"
						ItemsSource="{Binding AvailableSorts}"
						SelectedItem="{Binding SelectedSort, Mode=TwoWay}"/>

					<TextBlock Text="Filter:"
						ToolTip.Tip="filter to apply to the search"
						Grid.Row="3" />
					<ComboBox
						Grid.Row="3"
						Grid.Column="1"
						ItemsSource="{Binding AvailableFilters}"
						SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="StartEditorTemplate" x:DataType="models:Start">
				<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
					<!-- 
						<TextBlock Classes="sideLabel" Grid.Row="0" Grid.Column="0" Text="Feature:"/>
						<TextBox Classes="sideInput" Grid.Row="0" Grid.Column="1" Text="{Binding Feature, Mode=TwoWay}"/> 
					-->
					<!-- Using &#x0a; for line breaks -->
					<TextBlock Text="URL's:"
						Grid.Row="0"
						ToolTip.Tip="(experimental) list of urls (&#x0a;https://www.reddit.com/r/*&#x0a;https://www.reddit.com/search/*&#x0a;https://www.reddit.com/r/*/search/*&#x0a;https://www.reddit.com/r/*/comments/*&#x0a;)" />
					<TextBox
						Grid.Row="0"
						Grid.Column="1"
						AcceptsReturn="True"
         				TextWrapping="Wrap"
						Watermark="https://www.reddit.com/r/*&#x0a;https://www.reddit.com/search/*&#x0a;https://www.reddit.com/r/*/search/*&#x0a;https://www.reddit.com/r/*/comments/*"
						Text="{Binding Url, Mode=TwoWay, TargetNullValue=''}"/>

					<TextBlock 
						Grid.Row="1" 
						Text="Max Attempts:" 
						ToolTip.Tip="maximum number of attempts to try untill a successfull iteration"
					/>
					<ui:NumberBox 
						Grid.Row="1" 
						Grid.Column="1" 
						Value="{Binding Attempts, Mode=TwoWay}"/>

					<TextBlock 
						Grid.Row="2" 
						Text="AI Keywords:" 
						ToolTip.Tip="Adds AI related keywords when set above 1-1."
					/>
					<ContentControl 
						Grid.Row="2" 
						Grid.Column="1" 
						Content="{Binding Variations}"
						ContentTemplate="{StaticResource RandoEditorTemplate}"/>

					<TextBlock 
						Grid.Row="3" 
						Text="Automations:" 
						ToolTip.Tip="Amount of iterations to run per search term. (for example each keyword will result in a search result of multiple posts. This setting allows for control over ho many times an automation such as Join will select a post with a joinable subreddit join/subscribe to it then go back to the search results and repeat the process of finding a joinable subreddit under the same keyword for a min-max amount of times. All other automations run in the same way.)"
					/>
					<ContentControl 
						Grid.Row="3" 
						Grid.Column="1" 
						Content="{Binding Iterations}"
						ContentTemplate="{StaticResource RandoEditorTemplate}"/>

					<TextBlock 
						Grid.Row="4" 
						Text="Randomization:" 
						ToolTip.Tip="Predictable hash value to reference min-max activity while performing things such as voting, joining a subreddit set to 0-0 and select only the vote automation to act as a 'search warm up' (to seed the account with random activity of time spent to nudge its TikTok algorithm to link your account to those keywords)." 
					/>
					<ContentControl 
						Grid.Row="4" 
						Grid.Column="1" 
						Content="{Binding Rando}"
						ContentTemplate="{StaticResource RandoEditorTemplate}" />

					<TextBlock 
						Grid.Row="5" 
						Text="New Tab:" 
						ToolTip.Tip="to start in a new tab (recommended)" 
					/>
					<ToggleSwitch 
						Grid.Row="5" 
						Grid.Column="1" 
						IsChecked="{Binding New, Mode=TwoWay}" OffContent="" OnContent=""/>

					<TextBlock
						Grid.Row="6" 
						Text="All The Things:" 
						ToolTip.Tip="(experimental) no settings left behind" 
					/>
					<ToggleSwitch 
						Grid.Row="6" 
						Grid.Column="1" 
						IsChecked="{Binding All, Mode=TwoWay}" OffContent="" OnContent=""/>
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="RandoEditorTemplate" x:DataType="models:Rando">
				<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
					<TextBlock Text="Min:"/>
					<ui:NumberBox Value="{Binding Min, Mode=TwoWay}"
						SpinButtonPlacementMode="Compact" />
					<TextBlock Text="Max:"/>
					<ui:NumberBox Value="{Binding Max, Mode=TwoWay}"
						SpinButtonPlacementMode="Compact" />
				</StackPanel>
			</DataTemplate>

			<DataTemplate x:Key="TimeoutsEditorTemplate" x:DataType="models:Timeouts">
				<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
					<TextBlock Text="Navigate:"
						Grid.Row="0"
						ToolTip.Tip="max time to wait for page load"/>
					<ui:NumberBox
						Grid.Row="0"
						Grid.Column="1"
						Value="{Binding Navigate, Mode=TwoWay}"/>

					<TextBlock Text="Default:"
						Grid.Row="1"
						Grid.Column="0"
						ToolTip.Tip="max time to wait in general"/>
					<ui:NumberBox
						Grid.Row="1"
						Grid.Column="1"
						Value="{Binding Default, Mode=TwoWay}"/>

					<TextBlock Text="Wait:"
						Grid.Row="2"
						Grid.Column="0"
						ToolTip.Tip="max time to wait for actions to complete"/>
					<ui:NumberBox
						Grid.Row="2"
						Grid.Column="1"
						Value="{Binding Wait, Mode=TwoWay}" />

					<TextBlock Text="Naps:"
						Grid.Row="3"
						ToolTip.Tip="milliseconds between actions to simulate natural user interactions" />
					<ContentControl
						Grid.Row="3"
						Grid.Column="1"
						Classes="sideInput"
						VerticalAlignment="Center"
						Content="{Binding Naps}">
						<ContentControl.ContentTemplate>
							<DataTemplate x:DataType="models:Rando">
								<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
									<TextBlock Text="Min:"/>
									<ui:NumberBox
										Value="{Binding Min, Mode=TwoWay}"
										SpinButtonPlacementMode="Compact"/>
									<TextBlock Text="Max:"/>
									<ui:NumberBox
										Value="{Binding Max, Mode=TwoWay}"
										SpinButtonPlacementMode="Compact"/>
									<TextBlock Text="Multiplier:"/>
									<ui:NumberBox
										Value="{Binding Multiplier, Mode=TwoWay, TargetNullValue='0'}"
										SpinButtonPlacementMode="Compact" />
								</StackPanel>
							</DataTemplate>
						</ContentControl.ContentTemplate>
					</ContentControl>
				</Grid>
			</DataTemplate>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid RowDefinitions="Auto, *">
		<afv:ChameleonContentControl Title="Agents"
                                     TitleDescription="Robotic Automation Agents">
			<afv:ChameleonContentControl.Content>
				<ListBox ItemsSource="{Binding Actors}"
						 Classes="uniColumn">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:ActorViewModel">
							<ui:SettingsExpander Header="{Binding EditableSettings.Start.Feature}"
								IsExpanded="True">
								<ui:SettingsExpanderItem>
									<StackPanel Spacing="6">
										<TextBlock Text="Tags"
											Margin="4 6"
											ToolTip.Tip="select a tag that contain a grouping of profiles to inceptionalize"
											Theme="{StaticResource BodyStrongTextBlockStyle}"/>
										<ScrollViewer ScrollViewer.HorizontalScrollBarVisibility="Auto">
											<ItemsControl
												ItemsPanel="{StaticResource HorizontalStackPanel}"
												ItemsSource="{Binding Tagz}">
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="vm:Tag">
														<ToggleButton IsChecked="{Binding IsSelected}"
																	  Content="{Binding Dto.Name}"
																	  ToolTip.Tip="{Binding ToolTipText}" />
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</ScrollViewer>
										<TextBlock Text="Profiles"
											Margin="4 12 4 6"
											ToolTip.Tip="already selected profiles"
											Theme="{StaticResource BodyStrongTextBlockStyle}"/>
										<Grid ColumnDefinitions="Auto,*">
											<Button Content="Select..."
													Command="{Binding AsyncCfVCommand}"
													CommandParameter="OpenProfileSelector"
													Theme="{StaticResource AccentTextButton}"
													HorizontalAlignment="Right"
													Margin="4,6"/>
											<ScrollViewer Grid.Column="1" ScrollViewer.HorizontalScrollBarVisibility="Auto">
												<ItemsControl
													ItemsPanel="{StaticResource HorizontalStackPanel}"
													ItemsSource="{Binding SelectedProfiles}">
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="modelsObservable:ObsProfile">
															<ToggleButton IsChecked="{Binding Active}"
																		  Content="{Binding Title}" />
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</ScrollViewer>
										</Grid>
										<TextBlock Text="Robotomations"
											ToolTip.Tip="available automation actors to run"
											Margin="4 12 4 6"
											Theme="{StaticResource BodyStrongTextBlockStyle}"/>
										<ItemsControl
											ItemsSource="{Binding Selections}"
											ItemsPanel="{StaticResource HorizontalStackPanel}">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="vm:Selection">
													<ToggleButton IsChecked="{Binding Selected}"
                                                                  Content="{Binding Script.Title}"
                                                                  ToolTip.Tip="{Binding Script.Description}" />
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<Expander Header="Options" IsExpanded="True" Margin="0 16 0 0">
											<StackPanel>
												<ContentControl
													Content="{Binding EditableArgs}"
													ContentTemplate="{StaticResource ArgsTemplate}"
													Margin="6 0 6 6" />

												<ContentControl Content="{Binding AiSettings}">
													<ContentControl.ContentTemplate>
														<DataTemplate x:DataType="models:AI">
															<StackPanel Spacing="6">
																<Expander Header="Inception" 
																	Margin="0 6"
																	IsExpanded="True">
																	<Expander.Header>
																		<TextBlock Text="Inception"
																			ToolTip.Tip="Inceptionalize Roboto" />
																	</Expander.Header>
																	<StackPanel>
																	<TextBlock Theme="{StaticResource CaptionTextBlockStyle}">
																		<Run Text="prompt decorations for the robosponder" />
																	</TextBlock>
																	<ContentControl 
																		Content="{Binding Decorators}"
																		ContentTemplate="{StaticResource AITemplate}" />
																	</StackPanel>
																</Expander>
															</StackPanel>
														</DataTemplate>
													</ContentControl.ContentTemplate>
												</ContentControl>

												<ContentControl Content="{Binding EditableSettings}">
													<ContentControl.ContentTemplate>
														<DataTemplate x:DataType="vmv:SettingsViewModel">
															<StackPanel Spacing="6">
																<Expander Header="Run" IsExpanded="True" Margin="0 6">
																	<ContentControl
																		Content="{Binding Start}"
																		ContentTemplate="{StaticResource StartEditorTemplate}"/>
																</Expander>
																<Expander Header="Timeouts" Margin="0 6">
																	<ContentControl
																		Content="{Binding Timeouts}"
																		ContentTemplate="{StaticResource TimeoutsEditorTemplate}"/>
																</Expander>
															</StackPanel>
														</DataTemplate>
													</ContentControl.ContentTemplate>
												</ContentControl>
											</StackPanel>
										</Expander>
									</StackPanel>
								</ui:SettingsExpanderItem>

								<ui:SettingsExpander.Footer>
									<StackPanel
										Orientation="Horizontal"
										Spacing="6"
										HorizontalAlignment="Right">
										<ui:FAComboBox
											HorizontalAlignment="Left"
											SelectedItem="{Binding Browser}"
											ItemsSource="{Binding BrowserOptions}">
											<ui:FAComboBox.ItemTemplate>
												<DataTemplate>
													<afv:SvgIconControl
														IconName="{Binding IconName}"
														Height="20"
														Width="20"/>
												</DataTemplate>
											</ui:FAComboBox.ItemTemplate>
										</ui:FAComboBox>
										<Button Content="Save"
											CommandParameter="Save"
											IsVisible="{Binding !Running}"
											Command="{Binding AsyncCfVCommand}" />

										<Button Content="Run"
											CommandParameter="Run"
											IsVisible="{Binding !Running}"
											Command="{Binding AsyncCfVCommand}" />

										<Button Content="Stop"
											CommandParameter="Stop"
											IsVisible="{Binding Running}"
											Command="{Binding CfVCommand}" />
									</StackPanel>
								</ui:SettingsExpander.Footer>
							</ui:SettingsExpander>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</afv:ChameleonContentControl.Content>
		</afv:ChameleonContentControl>
	</Grid>
</UserControl>