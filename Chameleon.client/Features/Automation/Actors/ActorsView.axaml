<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="850"
             xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Chameleon.client.Features.Automation.Actors"
             xmlns:vmv="using:Chameleon.client.Features.Automation.Actors.ViewModels"
             xmlns:models="using:Chameleon.AIR.Actors.Models"
             xmlns:redditModels="using:Chameleon.AIR.Actors.Models.Reddit"
             x:Class="Chameleon.client.Features.Automation.Actors.ActorsView"
             x:DataType="vm:ActorsViewModel"
             x:CompileBindings="True">
	<UserControl.Styles>
		<StyleInclude Source="UiResources/ActorStyles.axaml"/>
	</UserControl.Styles>

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="UiResources/ActorDataTemplates.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	
	<Grid RowDefinitions="Auto, *">
		<afv:ChameleonContentControl Title="Agents"
                                     TitleDescription="Robotic Automation Agents">
			<afv:ChameleonContentControl.Content>
				<ListBox VerticalAlignment="Top"
                         ItemsSource="{Binding Actors}"
                         Theme="{StaticResource ListBoxNoScroller}"
                         ItemContainerTheme="{StaticResource GridViewItem}">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid Columns="1" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:ActorViewModel">
							<ui:SettingsExpander Header="{Binding EditableSettings.Start.Feature}"
                                                 Description="{Binding EditableSettings.Start.Url}">
								<ui:SettingsExpanderItem>
									<StackPanel>
										<TextBlock Text="Scripts" Theme="{StaticResource CaptionTextBlockStyle}"/>
										<ItemsControl ItemsSource="{Binding Selections}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal" Spacing="6" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="vm:Selection">
													<ToggleButton IsChecked="{Binding Selected}"
                                                                  Content="{Binding Script.Title}"
                                                                  ToolTip.Tip="{Binding Script.Description}" />
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<Expander Header="Options" IsExpanded="True">
											<Expander.Content>
											 	<StackPanel>
													<ContentControl Content="{Binding EditableArgs}">
													<ContentControl.ContentTemplate>
														<DataTemplate x:DataType="vmv:ArgsViewModel">
															<StackPanel Margin="20,5,0,5">
																<Grid Classes="inputGrid"
                                                                      ColumnDefinitions="Auto,*"
                                                                      RowDefinitions="Auto,Auto,Auto,Auto">
																	<TextBlock Classes="sideLabel" Grid.Row="0" Grid.Column="0" Text="Search:"/>
																	<TextBox Classes="sideInput" Grid.Row="0" Grid.Column="1" Text="{Binding Search, Mode=TwoWay}"/>
																	<TextBlock Classes="sideLabel" Grid.Row="1" Grid.Column="0" Text="Scope:" />
																	<ComboBox Classes="sideInput" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableScopes}" SelectedItem="{Binding SelectedScope, Mode=TwoWay}" />
																	<TextBlock Classes="sideLabel" Grid.Row="2" Grid.Column="0" Text="Sort:"/>
																	<ComboBox Classes="sideInput" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableSorts}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}"/>
																	<TextBlock Classes="sideLabel" Grid.Row="3" Grid.Column="0" Text="Filter:"/>
																	<ComboBox Classes="sideInput" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableFilters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"/>
																</Grid>
															</StackPanel>
														</DataTemplate>
													</ContentControl.ContentTemplate>
													</ContentControl>
													<ContentControl Content="{Binding EditableSettings}">
													<ContentControl.ContentTemplate>
														<DataTemplate x:DataType="vmv:SettingsViewModel">
															<StackPanel Margin="20,5,0,5" Spacing="6">
																<Expander Header="Start Options" IsExpanded="True">
																	<ContentControl Content="{Binding Start}"
                                                                                    ContentTemplate="{StaticResource StartEditorTemplate}"/>
																</Expander>
																<Expander Header="Timeouts" IsExpanded="False">
																	<ContentControl Content="{Binding Timeouts}"
																				   ContentTemplate="{StaticResource TimeoutsEditorTemplate}"/>

																</Expander>
																<Expander Header="General Randomization" IsExpanded="False">
																	<ContentControl Content="{Binding Rando}"
                                                                                    ContentTemplate="{StaticResource RandoEditorTemplate}"/>
																</Expander>
																<Expander Header="Iteration Randomization" IsExpanded="False">
																	<ContentControl Content="{Binding Iterations}"
																				   ContentTemplate="{StaticResource RandoEditorTemplate}"/>
																</Expander>
															</StackPanel>
														</DataTemplate>
													</ContentControl.ContentTemplate>
													</ContentControl>
												</StackPanel>
											</Expander.Content>
										</Expander>
									</StackPanel>
								</ui:SettingsExpanderItem>

								<ui:SettingsExpander.Footer>
									<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
										<Button Content="Run" CommandParameter="Run" IsVisible="{Binding !Running}" Command="{Binding AsyncCfVCommand}" />
										<Button Content="Stop" CommandParameter="Stop" IsVisible="{Binding Running}" Command="{Binding CfVCommand}" />
									</StackPanel>
								</ui:SettingsExpander.Footer>
							</ui:SettingsExpander>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</afv:ChameleonContentControl.Content>
		</afv:ChameleonContentControl>
	</Grid>
</UserControl>