<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="1680"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:afv="using:Chameleon.client.UI.Controls"
			 xmlns:profiles="using:Chameleon.client.Features.Projects.Profiles"
			 xmlns:vm="using:Chameleon.client.Features.Automation.Actors"
			 xmlns:vmv="using:Chameleon.client.Features.Automation.Actors.ViewModels"
			 xmlns:models="using:Chameleon.AIR.Actors.Models"
			 xmlns:redditModels="using:Chameleon.AIR.Actors.Models.Reddit"
			 x:Class="Chameleon.client.Features.Automation.Actors.ActorsView"
			 x:DataType="vm:ActorsViewModel"
			 x:CompileBindings="True">
	<Grid RowDefinitions="Auto, *">
		<afv:ChameleonContentControl Title="Autonomous Agents" TitleDescription="Robotic Automation Agents">
			<afv:ChameleonContentControl.TitleContent>
					<StackPanel Classes="zontal" HorizontalAlignment="Right" Margin="4 0">
						<ToggleSwitch IsChecked="{Binding SelectedActor.EditableSettings.Start.New}" 
							 ToolTip.Tip="to start in a new tab" 
							 OffContent="Active" OnContent="New" />
						<!-- TODO: 
						<ToggleSwitch ToolTip.Tip="Run all actionable actions or one each"
									  IsChecked="{Binding EditableSettings.AsQue}" 
									  OffContent="Run All" OnContent="One Each"/>
						<ToggleSwitch ToolTip.Tip="Run all selected automations for each profile, or run all profiles for each automation"
									  IsChecked="{Binding EditableSettings.EachProfile}" 
									  OffContent="Each Profile"  OnContent="Each Selection"/> -->
						<ToggleSwitch IsChecked="{Binding SelectedActor.EditableSettings.CloseOldBrowserProfileAfterRun}"
							 ToolTip.Tip="Close or keep open browser instances for the previous profile before moving to the next"
							 OffContent="Open" OnContent="Close"/>
						<ui:FAComboBox SelectedItem="{Binding SelectedBrowserOption}" ItemsSource="{Binding BrowserOptions}">
							<ui:FAComboBox.ItemTemplate>
								<DataTemplate>
									<afv:SvgIcon IconName="{Binding IconName}" Height="20" Width="20" />
								</DataTemplate>
							</ui:FAComboBox.ItemTemplate>
						</ui:FAComboBox>
						<Border Classes="divider" />
						<Button Content="Save"
								Command="{Binding SelectedActor.AsyncCfVCommand}"
								CommandParameter="Save"/>
						</StackPanel>
			</afv:ChameleonContentControl.TitleContent>
			<afv:ChameleonContentControl.Content>
				<ItemsControl Classes="uni-clm" ItemsSource="{Binding Actors}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ActorViewModel">
							<ui:SettingsExpander Header="{Binding EditableSettings.Start.Feature}" IsExpanded="True" Background="Transparent">
								<ui:SettingsExpanderItem>
									<StackPanel>
										<afv:ChameleonContentControl Title="Options" TitleDescription="auto robo autonomous roboto automations">
											<afv:ChameleonContentControl.TitleContent>
													<StackPanel Classes="zontal" HorizontalAlignment="Right" Margin="0 6">
														<UniformGrid Rows="1">
															<ComboBox ToolTip.Tip="Scope"
																 ItemsSource="{Binding EditableArgs.AvailableScopes}"
																 SelectedItem="{Binding EditableArgs.SelectedScope}" />
															<ComboBox ToolTip.Tip="Sort"
																 ItemsSource="{Binding EditableArgs.AvailableSorts}"
																 SelectedItem="{Binding EditableArgs.SelectedSort}" 
																 Margin="4 0" />
															<ComboBox ToolTip.Tip="Filter"
																 ItemsSource="{Binding EditableArgs.AvailableFilters}"
																 SelectedItem="{Binding EditableArgs.SelectedFilter}" />
												 		</UniformGrid>
													</StackPanel>
											</afv:ChameleonContentControl.TitleContent>

											<afv:ChameleonContentControl.Header>
												<StackPanel>
													<TextBlock Text="Tags" Classes="b1" Margin="4 6" ToolTip.Tip="activate and select hashtagged profiles" />
													<ScrollViewer ScrollViewer.HorizontalScrollBarVisibility="Auto">
														<ItemsControl ItemsPanel="{StaticResource HorizontalStackPanel}" ItemsSource="{Binding Tagz}">
															<ItemsControl.ItemTemplate>
																<DataTemplate x:DataType="vm:Tag">
																	<ToggleButton IsChecked="{Binding IsSelected}" Content="{Binding Dto.Name}" ToolTip.Tip="{Binding ToolTipText}"/>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>
													</ScrollViewer>

													<TextBlock Text="Profiles" Margin="4 12 4 6" Classes="b1" ToolTip.Tip="activate and select profiles" />
													<Grid ColumnDefinitions="Auto,*">
														<Button Content="More" Classes="async icon" CommandParameter="OpenProfileSelector" ToolTip.Tip="Edit" Margin="4,6"/>
														<ScrollViewer Grid.Column="1" ScrollViewer.HorizontalScrollBarVisibility="Auto">
															<ItemsControl ItemsPanel="{StaticResource HorizontalStackPanel}" ItemsSource="{Binding SelectedProfiles}">
																<ItemsControl.ItemTemplate>
																	<DataTemplate x:DataType="profiles:ObsProfile">
																		<ToggleButton IsChecked="{Binding Active}" Content="{Binding Title}"/>
																	</DataTemplate>
																</ItemsControl.ItemTemplate>
															</ItemsControl>
														</ScrollViewer>
													</Grid>
												</StackPanel>
											</afv:ChameleonContentControl.Header>

											<afv:ChameleonContentControl.Content>
												<StackPanel Classes="shared">

													<afv:Inputter Title="Search:"
														 Description="comma seperated list of search terms"
														 Watermark="comma seperated list of search terms"
														 Text="{Binding EditableArgs.Search}" />											
													<afv:Inputter Title="URL's:"
														 Tag="True"
														 Text="{Binding EditableSettings.Start.Url}"
														 Watermark="https://www.reddit.com/r/*&#x0a;https://www.reddit.com/search/*&#x0a;https://www.reddit.com/r/*/search/*&#x0a;https://www.reddit.com/r/*/comments/*" 
														 Description="list of urls seperated by a new line" />
													
													<UniformGrid Rows="1" DataContext="{Binding EditableSettings}">
													 	<UniformGrid.Styles>
													 		<Style Selector="ui|NumberBox">
																<Setter Property="SpinButtonPlacementMode" Value="Compact"/>
																<Setter Property="Maximum" Value="999"/>
															</Style>
													 	</UniformGrid.Styles>
														<afv:Inputter Title="Terms:" Description="Adds AI related keywords based on search terms">
															<ui:NumberBox Value="{Binding Start.Variations.Min}" />
														</afv:Inputter>
														<afv:Inputter Title="Rerun:" Description="Number of times to rerun each search term to a different listing">
															<ui:NumberBox Value="{Binding Start.Iterations.Min}" />
														</afv:Inputter>
														<afv:Inputter Title="Retry:" Description="Maximum retry on unexpected situations">
															<ui:NumberBox Value="{Binding Start.Attempts}"/>
														</afv:Inputter>
														<afv:Inputter Title="Rando:" Description="Min-max activity value for voting and joining">
															<ui:NumberBox Value="{Binding Rando}" />
														</afv:Inputter>
														<afv:Inputter Title="Speed:" Description="robo movement speed in milliseconds">
															<ui:NumberBox Value="{Binding Timeouts.Naps.Min}" />
														</afv:Inputter>
														<afv:Inputter Title="Delay:" Description="auto loop speed between runs in seconds">
															<ui:NumberBox Value="{Binding Delay}" />
														</afv:Inputter>
													</UniformGrid>

													<Expander Header="Inception" Margin="0 9 0 0" IsExpanded="True">
														<StackPanel Classes="shared">
															<TextBlock Text="prompt decorations helps keep the auto robo model 'on brand'" Classes="caption" Margin="0 0 0 8" />
															<afv:Inputter Title="System:"
																			   Description="most helpful for the model consistency"
																			   Watermark="You are helpful..."
																			   Text="{Binding AiSettings.Decorators.System, Mode=TwoWay}" />
															<afv:Inputter Title="Human:"
																			   Description="Human persona description"
																			   Watermark="...(eg. reddit content creator, reddit user, etc.)"
																			   Text="{Binding AiSettings.Decorators.Human, Mode=TwoWay}" />
															<afv:Inputter Title="Audience:"
																			   Description="Target audience"
																			   Watermark="...(eg: reddit users who are interested in..., reddit users who are looking for..., etc.)"
																			   Text="{Binding AiSettings.Decorators.Audience, Mode=TwoWay}" />
															<afv:Inputter Title="Background:"
																			   Description="Background context"
																			   Watermark="...(eg: I am surfing reddit... You... etc.)"
																			   Text="{Binding AiSettings.Decorators.Background, Mode=TwoWay}" />
															<afv:Inputter Title="Tone:"
																			   Description="Communication tone"
																			   Watermark="...(eg: friendly and professional with..., public figure, adaptive to the task, etc.)"
																			   Text="{Binding AiSettings.Decorators.Tone, Mode=TwoWay}" />
														</StackPanel>
													</Expander>
												</StackPanel>
											</afv:ChameleonContentControl.Content>
										</afv:ChameleonContentControl>
									</StackPanel>
								</ui:SettingsExpanderItem>

								<ui:SettingsExpander.Footer>
								<StackPanel Classes="zontal">
									<ItemsControl ItemsSource="{Binding Selections}" Classes="sp-zontal" >
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<ToggleButton IsChecked="{Binding Selected}" Content="{Binding Script.Title}" ToolTip.Tip="{Binding Script.Description}"/>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<Border Classes="divider" />
										<Button Content="Run"
												IsVisible="{Binding !Running}"
												Command="{Binding AsyncCfVCommand}"
												CommandParameter="Run"/>
										<Button Content="Stop"
												IsVisible="{Binding Running}"
												Command="{Binding CfVCommand}"
												CommandParameter="Stop"/>
									</StackPanel>
								</ui:SettingsExpander.Footer>
							</ui:SettingsExpander>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</afv:ChameleonContentControl.Content>
		</afv:ChameleonContentControl>
	</Grid>
</UserControl>
