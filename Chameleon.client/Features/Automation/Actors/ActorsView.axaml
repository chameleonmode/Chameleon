<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="850"
			 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:vm="using:Chameleon.client.Features.Automation.Actors"
             x:Class="Chameleon.client.Features.Automation.Actors.ActorsView"
			 x:DataType="vm:ActorsViewModel"
			 x:CompileBindings="True">
	<Grid RowDefinitions="Auto, *">
		<afv:ChameleonContentControl Title="Agents"
									 TitleDescription="Robotic Automation Agents">
			
			<!-- <afv:ChameleonContentControl.Options>
				<Grid RowDefinitions="*, Auto">
						<ui:CommandBar Grid.Row="1"
									   HorizontalAlignment="Right" 
									   DefaultLabelPosition="Right"
									   OverflowButtonVisibility="Collapsed">
							<ui:CommandBar.PrimaryCommands>
								<ui:CommandBarButton HorizontalAlignment="Right"
									IconSource="Save"
									Label="Save"
									CommandParameter="Save"
									Command="{Binding AsyncCfVCommand}"/>
							</ui:CommandBar.PrimaryCommands>
						</ui:CommandBar>
				</Grid>
			</afv:ChameleonContentControl.Options> -->
			
			<afv:ChameleonContentControl.Content>
				<ListBox
					VerticalAlignment="Top"
					ItemsSource="{Binding Actors}"
					Theme="{StaticResource ListBoxNoScroller}"
					ItemContainerTheme="{StaticResource GridViewItem}">
					<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="1"/>
							</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<ui:SettingsExpander Header="{Binding Actor.Options.Settings.Start.Feature}">
								<ui:SettingsExpanderItem>
									<Grid RowDefinitions="Auto, *">
										<ItemsControl ItemsSource="{Binding Selections}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal"
														Spacing="6"
														Margin="6" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<ToggleButton
														IsChecked="{Binding Selected}"
														Content="{Binding Script.Title}"
														ToolTip.Tip="{Binding Script.Description}">
													</ToggleButton>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
										<ListBox ItemsSource="{Binding Options}"
										 	Grid.Row="1" 
											ItemContainerTheme="{StaticResource GridViewItem}">
											<ListBox.ItemTemplate>
												<DataTemplate>
													<Expander Header="{Binding Key}">
														<ListBox ItemContainerTheme="{StaticResource GridViewItem}"
															ItemsSource="{Binding Value}">
															<ListBox.ItemTemplate>
																<DataTemplate>
																	<StackPanel Spacing="6" Margin="6">
																		<afv:HeaderdInputFieldsControl 
																			Title="{Binding Key}"
																			Text="{Binding Value}" />
																	</StackPanel>
																</DataTemplate>
															</ListBox.ItemTemplate>
														</ListBox>
													</Expander>
												</DataTemplate>
											</ListBox.ItemTemplate>
										</ListBox>
									</Grid>
								</ui:SettingsExpanderItem>
							
								<ui:SettingsExpander.Footer>
									<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
										<Button Content="Run"
											CommandParameter="Run"
											IsVisible="{Binding !Running}"
											Command="{Binding AsyncCfVCommand}" />
										<Button Content="Stop"
											CommandParameter="Stop"
											IsVisible="{Binding Running}"
											Command="{Binding AsyncCfVCommand}" />
									</StackPanel>
								</ui:SettingsExpander.Footer>
							</ui:SettingsExpander>
							<!-- <Grid ColumnDefinitions="Auto, *, 50">
								<TextBlock
									Grid.Column="0"
									Text="{Binding Actor.Options.Settings.Start.Feature}"
									Theme="{StaticResource BodyStrongTextBlockStyle}"
									TextTrimming="CharacterEllipsis"
									VerticalAlignment="Center"
									Margin="9" />

								<Button
									Grid.Column="2"
									Command="{ReflectionBinding Path=$parent[ItemsControl].DataContext.OpenCommand}"
									CommandParameter="{Binding}"
									ToolTip.Tip="Open"
									Content="three-dots"
									Theme="{DynamicResource SvgIconButton}" />
							</Grid> -->
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</afv:ChameleonContentControl.Content>
			
		</afv:ChameleonContentControl>
	</Grid>
</UserControl>
