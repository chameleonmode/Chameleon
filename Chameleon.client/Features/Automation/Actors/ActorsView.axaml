<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="850"
             xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Chameleon.client.Features.Automation.Actors"
             xmlns:vmv="using:Chameleon.client.Features.Automation.Actors.ViewModels"
			 xmlns:models="using:Chameleon.AIR.Actors.Models"
             xmlns:redditModels="using:Chameleon.AIR.Actors.Models.Reddit"
			 x:Class="Chameleon.client.Features.Automation.Actors.ActorsView"
             x:DataType="vm:ActorsViewModel"
			 x:CompileBindings="True">
	<UserControl.Styles>
		<Style Selector="TextBlock.sideLabel">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,5,8"/>
		</Style>

		<Style Selector="TextBox.sideInput">
			<Setter Property="Margin" Value="5,0,0,8"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="ComboBox.sideInput">
			<Setter Property="Margin" Value="5,0,0,8"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		
		<Style Selector="ToggleSwitch.sideInput">
			<Setter Property="Margin" Value="5,0,0,8"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="ui|NumberBox.sideInput">
			<Setter Property="Margin" Value="5,0,0,8"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="SpinButtonPlacementMode" Value="Inline"/>
		</Style>
	</UserControl.Styles>
	
	<UserControl.Resources>
		<DataTemplate x:Key="RandoEditorTemplate" x:DataType="vmv:RandoViewModel">
			<StackPanel Orientation="Horizontal" Spacing="5">
				<TextBlock Classes="sideLabel" Text="Min:"/>
				<ui:NumberBox Classes="sideInput" Value="{Binding Min, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0"/>
				<TextBlock Classes="sideLabel" Text="Max:"/>
				<ui:NumberBox Classes="sideInput" Value="{Binding Max, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0"/>
				<TextBlock Classes="sideLabel" Text="Multiplier:" VerticalAlignment="Center"/>
				<ui:NumberBox Classes="sideInput" Value="{Binding Multiplier, Mode=TwoWay, TargetNullValue=''}" SpinButtonPlacementMode="Compact" AcceptsExpression="False"/>
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>

	<Grid RowDefinitions="Auto, *">
		<afv:ChameleonContentControl Title="Agents"
                                     TitleDescription="Robotic Automation Agents">
			<afv:ChameleonContentControl.Content>
				<ListBox VerticalAlignment="Top"
                         ItemsSource="{Binding Actors}"
                         Theme="{StaticResource ListBoxNoScroller}"
                         ItemContainerTheme="{StaticResource GridViewItem}">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid Columns="1" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:ActorViewModel">
							<ui:SettingsExpander Header="{Binding EditableSettings.Start.Feature}"
                                                 Description="{Binding EditableSettings.Start.Url}">
								<ui:SettingsExpanderItem>
									<StackPanel Spacing="10" Margin="10,0,10,0">
										<TextBlock Text="Scripts" Theme="{StaticResource CaptionTextBlockStyle}"/>
										<ItemsControl ItemsSource="{Binding Selections}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal" Spacing="6" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="vm:Selection">
													<ToggleButton IsChecked="{Binding Selected}"
                                                                  Content="{Binding Script.Title}"
                                                                  ToolTip.Tip="{Binding Script.Description}" />
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<Expander Header="Options" IsExpanded="True">
											<Expander.Content>
											 	<StackPanel>
													<ContentControl Content="{Binding EditableArgs}">
													<ContentControl.ContentTemplate>
														<DataTemplate x:DataType="vmv:ArgsViewModel">
															<StackPanel Spacing="10" Margin="20,5,0,5">
																<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
																	<TextBlock Classes="sideLabel" Grid.Row="0" Grid.Column="0" 
																		Text="Search:"/>
																	<TextBox Classes="sideInput" Grid.Row="0" Grid.Column="1" 
																		Text="{Binding Search, Mode=TwoWay}"/>
																	<TextBlock Classes="sideLabel" Grid.Row="1" Grid.Column="0" 
																		Text="Scope:" />
																	<ComboBox Classes="sideInput" Grid.Row="1" Grid.Column="1" 
																		ItemsSource="{Binding AvailableScopes}" 
																		SelectedItem="{Binding SelectedScope, Mode=TwoWay}" />
																	<TextBlock Classes="sideLabel" Grid.Row="2" Grid.Column="0" 
																		Text="Sort:"/>
																	<ComboBox Classes="sideInput" Grid.Row="2" Grid.Column="1" 
																		ItemsSource="{Binding AvailableSorts}" 
																		SelectedItem="{Binding SelectedSort, Mode=TwoWay}"/>
																	<TextBlock Classes="sideLabel" Grid.Row="3" Grid.Column="0" 
																		Text="Filter:" VerticalAlignment="Center"/>
																	<ComboBox Classes="sideInput" Grid.Row="3" Grid.Column="1" 
																		ItemsSource="{Binding AvailableFilters}" 
																		SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"/>
																</Grid>
																<!-- <Expander Header="Other Arguments" IsExpanded="False" Margin="0,10,0,0" IsVisible="{Binding OtherArgs.Count}">
																	<ItemsControl ItemsSource="{Binding OtherArgs}">
																		<ItemsControl.ItemTemplate>
																			<DataTemplate>
																				<Grid ColumnDefinitions="Auto,*" Margin="2">
																					<TextBlock Classes="sideLabel" Text="{Binding Key}" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
																					<TextBox Classes="sideInput" Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" />
																				</Grid>
																			</DataTemplate>
																		</ItemsControl.ItemTemplate>
																	</ItemsControl>
																</Expander> -->
															</StackPanel>
														</DataTemplate>
													</ContentControl.ContentTemplate>
													</ContentControl>
													<ContentControl Content="{Binding EditableSettings}">
													<ContentControl.ContentTemplate>
														<DataTemplate x:DataType="vmv:SettingsViewModel">
															<StackPanel Spacing="10" Margin="20,5,0,5">
																<Expander Header="Start">
																	<Expander.Content>
																		<ContentControl Content="{Binding Start}">
																			<ContentControl.ContentTemplate>
																				<DataTemplate x:DataType="vmv:StartViewModel">
																					<Grid ColumnDefinitions="Auto,*" 
																						RowDefinitions="Auto,Auto,Auto" 
																						Margin="20,5,0,5">
																						<!-- <TextBlock Classes="sideLabel" 
																							Grid.Row="0" Grid.Column="0" 
																							Text="Feature:"/>
																						<TextBox Classes="sideInput" 
																							Grid.Row="0" Grid.Column="1" 
																							Text="{Binding Feature, Mode=TwoWay}"/> -->
																						<TextBlock Classes="sideLabel" 
																							Grid.Row="1" Grid.Column="0" 
																							Text="URL:"/>
																						<TextBox Classes="sideInput" 
																							Grid.Row="1" Grid.Column="1" 
																							Text="{Binding Url, Mode=TwoWay, TargetNullValue=''}"/>
																						<TextBlock Classes="sideLabel" 
																							Grid.Row="2" Grid.Column="0" 
																							Text="New Tab:"/>
																						<ToggleSwitch Classes="sideInput" 
																							Grid.Row="2" Grid.Column="1" 
																							IsChecked="{Binding New, Mode=TwoWay}" 
																							OffContent="" OnContent=""/>
																					</Grid>
																				</DataTemplate>
																			</ContentControl.ContentTemplate>
																		</ContentControl>
																	</Expander.Content>
																</Expander>
																<Expander Header="Timeouts" IsExpanded="False">
																	<Expander.Content>
																		<ContentControl Content="{Binding Timeouts}">
																			<ContentControl.ContentTemplate>
																				<DataTemplate x:DataType="vmv:TimeoutsViewModel">
																					<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="20,5,0,5">
																						<TextBlock Classes="sideLabel" Grid.Row="0" Grid.Column="0" 
																							Text="Default:"/>
																						<ui:NumberBox Classes="sideInput" Grid.Row="0" Grid.Column="1"
																						 	Value="{Binding Default, Mode=TwoWay}"/>
																						<TextBlock Classes="sideLabel" Grid.Row="1" Grid.Column="0" 
																							Text="Wait:"/>
																						<ui:NumberBox Classes="sideInput" Grid.Row="1" Grid.Column="1" 
																							Value="{Binding Wait, Mode=TwoWay}" />
																						<TextBlock Classes="sideLabel" Grid.Row="2" Grid.Column="0" 
																							Text="Navigate:"/>
																						<ui:NumberBox Classes="sideInput" Grid.Row="2" Grid.Column="1" Value="{Binding Navigate, Mode=TwoWay}"/>
																						<TextBlock Classes="sideLabel" Grid.Row="3" Grid.Column="0" Text="Naps:" VerticalAlignment="Top"/>
																						<ContentControl Grid.Row="3" Grid.Column="1"
																							ToolTip.Tip="Settings in milliseconds for naps ie. time to wait between actions"
																							Content="{Binding Naps}" 
																							ContentTemplate="{StaticResource RandoEditorTemplate}"/>
																					</Grid>
																				</DataTemplate>
																			</ContentControl.ContentTemplate>
																		</ContentControl>
																	</Expander.Content>
																</Expander>
																<Expander Header="Randomization" 
																	ToolTip.Tip="Randomization settings for retries and selections ie. join/vote">
																	<ContentControl Content="{Binding Rando}" ContentTemplate="{StaticResource RandoEditorTemplate}" Margin="20,5,0,5"/>
																</Expander>
																<Expander Header="Iterations"
																	ToolTip.Tip="Randomization settings for iterations ie. number of times to run the script">
																	<ContentControl Content="{Binding Iterations}" ContentTemplate="{StaticResource RandoEditorTemplate}" Margin="20,5,0,5"/>
																</Expander>
															</StackPanel>
														</DataTemplate>
													</ContentControl.ContentTemplate>
													</ContentControl>
												</StackPanel>
											</Expander.Content>
										</Expander>
									</StackPanel>
								</ui:SettingsExpanderItem>

								<ui:SettingsExpander.Footer>
									<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
										<Button Content="Run" CommandParameter="Run" IsVisible="{Binding !Running}" Command="{Binding AsyncCfVCommand}" />
										<Button Content="Stop" CommandParameter="Stop" IsVisible="{Binding Running}" Command="{Binding CfVCommand}" />
									</StackPanel>
								</ui:SettingsExpander.Footer>
							</ui:SettingsExpander>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</afv:ChameleonContentControl.Content>
		</afv:ChameleonContentControl>
	</Grid>
</UserControl>