<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
	xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
	xmlns:vm="using:Chameleon.app.Features.Automation.Playwright"
	x:DataType="vm:PlaywrightViewModel"
	x:CompileBindings="True"
	x:Class="Chameleon.app.Features.Automation.Playwright.PlaywrightView"
	mc:Ignorable="d"
	d:DesignWidth="800"
	d:DesignHeight="1280">
	<StackPanel>
	<!-- chameleon scripts -->
	<afv:ChameleonContentControl Title="Bundled Scripts"
	 	Grid.Row="1"
		TitleDescription="{Binding TotalCount, StringFormat='You have {0} scripts.'}">
			<afv:ChameleonContentControl.Options>
				<Grid RowDefinitions="*, Auto">
						<ui:CommandBar Grid.Row="1"
									   HorizontalAlignment="Right" 
									   DefaultLabelPosition="Right"
									   OverflowButtonVisibility="Collapsed">
							<ui:CommandBar.PrimaryCommands>
								<ui:CommandBarButton HorizontalAlignment="Right"
									IconSource="Save"
									Label="Save"
									CommandParameter="Save"
									Command="{Binding AsyncCfVCommand}"/>
							</ui:CommandBar.PrimaryCommands>
						</ui:CommandBar>
						
						<ListBox Width="256"
							ItemContainerTheme="{StaticResource GridViewItem}"
							ItemsSource="{Binding SelectedBundledScript.Parameters}"
							MaxHeight="512">
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="1"/>
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<StackPanel Spacing="6"
												Margin="6">
										<afv:HeaderdInputFieldsControl 
											Title="{Binding DisplayName}"
											Text="{Binding Value, Mode=TwoWay, FallbackValue=xValue}" />
										<!--<TextBlock
											Text="{Binding Name}"
											Padding="0 5"/>
										<TextBox
											Text="{Binding Value, Mode=TwoWay}"
											ToolTip.Tip="{Binding Value}"/>-->
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						
				</Grid>
			</afv:ChameleonContentControl.Options>
			
			<afv:ChameleonContentControl.Content>
					<!-- ListBox with ViewModel items -->
					<ListBox
						VerticalAlignment="Top"
						ItemsSource="{Binding BundlesScripts}"
						Theme="{StaticResource ListBoxNoScroller}"
						ItemContainerTheme="{StaticResource GridViewItem}">
						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="1"/>
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="50"/>
									</Grid.ColumnDefinitions>

									<!-- Title -->
									<TextBlock
										Grid.Column="0"
										Text="{Binding Title}"
										ToolTip.Tip="{Binding Description}"
										VerticalAlignment="Center"
										HorizontalAlignment="Left"
										Theme="{StaticResource BodyStrongTextBlockStyle}"
										TextTrimming="CharacterEllipsis"
										TextWrapping="NoWrap"
										Margin="5 5 10 5"/>

									<!-- Description -->
									<!--<TextBlock
										Grid.Column="1"
										Text="{Binding Description}"
										ToolTip.Tip="{Binding Description}"
										VerticalAlignment="Center"
										Theme="{StaticResource CaptionTextBlockStyle}"
										Margin="10 5 5 5"
										TextWrapping="NoWrap"/>-->

									<!-- PopUp Buttom -->
									<Button
									   Grid.Column="2"
									   Command="{Binding OpenParamsPopupCommand}"
									   CommandParameter="{Binding Title}"
									   IsVisible="{Binding HasParameters}"
									   ToolTip.Tip="Set Parameters"
									   Content="three-dots"
									   Theme="{DynamicResource SvgIconButton}">
									</Button>

								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

			</afv:ChameleonContentControl.Content>
			
			<afv:ChameleonContentControl.Footer>
					<StackPanel
						Grid.Row="2"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
						<TextBlock
									Theme="{StaticResource BodyStrongTextBlockStyle}"
									TextAlignment="Center"
									HorizontalAlignment="Center">
							More pre-installed and custom
							<LineBreak/>
							automations coming soon
						</TextBlock>
					</StackPanel>
			</afv:ChameleonContentControl.Footer>
	</afv:ChameleonContentControl>
	<!-- User Scripts -->
	<afv:ChameleonContentControl
			  Grid.Row="1"
			  Title="Your Scripts"
			  TitleDescription="Directory path to load your local scripts from.">

				<afv:ChameleonContentControl.Header>
					<Grid
						Margin="6"
						ColumnDefinitions="*,Auto">

						<TextBox
							IsReadOnly="True"
							Text="{Binding UserScriptsDirectory, FallbackValue=Select A Directory}" />

						<Button
							Grid.Column="1"
							Margin="6 0 0 0"
							Content="Folder"
							Theme="{StaticResource AccentSymbleIconButton}"
							CommandParameter="SelectUserScriptFolder"
							Command="{Binding AsyncCfVCommand}"/>
					</Grid>
				</afv:ChameleonContentControl.Header>

				<afv:ChameleonContentControl.Content>

					<!-- ListBox with ViewModel items -->
					<ListBox
						ItemsSource="{Binding UserScripts}"
						Theme="{StaticResource ListBoxNoScroller}"
						ItemContainerTheme="{StaticResource GridViewItem}">
						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="1"/>
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="0.5*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="50"/>
									</Grid.ColumnDefinitions>

									<!-- Title -->
									<TextBlock
										Grid.Column="0"
										Text="{Binding Title}"
										ToolTip.Tip="{Binding Title}"
										VerticalAlignment="Center"
										HorizontalAlignment="Left"
										Theme="{StaticResource BodyStrongTextBlockStyle}"
										TextTrimming="CharacterEllipsis"
										TextWrapping="NoWrap"
										Margin="5 5 10 5"/>

									<!-- Description -->
									<TextBlock
										Grid.Column="1"
										Text="{Binding Description}"
										ToolTip.Tip="{Binding Description}"
										VerticalAlignment="Center"
										Theme="{StaticResource CaptionTextBlockStyle}"
										Margin="10 5 5 5"
										TextTrimming="CharacterEllipsis"
										TextWrapping="NoWrap"/>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

				</afv:ChameleonContentControl.Content>
	</afv:ChameleonContentControl>
	</StackPanel>
</UserControl>
