<UserControl xmlns="https://github.com/avaloniaui"
		 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		 xmlns:conv="using:Chameleon.Avalonia.Common.Converters.ValueConverters"
		 xmlns:ui="using:FluentAvalonia.UI.Controls"
		 xmlns:avCommon="using:Chameleon.Avalonia.Common"
		 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
		 xmlns:local="using:Chameleon.client.Features.Projects.Profiles"
		 x:Class="Chameleon.client.Features.Projects.Profiles.UserProfileUserControl"
		 x:DataType="local:ObsProfile"
		 x:CompileBindings="True">
	<UserControl.Styles>
		<Style Selector=":is(Button)[Tag=1]">
			<Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
		</Style>
		<Style Selector=":is(Button)[Tag=0]">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector=":is(Button)[Tag=-1]">
			<Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
		</Style>
		<Style Selector=":is(Border).glyph[Tag=False]">
			<Setter Property="Background" Value="{StaticResource AccentFillColorDefaultBrush}" />
		</Style>
		<Style Selector=":is(Border).glyph[Tag=True]">
			<Setter Property="Background" Value="{StaticResource SystemFillColorSuccessBrush}" />
		</Style>
	</UserControl.Styles>

	<Border Padding="6" Background="Transparent">
		<Grid ColumnDefinitions="Auto,Auto,*,Auto">
			<StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding Title, FallbackValue=x}">
				<CheckBox Margin="6 0 -6 0" IsChecked="{Binding IsSelected}" IsVisible="{Binding IsShowCheckboxColumn}" />

				<Panel Name="IconHost" Tag="{Binding Dto}" VerticalAlignment="Center">
					<Border Classes="glyph"
						 Tag="{Binding Foreground, Mode=TwoWay}"
						 BorderBrush="{StaticResource ControlStrokeColorOnAccentDefaultBrush}"
						 CornerRadius="180"
						 BorderThickness="1"
						 Width="34"
						 Height="34">
						<TextBlock Text="{Binding Code,FallbackValue=N}"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								TextAlignment="Center"
								Margin="0 0 0 0"
								Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
								Theme="{StaticResource BodyStrongTextBlockStyle}"/>
					</Border>

					<Panel IsVisible="{Binding IsSharedProfile}"
						  Width="8"
						  Height="8"
						  VerticalAlignment="Bottom"
						  HorizontalAlignment="Right">
						<Ellipse Fill="{StaticResource ControlOnImageFillColorDefaultBrush}"/>
						<ui:SymbolIcon Symbol="Share" FontSize="8" />
					</Panel>
				</Panel>
			</StackPanel>

			<TextBlock Grid.Column="1"
					Classes="b1"
					Text="{Binding Title, FallbackValue=x_x}"
					Margin="12 0 0 0"
					HorizontalAlignment="Left" />
			<UniformGrid Grid.Column="3"
					IsVisible="{Binding IsActionOptionsVisible}"
					HorizontalAlignment="Right"
					Rows="1">
				<Button
					Content="chrome"
					Tag="{Binding IsChromeRunning, Mode=TwoWay}"
					Theme="{StaticResource SvgIconButton}"
					Command="{Binding AsyncCfVCommand}"
					CommandParameter="OpenChrome" />
				<Button
					Content="firefox"
					Tag="{Binding IsFFRunning}"
					Theme="{StaticResource SvgIconButton}"
					Command="{Binding AsyncCfVCommand}"
					CommandParameter="OpenFirefox" />
				<Button
					Content="brave"
					Tag="{Binding IsBraveRunning}"
					Theme="{StaticResource SvgIconButton}"
					Command="{Binding AsyncCfVCommand}"
					CommandParameter="OpenBrave"/>

				<Button
					Content="chameleon-logo"
					Theme="{StaticResource SvgIconButton}"
					Command="{Binding CfVCommand}"
					CommandParameter="OpenTopmostController"/>

				<Button Content="copy"
						Theme="{StaticResource SvgIconButton}"
						Command="{Binding CfVCommand}"
						CommandParameter="ShowViewProfile"/>

				<Button Content="three-dots" Theme="{StaticResource SvgIconButton}">
					<Button.Flyout>
						<ui:FAMenuFlyout Placement="Bottom">
							
							<ui:MenuFlyoutSubItem IconSource="Import" Text="Import Cookies">
								<ui:MenuFlyoutItem Classes="sync-chrome" />
								<ui:MenuFlyoutItem Classes="sync-brave" />
								<ui:MenuFlyoutItem Classes="sync-firefox" />
							</ui:MenuFlyoutSubItem>
							
							<ui:MenuFlyoutSubItem IconSource="Export" Text="Export Cookies">
								<ui:MenuFlyoutItem Classes="sync-chrome" CommandParameter="ExportCookiesChrome" />
								<ui:MenuFlyoutItem Classes="sync-brave" CommandParameter="ExportCookiesBrave"/>
								<ui:MenuFlyoutItem Classes="sync-firefox" CommandParameter="ExportCookiesFirefox"/>
							</ui:MenuFlyoutSubItem>

							<ui:MenuFlyoutSeparator />
							
							<ui:MenuFlyoutItem
								Text="Delete"
								IconSource="Delete"
								IsVisible="{Binding !IsSharedProfile}"
								Command="{Binding AsyncCfVCommand}"
								CommandParameter="DeleteUserProfile" />
						</ui:FAMenuFlyout>
					</Button.Flyout>
				</Button>

				<Button Grid.Column="3"
						Theme="{StaticResource FavoriteButton}"
						Command="{Binding AsyncCfVCommand}"
						CommandParameter="Favorite" />
			</UniformGrid>
		</Grid>
	</Border>
</UserControl>
