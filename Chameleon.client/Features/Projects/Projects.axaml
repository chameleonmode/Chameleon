<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
						 xmlns:afv="using:Chameleon.client.UI.Controls"
						 xmlns:folders="using:Chameleon.client.Features.Projects.Folders"
						 xmlns:profiles="using:Chameleon.client.Features.Projects.Profiles"
						 xmlns:local="using:Chameleon.client.Features.Projects"
             x:Class="Chameleon.client.Features.Projects.View"
						 x:DataType="local:ViewModel">
	<ScrollViewer Padding="{StaticResource ScrollviewerAppPageMargin}">
		<StackPanel>
			<afv:PageHeader TextType="Profiles" Classes="smallest">
				<afv:PageHeader.ContentObject>
					<StackPanel Orientation="Horizontal">
						<Button Margin="6 -18 8 0"
								ToolTip.Tip="Create Profile"
								Classes="async icon square"
								Content="Add"
								CommandParameter="CreateProfile"
								IsVisible="{Binding IsCreateProfileBtnVisible}" />
					</StackPanel>
				</afv:PageHeader.ContentObject>
			</afv:PageHeader>

			<Grid ColumnDefinitions="3*,*">
					<profiles:ProfilesView />
					<folders:FoldersView Grid.Column="1" />
			</Grid>
		</StackPanel>
	</ScrollViewer>
</UserControl>
