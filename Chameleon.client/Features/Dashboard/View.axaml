<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="1101"
						 xmlns:ui="using:FluentAvalonia.UI.Controls"
						 xmlns:cc="using:Chameleon.client.UI.Controls"
						 xmlns:favourite="using:Chameleon.client.Features.Dashboard.Favorite"
						 xmlns:tags="using:Chameleon.client.Features.Dashboard.Tags"
						 xmlns:vm="using:Chameleon.client.Features.Dashboard"
             x:Class="Chameleon.client.Features.Dashboard.View"
						 x:DataType="vm:ViewModel"
						 x:CompileBindings="True">

	<ScrollViewer Padding="{StaticResource ScrollviewerAppPageMargin}">
		<Grid RowDefinitions="Auto,Auto,*">
			<cc:PageHeader TextType="Dashboard" Classes="smallest">
				<cc:PageHeader.ContentObject>
					<StackPanel Orientation="Horizontal" Margin="6 -18 6 6">
						<Button Classes="icon clear"
								Content="Sync"
								Command="{Binding AsyncCfVCommand}"
								CommandParameter="SyncChanges" />
						<Button Classes="icon clear" IsVisible="{Binding HasCookiesToSync}" Content="Download">
							<Button.Flyout>
								<ui:FAMenuFlyout Placement="Bottom">
									<ui:MenuFlyoutItem Classes="sync-chrome" />
									<ui:MenuFlyoutItem Classes="sync-brave" />
									<ui:MenuFlyoutItem Classes="sync-firefox" />
									<ui:MenuFlyoutSeparator />

									<ui:MenuFlyoutItem Text="Clear"
										CommandParameter="SyncCookiesClear"
										Command="{Binding AsyncCfVCommand}" />
								</ui:FAMenuFlyout>
							</Button.Flyout>
						</Button>
					</StackPanel>
				</cc:PageHeader.ContentObject>
			</cc:PageHeader>

			<ScrollViewer Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Auto">
				<ItemsControl Classes="no-scroll sp-zontal" Padding="0 0 0 26" ItemsSource="{Binding Tagz}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<Panel Grid.Row="2" IsVisible="{Binding IsFavouriteSelected}">
				<favourite:FavouriteView />
			</Panel>
			<Panel Grid.Row="2" IsVisible="{Binding !IsFavouriteSelected}">
				<tags:TagsView />
			</Panel>
		</Grid>
	</ScrollViewer>
</UserControl>
