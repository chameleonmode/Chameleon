<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="450"
						 xmlns:afv="using:Chameleon.client.UI.Controls"
						 xmlns:local="using:Chameleon.client.Features.Tenants.Members.Dialogs"
             x:Class="Chameleon.client.Features.Tenants.Members.Dialogs.InviteUserOrAddProfilesUserControl"
						 x:DataType="local:InviteUserOrAddProfilesViewModel"
						 x:CompileBindings="True">
	<afv:ChameleonDialogControl>
		<afv:ChameleonDialogControl.DialogInputs>
			<afv:DialogInputHost TextLabel="Username:"
									 Text="{Binding AssistantName}"
									 IsVisible="{Binding ShowUserInfo}"/>
			<afv:DialogInputHost TextLabel="Email:"
									 Text="{Binding AssistantEmail}"
									 IsVisible="{Binding ShowUserInfo}"/>
		</afv:ChameleonDialogControl.DialogInputs>

		<afv:ChameleonDialogControl.Content>
			<StackPanel Spacing="6">
				<Expander Header="Folders">
					<StackPanel>
						<ItemsControl
								ItemsSource="{Binding SelectedFolders}"
								ItemTemplate="{StaticResource ObsSelectedTemplate}"
								ItemsPanel="{StaticResource HorizontalWrapPanelTemplate}" />
						<ListBox Name="lbFolders" />
					</StackPanel>
				</Expander>
				<Expander Header="Profiles">
					<StackPanel>
						<ItemsControl
								ItemsSource="{Binding SelectedProfiles}"
								ItemTemplate="{StaticResource ObsSelectedTemplate}"
								ItemsPanel="{StaticResource HorizontalWrapPanelTemplate}"/>
						<ListBox
							ItemsSource="{Binding Profiles}"
							ItemTemplate="{StaticResource UserProfileUserControlDataTemplate}"
							Theme="{StaticResource ListBoxNoScroller}"
							ItemContainerTheme="{StaticResource GridViewItem}"
							ItemsPanel="{StaticResource DoubleColumnUniformGridTemplate}"/>
					</StackPanel>
				</Expander>
			</StackPanel>
		</afv:ChameleonDialogControl.Content>
	</afv:ChameleonDialogControl>
</UserControl>