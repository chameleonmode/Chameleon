<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:contrls="using:Chameleon.Av.Fluent.Common.Controls"
             xmlns:vm="using:Chameleon.client.Features.Settings.Featured"
             x:Class="Chameleon.client.Features.Settings.Featured.FunctionalSettingsView"
			 x:DataType="vm:FunctionalSettingsViewModel"
			 x:CompileBindings="True">
	<Panel>
		<TabStrip Name="ActiveTabStrip">
			<TabStripItem
				Content="Default Launch Settings"
				Tag="{StaticResource DefaultSettingsPageIcon}"/>
			<TabStripItem
				Content="Phone Verification"
				Tag="{StaticResource Phone}"/>
			<TabStripItem
				Content="Proxy"
				Tag="{StaticResource Proxy}"/>
			<TabStripItem
				Content="Proxy Credit"
				Tag="{StaticResource ProxyCred}"/>
		</TabStrip>

		<ui:Frame Name="NavigationFrame" />
	</Panel>
</UserControl>
