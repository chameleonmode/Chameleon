<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
						 xmlns:ui="using:FluentAvalonia.UI.Controls"
						 xmlns:afv="using:Chameleon.client.UI.Controls"
						 xmlns:afvc="using:Chameleon.Av.Fluent.Common.Controls"
						 xmlns:vm="using:Chameleon.client.Features.Settings.Featured"
             x:Class="Chameleon.client.Features.Settings.Featured.ProxyCreditView"
						 x:DataType="vm:ProxyCreditViewModel"
						 x:CompileBindings="True">
		<StackPanel Spacing="8">
			<afv:ChameleonContentControl Title="Residential Proxies" TitleDescription="Manage your proxy payment and top-ups here">
				<afv:ChameleonContentControl.Content>
					<Grid Grid.Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="400"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Border Grid.Column="0"
								BorderThickness="1"
								CornerRadius="2"
								Height="183">
							<Grid Margin="24 0 0 0">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
										   Text="CURRENT BALANCE"
										   Margin="0 17 0 14"
										   Theme="{StaticResource SubtitleTextBlockStyle}"/>
								<StackPanel Grid.Row="1"
											Orientation="Horizontal">
									<TextBlock Text="{Binding Balance}"
											   FontSize="16"
											   FontWeight="Bold"/>
									<TextBlock Text="available now"
											   Margin="7 0 0 0"
											   Theme="{StaticResource BodyStrongTextBlockStyle}" />
								</StackPanel>
								<!--Style="{StaticResource OutlinedButton}"-->
								<Button Grid.Row="2"
										Content="Refresh balance"
										Width="143"
										Height="46"
										HorizontalAlignment="Left"
										VerticalAlignment="Bottom"
										Margin="0 0 0 18"
										Command="{Binding RefreshCommand}"/>
							</Grid>
						</Border>
						<Border Grid.Column="1"
								CornerRadius="2"
								Margin="20 0 0 0"
								BorderThickness="1"
								Height="183">
							<Grid Margin="25 17 25 18">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
										   Text="PURCHASE CREDIT"
										   Margin="0 0 0 8"
										   Theme="{StaticResource SubtitleTextBlockStyle}"/>
								<ItemsControl Grid.Row="1"
											  ItemsSource="{Binding CreditPlans}"
											  Margin="0 0 0 12">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<RadioButton Margin="0 0 16 0"
														 GroupName="PurchaseCredit"
														 VerticalContentAlignment="Center"
														 IsChecked="{Binding IsChecked}">
												<RadioButton.Content>
													<TextBlock Theme="{DynamicResource BodyStrongTextBlockStyle}">
														<Run Text="{Binding Size}"   />
														<Run Text="$" />        
														<Run Text="{Binding Amount}" />
													</TextBlock>
												</RadioButton.Content>
											</RadioButton>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<Button Grid.Row="2"
										Classes="accent"
										Width="135"
										Height="46"
										HorizontalAlignment="Left"
										Command="{Binding PurchaseCreditCommand}">
									<Button.Content>
										<StackPanel Orientation="Horizontal" 
													VerticalAlignment="Center" 
													HorizontalAlignment="Center">
											<afvc:SvgIconControl IconName="purchase"
                                              Width="14"
                                              Height="14"
                                              Margin="0 0 8 0"/>
											<TextBlock Text="Purchase"
													   FontSize="14"/>
										</StackPanel>
									</Button.Content>
								</Button>
							</Grid>
						</Border>
					</Grid>
				</afv:ChameleonContentControl.Content>
			</afv:ChameleonContentControl>

			<afv:ChameleonContentControl Title="Proxies" TitleDescription="Manage your proxies here">
				<afv:ChameleonContentControl.Options>
					<StackPanel Spacing="6">
						<StackPanel Orientation="Horizontal">
							<ui:FAComboBox
								PlaceholderText="Select A Country"
								Header="Proxy Country:"
								Width="150"
								IsTextSearchEnabled="True"
								SelectedItem="{Binding Country}"
								ItemsSource="{Binding Countries}"
								DisplayMemberBinding="{Binding Name}" />

							<Button VerticalAlignment="Bottom"
									Margin="4 0 0 0"
									Theme="{StaticResource TransparentButton}"
									Command="{Binding RefreshProxiesCommand}">
								<ui:SymbolIcon Symbol="Refresh" FontSize="22" />
							</Button>
						</StackPanel>

						<StackPanel Orientation="Horizontal">
							<ui:FAComboBox
								PlaceholderText="Select A Country"
								Header="Show:"
								Width="150"
								IsTextSearchEnabled="True"
								SelectedItem="{Binding CountProxies}"
								ItemsSource="{Binding CountsProxies}"
								DisplayMemberBinding="{Binding}" />

							<Button VerticalAlignment="Bottom"
									Margin="4 0 0 0"
									Theme="{StaticResource TransparentButton}"
									Command="{Binding RefreshProxiesCountCommand}">
								<ui:SymbolIcon Symbol="Refresh" FontSize="22" />
							</Button>
						</StackPanel>
					</StackPanel>
				</afv:ChameleonContentControl.Options>
				<afv:ChameleonContentControl.Content>
					<Grid HorizontalAlignment="Stretch">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<Grid Grid.Row="0"
							  Margin="0 12 0 12"
							  VerticalAlignment="Center">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Button Grid.Column="1"
									Command="{Binding CopyAllUrlsCommand}"
									Content="Copy all"
									VerticalAlignment="Center"
									HorizontalAlignment="Right"
									Theme="{DynamicResource TransparentButton}">
							</Button>
						</Grid>
						<ItemsControl Grid.Row="1" ItemsSource="{Binding Accesses}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>				
									<afvc:HeaderdInputFieldsControl Text="{Binding Url}" Tag="copy" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Grid>
				</afv:ChameleonContentControl.Content>
			</afv:ChameleonContentControl>
		</StackPanel>
</UserControl>
