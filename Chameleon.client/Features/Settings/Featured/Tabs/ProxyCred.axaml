<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
						 xmlns:ui="using:FluentAvalonia.UI.Controls"
						 xmlns:afv="using:Chameleon.client.UI.Controls"
						 xmlns:vm="using:Chameleon.client.Features.Settings.Featured"
             x:Class="Chameleon.client.Features.Settings.Featured.ProxyCreditView"
						 x:DataType="vm:ProxyCreditViewModel"
						 x:CompileBindings="True">
		<StackPanel Spacing="8">
			<afv:ChameleonContentControl Title="Creditz">
				<afv:ChameleonContentControl.Content>
					<Grid Grid.Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="400"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Border Grid.Column="0"
								BorderThickness="1"
								CornerRadius="2"
								Height="183">
							<Grid Margin="24 0 0 0">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
										   Text="CURRENT BALANCE"
										   Margin="0 17 0 14"
										   Theme="{StaticResource SubtitleTextBlockStyle}"/>
								<StackPanel Grid.Row="1"
											Orientation="Horizontal">
									<TextBlock Text="{Binding Balance}"
											   FontSize="16"
											   FontWeight="Bold"/>
									<TextBlock Text="available now"
											   Margin="7 0 0 0"
											   Theme="{StaticResource BodyStrongTextBlockStyle}" />
								</StackPanel>
								<!--Style="{StaticResource OutlinedButton}"-->
								<Button Grid.Row="2"
										Content="Refresh balance"
										Width="143"
										Height="46"
										HorizontalAlignment="Left"
										VerticalAlignment="Bottom"
										Margin="0 0 0 18"
										Command="{Binding RefreshCommand}"/>
							</Grid>
						</Border>
						<Border Grid.Column="1"
								CornerRadius="2"
								Margin="20 0 0 0"
								BorderThickness="1"
								Height="183">
							<Grid Margin="25 17 25 18">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
										   Text="PURCHASE CREDIT"
										   Margin="0 0 0 8"
										   Theme="{StaticResource SubtitleTextBlockStyle}"/>
								<ItemsControl Grid.Row="1"
											  ItemsSource="{Binding CreditPlans}"
											  Margin="0 0 0 12">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<RadioButton Margin="0 0 16 0"
														 GroupName="PurchaseCredit"
														 VerticalContentAlignment="Center"
														 IsChecked="{Binding IsChecked}">
												<RadioButton.Content>
													<TextBlock Theme="{DynamicResource BodyStrongTextBlockStyle}">
														<Run Text="{Binding Size}"   />
														<Run Text="$" />        
														<Run Text="{Binding Amount}" />
													</TextBlock>
												</RadioButton.Content>
											</RadioButton>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<Button Grid.Row="2"
										Classes="accent"
										Width="135"
										Height="46"
										HorizontalAlignment="Left"
										Command="{Binding PurchaseCreditCommand}">
									<Button.Content>
										<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
											<afv:SvgIcon IconName="purchase" Width="14" Height="14"  Margin="0 0 8 0"/>
											<TextBlock Text="Purchase" FontSize="14"/>
										</StackPanel>
									</Button.Content>
								</Button>
							</Grid>
						</Border>
					</Grid>
				</afv:ChameleonContentControl.Content>
			</afv:ChameleonContentControl>

			<afv:ChameleonContentControl Title="Proxiez">
				<afv:ChameleonContentControl.TitleContent>
				<Panel Margin="0 0 0 6">
					<StackPanel Classes="zontal" HorizontalAlignment="Right">
						<ComboBox Width="150"
							SelectedItem="{Binding Country}"
							ItemsSource="{Binding Countries}"
							DisplayMemberBinding="{Binding Name}" />

						<ComboBox Width="72"
							SelectedItem="{Binding CountProxies}"
							ItemsSource="{Binding CountsProxies}"
							DisplayMemberBinding="{Binding}" />
							
						<Button Content="Refresh" Classes="async icon clear text" />
						<Button Content="Copy" Classes="async icon clear text" />
					</StackPanel>
					</Panel>
				</afv:ChameleonContentControl.TitleContent>

				<afv:ChameleonContentControl.Content>
						<ItemsControl ItemsSource="{Binding Accesses}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>				
									<afv:HeaderdInputFieldsControl Text="{Binding Url}" Tag="copy" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
				</afv:ChameleonContentControl.Content>
			</afv:ChameleonContentControl>
		</StackPanel>
</UserControl>
