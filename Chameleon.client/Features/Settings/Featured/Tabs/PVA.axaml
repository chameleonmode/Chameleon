<UserControl xmlns="https://github.com/avaloniaui"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
   mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="490"
   xmlns:ui="using:FluentAvalonia.UI.Controls"
	 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
   xmlns:local="using:Chameleon.client.Features.Settings.Featured"
   x:Class="Chameleon.client.Features.Settings.Featured.PhoneVerificationView"
	 x:DataType="local:PhoneVerificationViewModel"
	 x:CompileBindings="True">
	<ItemsControl ItemsSource="{Binding PVApis}">
		<ItemsControl.ItemTemplate>
			<DataTemplate>
				<local:PVAUserControl VerticalAlignment="Top"  />
			</DataTemplate>
		</ItemsControl.ItemTemplate>
	</ItemsControl>
</UserControl>
