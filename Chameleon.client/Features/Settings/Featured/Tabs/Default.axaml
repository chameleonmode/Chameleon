<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="850"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
						 xmlns:cc="using:Chameleon.client.UI.Controls"
             xmlns:vm="using:Chameleon.client.Features.Settings.Featured"
             x:Class="Chameleon.client.Features.Settings.Featured.UserDefaultSettingsView"
						 x:CompileBindings="True"
						 x:DataType="vm:UserDefaultSettingsViewModel">
		<StackPanel Spacing="8">
			<cc:ChameleonContentControl Title="Anonymous"
				   TitleDescription="Select and edit default launch setting">
				<cc:ChameleonContentControl.TitleContent>
					<ui:CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Right">
						<ui:CommandBar.PrimaryCommands>
							<ui:CommandBarButton IconSource="Save" Label="Save" Classes="cfv" />
						</ui:CommandBar.PrimaryCommands>
					</ui:CommandBar>
				</cc:ChameleonContentControl.TitleContent>
				
				<cc:ChameleonContentControl.Content>
					<StackPanel>
						<UniformGrid Columns="2">
							<CheckBox
								Content="Canvas Resistance"
								IsChecked="{Binding Path=DefaultEmulationOptions.SpoofCanvasFingerprint}" />
							<CheckBox
								Content="WebGl Resistance"
								IsChecked="{Binding Path=DefaultEmulationOptions.SpoofWebGLFingerprint}" />
							<CheckBox
								Content="Client Rects Resistance"
								IsChecked="{Binding Path=DefaultEmulationOptions.SpoofClientRects}" />
							<CheckBox
								Content="Font Resistance"
								IsChecked="{Binding Path=DefaultEmulationOptions.SpoofFontFingerprint}" />							
							<CheckBox
								Content="Audio Resistance"
								IsChecked="{Binding Path=DefaultEmulationOptions.SpoofAudio}" />
							<CheckBox
								Content="Auto Geo Location"
								IsChecked="{Binding Path=DefaultEmulationOptions.SpoofGeoLocation}" />

							<CheckBox
								Content="Auto Timezone"
								IsChecked="{Binding Path=DefaultEmulationOptions.AutoTimezone}" />
						</UniformGrid>
					</StackPanel>
				</cc:ChameleonContentControl.Content>
			</cc:ChameleonContentControl>

			<cc:ChameleonContentControl Title="Bookmarks" TitleDescription="Select and edit default pages launched on browser start and saved to bookmarks">
				<cc:ChameleonContentControl.TitleContent>
					<ui:CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Right">
						<ui:CommandBar.PrimaryCommands>
							<ui:CommandBarButton IconSource="Add" Label="New" Classes="async" />
							<ui:CommandBarButton IconSource="Save" Label="Save" Classes="async" />
						</ui:CommandBar.PrimaryCommands>
					</ui:CommandBar>
				</cc:ChameleonContentControl.TitleContent>

				<cc:ChameleonContentControl.Header>
					<StackPanel Spacing="8">
						<cc:Inputter Title="Start Page:"
							 Margin="4 0 0 0"
							 Description="Set the default page to load when the browser starts."
							 Watermark="Enter URL"
							 Text="{Binding StartPage}" />
						<HeaderedContentControl Theme="{StaticResource HasSelectedItemsBorder}">
							<HeaderedContentControl.Header>
								<Button Classes="async svg-text" Content="delete" Tag="Delete" Margin="3 0 0 0" />
							</HeaderedContentControl.Header>
						</HeaderedContentControl>
					</StackPanel>
				</cc:ChameleonContentControl.Header>
				
				<cc:ChameleonContentControl.Content>
						<ListBox ItemsSource="{Binding ViewModels}">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<CheckBox IsChecked="{Binding IsChecked}"/>
										<TextBox Text="{Binding DefaultUrl}" 
											 Grid.Column="1"
											 Margin="4 2" />
										<Button Content="Delete"
												 Grid.Column="2"
												 Classes="icon clear text"
												 Command="{Binding DeleteCommand}" /> 
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
				</cc:ChameleonContentControl.Content>
			</cc:ChameleonContentControl>
		</StackPanel>
</UserControl>
