<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Chameleon.client.UI.Controls">
	<ItemsPanelTemplate x:Key="HorizontalStackPanel">
		<StackPanel Orientation="Horizontal" Spacing="6" />
	</ItemsPanelTemplate>

	<ItemsPanelTemplate x:Key="HorizontalWrapPanelTemplate">
		<WrapPanel Orientation="Horizontal" />
	</ItemsPanelTemplate>

	<ItemsPanelTemplate x:Key="SingleColumnUniformGridTemplate">
		<UniformGrid Columns="1"/>
	</ItemsPanelTemplate>

	<ItemsPanelTemplate x:Key="DoubleColumnUniformGridTemplate">
		<UniformGrid Columns="2"/>
	</ItemsPanelTemplate>

	<ItemsPanelTemplate x:Key="DefaultPanel">
		<StackPanel Orientation="Horizontal" />
	</ItemsPanelTemplate>
</ResourceDictionary>