<ResourceDictionary xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:ui="using:FluentAvalonia.UI.Controls"
		xmlns:afv="using:Chameleon.client.UI.Controls">
	<!---->
  <ControlTheme x:Key="ActiveTabStripItemTheme" TargetType="TabStripItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Padding" Value="{StaticResource TabItemHeaderMargin}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Name="PART_LayoutRoot"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{TemplateBinding CornerRadius}"
						Padding="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						ToolTip.Tip="{TemplateBinding Content}">
					<Panel>
						<Viewbox Width="28"
								 Height="28"
								 HorizontalAlignment="Left"
								 VerticalAlignment="Center"
								 Margin="12 6">
							<ui:IconSourceElement IconSource="{TemplateBinding Tag}" 
													MinHeight="12"
													MinWidth="12" />
						</Viewbox>
						<Rectangle Name="PART_SelectedPipe"
									 Fill="{DynamicResource AccentFillColorDefaultBrush}"
									 RadiusX="2"
									 RadiusY="2"
									 VerticalAlignment="Bottom"
									 Opacity="0"
									 Height="{DynamicResource TabItemPipeThickness}"
									 Margin="0 0 0 2"
									 HorizontalAlignment="Stretch"/>
					</Panel>
				</Border>
			</ControlTemplate>
		</Setter>

		<Style Selector="^:pointerover /template/ Rectangle#PART_SelectedPipe">
			<Setter Property="Opacity" Value="0.2" />
			<Setter Property="Fill" Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
		</Style>

		<Style Selector="^:selected">
			<Style Selector="^ /template/ Rectangle#PART_SelectedPipe">
				<Setter Property="Opacity" Value="1" />
			</Style>

			<Style Selector="^:pointerover /template/ Rectangle#PART_SelectedPipe">
				<Setter Property="Opacity" Value="0.75" />
				<Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
			</Style>
		</Style>
	</ControlTheme>

	<ControlTheme x:Key="HasNoItemsTheme" TargetType="HeaderedContentControl">
		<Setter Property="Content" Value="&#xE1D3;" />
		<Setter Property="IsVisible" Value="{ReflectionBinding HasNoItems}" />
		<Setter Property="Margin" Value="6 38 6 6" />
		<Setter Property="Height" Value="156" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Template">
			<ControlTemplate>
				<StackPanel>
					<!--
					&#xE155;
					&#xE178;
					&#xE1D2;
					&#xE138;
					&#xE703;
					&#xE155;
					&#xE753;
					&#xE130; document
					&#xE188; folder
					&#xE1D3; library
					&#xE14C;; list
					-->
					<Border CornerRadius="180"
							Width="90"
							Height="90"
							BorderThickness="2"
							BorderBrush="{StaticResource AccentFillColorTertiaryBrush}"
							Background="{StaticResource ControlOnImageFillColorDefaultBrush}">
						<ui:FontIcon
							Glyph="{TemplateBinding Content}"
							FontSize="54"
							Foreground="{StaticResource AccentFillColorTertiaryBrush}"
							FontFamily="{StaticResource SymbolThemeFontFamily}" />
					</Border>

					<TextBlock
						Margin="0 25 0 0"
						Text="{TemplateBinding Header}"
						Theme="{StaticResource SubtitleTextBlockStyle}" />
				</StackPanel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>
	
	<ControlTheme TargetType="afv:ChameleonContentControl" x:Key="{x:Type afv:ChameleonContentControl}">
		<Setter Property="Margin" Value="12 0 12 12" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid RowDefinitions="Auto,*">

					<!-- Header -->
					<Grid ColumnDefinitions="Auto,*">
						<TextBlock Text="{TemplateBinding Title}"
									 Padding="12"
									 Theme="{StaticResource SubtitleTextBlockStyle}" />

						<ContentPresenter Grid.Column="1"
											Name="TitlePresenter"
											Content="{TemplateBinding TitleContent}"
											HorizontalAlignment="Stretch"
											VerticalAlignment="Bottom"/>
					</Grid>

					<!-- Content Area -->
					<Border Name="ControlPreviewAreaHost"
							BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
							Grid.Row="1"
							BorderThickness="0"
							Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
							TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
							CornerRadius="{DynamicResource OverlayCornerRadius}">
						<Grid RowDefinitions="Auto,*">
							<Grid RowDefinitions="Auto,*">
								<StackPanel>
									<TextBlock Text="{TemplateBinding TitleDescription}"
												 Padding="6 14 6 0"
												 Margin="12 0 12 12"
												 Theme="{StaticResource CaptionTextBlockStyle}"
												 IsVisible="{TemplateBinding TitleDescription, Converter={x:Static ObjectConverters.IsNotNull}}"/>
									<ContentPresenter Name="HeaderPresenter"
														Padding="0 0 6 0"
														Margin="12 0 12 12"
														Grid.Row="1"
														Content="{TemplateBinding Header}"
														ContentTemplate="{TemplateBinding HeaderTemplate}"
														HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
														VerticalContentAlignment="Center"
														IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}"/>
								</StackPanel>

								<Grid Grid.Row="1"
										ColumnDefinitions="*,Auto"
										RowDefinitions="Auto,*,Auto,Auto">
									<Rectangle Name="TopRowPlaceholder"
												 IsHitTestVisible="False"
												 IsVisible="False"
												 MinHeight="36" />

									<ContentPresenter Name="ContentsPresenter"
														Content="{TemplateBinding Content}"
														ContentTemplate="{TemplateBinding ContentTemplate}"
														HorizontalAlignment="Stretch"
														VerticalAlignment="Stretch"
														HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
														VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
														Padding="12 0 12 12"
														Grid.ColumnSpan="1"
														Grid.Row="1">
										<ContentPresenter.Transitions>
											<Transitions>
												<ThicknessTransition Duration="00:00:00.167"
																	 Property="Padding" />
											</Transitions>
										</ContentPresenter.Transitions>
									</ContentPresenter>

									<!-- Options Area -->
									<Border VerticalAlignment="Top"
											Name="OptionsHost"
											Margin="12 0 12 12"
											Padding="12"
											CornerRadius="{DynamicResource OverlayCornerRadius}"
											Grid.Column="1"
											Grid.Row="1"
											Background="{DynamicResource LayerFillColorDefaultBrush}"
											BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
											BorderThickness="1"
											Opacity="1"
											IsVisible="False">
										<Border.Transitions>
											<Transitions>
												<DoubleTransition Property="Opacity"
																	Duration="00:00:00.167" />
											</Transitions>
										</Border.Transitions>
										<StackPanel>
											<DockPanel LastChildFill="False">
												<TextBlock Text="Options"
															 DockPanel.Dock="Left"
															 HorizontalAlignment="Left"
															 VerticalAlignment="Center"
															 FontWeight="SemiBold"
															 Margin="0 3 0 0" />

												<Button Name="ShowHideOptionsButton"
														Theme="{StaticResource TransparentButton}"
														DockPanel.Dock="Right"
														Margin="6 0 0 0"
														IsVisible="False">
													<ui:SymbolIcon Symbol="{TemplateBinding IconShevron}" />
												</Button>
											</DockPanel>
											<ContentPresenter Name="OptionPresenter"
																Margin="0 12 0 0"
																Content="{TemplateBinding Options}"
																HorizontalContentAlignment="Stretch"
																VerticalContentAlignment="Stretch"
																IsVisible="{TemplateBinding IsOptionsExpanded}"/>
										</StackPanel>
									</Border>
								</Grid>
							</Grid>

							<!-- Footer Area -->
							<ContentPresenter Name="FooterPresenter"
												Content="{TemplateBinding Footer}"
												HorizontalAlignment="Stretch"
												VerticalAlignment="Bottom"
												HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
												VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
												Margin="12 0 12 12"
												CornerRadius="0 0 8 8"
												Grid.ColumnSpan="2"
												Grid.Row="2">
							</ContentPresenter>
						</Grid>
					</Border>
				</Grid>
			</ControlTemplate>
		</Setter>

		<Style Selector="^ /template/ Border#ControlPreviewAreaHost">
			<Setter Property="CornerRadius" Value="{ReflectionBinding Source={StaticResource OverlayCornerRadius}, Converter={StaticResource BottomCornerRadiusFilterConverter}}" />
		</Style>

		<Style Selector="^:options /template/ Border#OptionsHost">
			<Setter Property="IsVisible" Value="True" />
		</Style>

		<Style Selector="^:mediumWidth">
			<Style Selector="^ /template/ ContentPresenter#ContentsPresenter">
				<Setter Property="Grid.ColumnSpan" Value="2" />
			</Style>

			<Style Selector="^ /template/ Border#OptionsHost">
				<Setter Property="Grid.Column" Value="0" />
				<Setter Property="Grid.Row" Value="0" />
				<Setter Property="Grid.RowSpan" Value="2" />
				<Setter Property="HorizontalAlignment" Value="Right" />
				<Setter Property="VerticalAlignment" Value="Top" />
				<Setter Property="Opacity" Value="0.5" />
				<Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
			</Style>
			
			<Style Selector="^ /template/ Rectangle#TopRowPlaceholder">
				<Setter Property="IsVisible" Value="True" />
			</Style>
			
			<Style Selector="^ /template/ Button#ShowHideOptionsButton">
				<Setter Property="IsVisible" Value="True" />
			</Style>

			<Style Selector="^ /template/ Border#OptionsHost:pointerover">
				<Setter Property="Opacity" Value="1" />
			</Style>

			<!-- Small width applies on top of medium width -->
			<Style Selector="^:smallWidth">
				<Style Selector="^ /template/ Button#ShowHideOptionsButton">
					<Setter Property="IsVisible" Value="False" />
				</Style>

				<Style Selector="^ /template/ Border#OptionsHost">
					<Setter Property="Grid.Column" Value="0" />
					<Setter Property="Grid.ColumnSpan" Value="2" />
					<Setter Property="Grid.Row" Value="2" />
					<Setter Property="Grid.RowSpan" Value="1" />
					<Setter Property="HorizontalAlignment" Value="Center" />
					<Setter Property="VerticalAlignment" Value="Top" />
					<Setter Property="Opacity" Value="1" />
					<Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
				</Style>
				
				<Style Selector="^ /template/ Rectangle#TopRowPlaceholder">
					<Setter Property="IsVisible" Value="False" />
				</Style>
			</Style>
		</Style>

		<Style Selector="^:optionsfull /template/ ui|SymbolIcon#OptionsChevron">
			<Setter Property="Symbol" Value="ChevronUp" />
		</Style>
	</ControlTheme>
</ResourceDictionary>
