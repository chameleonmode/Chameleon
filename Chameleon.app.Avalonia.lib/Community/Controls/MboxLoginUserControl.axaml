<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:afvDialogs="using:Chameleon.Av.Fluent.Common.Controls.Dialogs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chameleon.app.Avalonia.lib.Community.Controls.MboxLoginUserControl">
	<afvDialogs:ChameleonDialogControl>
		<afvDialogs:ChameleonDialogControl.DialogInputs>
			<afvDialogs:DialogInputHost TextLabel="Email:"
									 Text="{Binding UserName}" />
			<afvDialogs:DialogInputHost TextLabel="Licence Key:"
									 Text="{Binding LicenceKey}" />
		</afvDialogs:ChameleonDialogControl.DialogInputs>
	</afvDialogs:ChameleonDialogControl>
</UserControl>
