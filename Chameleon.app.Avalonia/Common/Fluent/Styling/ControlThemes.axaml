<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Chameleon.Av.Fluent.Common.Controls"
                    xmlns:ui="using:FluentAvalonia.UI.Controls"
                    xmlns:sty="using:FluentAvalonia.Styling">
	<Design.PreviewWith>
		<!---->
		<StackPanel>
		<ThemeVariantScope RequestedThemeVariant="Light">
			<StackPanel Spacing="10" Width="1080">
				<local:PageHeaderControl Classes="smallest">
					<local:PageHeaderControl.ContentObject>
						<Button Theme="{StaticResource SyncChangesButton}" />
					</local:PageHeaderControl.ContentObject>
				</local:PageHeaderControl>
			</StackPanel>
		</ThemeVariantScope>

			<!--<local:PVAControl Title="PROFILE NAME">
				<local:PVAControl.FACombBoxes>
					<HeaderedContentControl
					Tag="SaveCV"
					Theme="{StaticResource ThesePVApisTitleContent}">
						<HeaderedContentControl.Content>
							<ui:FAComboBox
								Margin="0 0 0 0"
								PlaceholderText="Select A App"
								Header="App:"
								Width="180"
								IsTextSearchEnabled="True"
								SelectedItem="{Binding SelectedCodesverifyApp}"
								ItemsSource="{Binding CodesverifyApps}"
								DisplayMemberBinding="{Binding Name}" />
						</HeaderedContentControl.Content>
					</HeaderedContentControl>
				</local:PVAControl.FACombBoxes>
			</local:PVAControl>-->
		</StackPanel>
	</Design.PreviewWith>

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Default">
			<LinearGradientBrush StartPoint="0,0"
                                 EndPoint="0%,100%"
                                 x:Key="HeaderOpacityMaskBrush">
				<GradientStop Color="#FF000000" Offset="0" />
				<GradientStop Color="#FF000000" Offset="0.8" />
				<GradientStop Color="#EE000000" Offset="0.83" />
				<GradientStop Color="#DD000000" Offset="0.86" />
				<GradientStop Color="#BB000000" Offset="0.89" />
				<GradientStop Color="#85000000" Offset="0.92" />
				<GradientStop Color="#00000000" Offset="1" />
			</LinearGradientBrush>

			<ImageBrush x:Key="PageHeaderBackgroundBrush"
				Source="avares://Chameleon.app.Avalonia/Assets/Images/FAHeaderBackground_Dark.png"
				AlignmentY="Center"
				Stretch="UniformToFill">
			</ImageBrush>
			<ImageBrush x:Key="PageHeaderBackgroundBrushBG"
               Source="avares://Chameleon.app.Avalonia/Assets/Images/logo-long.png"
               AlignmentY="Center"
               Stretch="UniformToFill">
				<!--<RenderOptions.BitmapInterpolationMode>
                    <OnPlatform Default="HighQuality">
                        <On Options="iOS,Android,Browser" Content="MediumQuality" />
                    </OnPlatform>
                </RenderOptions.BitmapInterpolationMode>-->
			</ImageBrush>
		</ResourceDictionary>
		<ResourceDictionary x:Key="Dark">
			<LinearGradientBrush StartPoint="0,0"
                                 EndPoint="0%,100%"
                                 x:Key="HeaderOpacityMaskBrush">
				<GradientStop Color="#FF000000" Offset="0" />
				<GradientStop Color="#FF000000" Offset="0.8" />
				<GradientStop Color="#EE000000" Offset="0.83" />
				<GradientStop Color="#DD000000" Offset="0.86" />
				<GradientStop Color="#BB000000" Offset="0.89" />
				<GradientStop Color="#85000000" Offset="0.92" />
				<GradientStop Color="#00000000" Offset="1" />
			</LinearGradientBrush>

			<ImageBrush x:Key="PageHeaderBackgroundBrush"
				Source="avares://Chameleon.app.Avalonia/Assets/Images/FAHeaderBackground.png"
				AlignmentY="Center"
				Stretch="UniformToFill">
			</ImageBrush>
			<ImageBrush x:Key="PageHeaderBackgroundBrushBG"
               Source="avares://Chameleon.app.Avalonia/Assets/Images/logo-long.png"
               AlignmentY="Center"
               Stretch="UniformToFill">
				<!--<RenderOptions.BitmapInterpolationMode>
                    <OnPlatform Default="HighQuality">
                        <On Options="iOS,Android,Browser" Content="MediumQuality" />
                    </OnPlatform>
                </RenderOptions.BitmapInterpolationMode>-->
			</ImageBrush>
		</ResourceDictionary>
		<ResourceDictionary x:Key="{x:Static sty:FluentAvaloniaTheme.HighContrastTheme}">
			<LinearGradientBrush StartPoint="0,0"
                                 EndPoint="0%,100%"
                                 x:Key="HeaderOpacityMaskBrush">
				<GradientStop Color="#00000000" />
				<GradientStop Color="#33000000" Offset="1" />
			</LinearGradientBrush>

			<ImageBrush x:Key="PageHeaderBackgroundBrush"
				Source="avares://Chameleon.app.Avalonia/Assets/Images/FAHeaderBackground_Dark.png"
				AlignmentY="Center"
				Stretch="UniformToFill">
			</ImageBrush>

			<ImageBrush x:Key="PageHeaderBackgroundBrushBG"
               Source="avares://Chameleon.app.Avalonia/Assets/Images/logo-long.png"
               AlignmentY="Center"
               Stretch="UniformToFill">
				<!--<RenderOptions.BitmapInterpolationMode>
                    <OnPlatform Default="HighQuality">
                        <On Options="iOS,Android,Browser" Content="MediumQuality" />
                    </OnPlatform>
                </RenderOptions.BitmapInterpolationMode>-->
			</ImageBrush>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
	<ControlTheme TargetType="local:PageHeaderControl"
					x:Key="{x:Type local:PageHeaderControl}">
		<Setter Property="Height" Value="296" />
		<Setter Property="Template">
			<ControlTemplate>
				<!--<Panel>-->
					<!--<Border ClipToBounds="True"
						Background="{DynamicResource PageHeaderBackgroundBrush}"
						RenderOptions.BitmapInterpolationMode="HighQuality"
						OpacityMask="{DynamicResource HeaderOpacityMaskBrush}" />-->
					<!--<Border CornerRadius="8 0 0 0"
                            ClipToBounds="True"
                            Background="{DynamicResource PageHeaderBackgroundBrushBG}"
                            RenderOptions.BitmapInterpolationMode="HighQuality"
                            OpacityMask="{DynamicResource HeaderOpacityMaskBrush}" />-->

					<Grid ColumnDefinitions="Auto,*,Auto">
						
						<Image Name="TitleTextImageHost"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               MaxWidth="400"
                               Margin="30 0 0 0"
                               MinWidth="150"
                               IsVisible="False"
                               RenderOptions.BitmapInterpolationMode="HighQuality">
							<Image.Transitions>
								<Transitions>
									<ThicknessTransition Duration="00:00:00.25"
                                                         Property="Margin"
                                                         Easing="0,0 0,1" />
								</Transitions>
							</Image.Transitions>
						</Image>

						<StackPanel Orientation="Horizontal" >
							<ui:FontIcon Name="TitleTextFontHost"
										 Glyph="Dashboard"
										 FontSize="36"
										 FontWeight="SemiBold"
										 VerticalAlignment="Top"
										 HorizontalAlignment="Left"
										 MaxWidth="400"
										 MinWidth="150" />
							<!--<Button Content="three-dots"
							Margin="0 26 0  0"
							Theme="{StaticResource SvgIconButton}">
								<Button.Flyout>
									<ui:FAMenuFlyout Placement="Bottom">
										<ui:MenuFlyoutItem Text="Sync Changes"
														   IconSource="Sync"
														   IsVisible="{Binding IsDeleteProfileBtnVisible}"
														   Command="{Binding DeleteUserProfileCommand}" />
									</ui:FAMenuFlyout>
								</Button.Flyout>
							</Button>-->
							<!--<Button Theme="{StaticResource SyncChangesButton}" />-->
							
						</StackPanel>


						<StackPanel Grid.Column="2"
									Orientation="Horizontal"
										  HorizontalAlignment="Right"
										  VerticalAlignment="Center">
							
						<ContentPresenter Name="TitleContentPresenter"
										  Content="{TemplateBinding  ContentObject}"/>


						</StackPanel>
					</Grid>
				<!--</Panel>-->
			</ControlTemplate>
		</Setter>

		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Height"
                                  Duration="00:00:00.25"
                                  Easing="0,0 0,1" />
			</Transitions>
		</Setter>
		<Style Selector="^.smallest">
			<Setter Property="Height" Value="69" />
			<Style Selector="^ /template/ Image#TitleTextImageHost">
				<Setter Property="Margin" Value="12 12 0 16" />
			</Style>
		</Style>
		<Style Selector="^.smaller">
			<Setter Property="Height" Value="150" />
			<Style Selector="^ /template/ Image#TitleTextImageHost">
				<Setter Property="Margin" Value="12 12 0 16" />
			</Style>
		</Style>
		<Style Selector="^.small">
			<Setter Property="Height" Value="200" />
			<Style Selector="^ /template/ Image#TitleTextImageHost">
				<Setter Property="Margin" Value="12 12 0 16" />
			</Style>
		</Style>
	</ControlTheme>


	<ControlTheme TargetType="{x:Type Border}"
	  x:Key="MainBorderStyle">
		<Setter Property="CornerRadius"
				Value="{DynamicResource ControlCornerRadius}" />
		<Setter Property="BorderThickness"
				Value="1" />
		<Setter Property="Background"
				Value="{StaticResource CardBackgroundFillColorDefaultBrush}" />
		<Setter Property="BorderBrush"
				Value="{StaticResource ControlElevationBorderBrush}" />
	</ControlTheme>
</ResourceDictionary>
