<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="using:Chameleon.app.Avalonia.Controls"
             x:Class="Chameleon.app.Avalonia.Controls.SnapCracklePopUserControl">
		<ListBox VerticalAlignment="Top"
				 ItemsSource="{Binding RunningList}"
				 Theme="{StaticResource ListBoxNoScroller}"
				 ItemContainerTheme="{StaticResource GridViewItem}">
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<UniformGrid Columns="1"/>
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<local:UserProfileUserControl HorizontalAlignment="Stretch" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
</UserControl>
