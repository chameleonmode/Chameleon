<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
			 xmlns:dialogs="using:Chameleon.Av.Fluent.Common.Controls.Dialogs"
             x:Class="Chameleon.app.Avalonia.Controls.MoveUserProfilesPopupUserControl">
	<dialogs:ChameleonDialogControl>
		<dialogs:ChameleonDialogControl.Content>
			<StackPanel Margin="10"
						Spacing="6">
				<TextBlock 
					Text="{Binding SelectedFolder.Title,FallbackValue=Select a Folder}"
					IsVisible="{Binding SelectedFolder.Title, Converter={x:Static ObjectConverters.IsNull}}"
					Padding="4"
					Theme="{StaticResource SubtitleTextBlockStyle}"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"/>

				<ui:FAComboBox HorizontalAlignment="Stretch"
							   DisplayMemberBinding="{Binding Title}"
							   SelectedItem="{Binding SelectedFolder}"
							   ItemsSource="{Binding Folders}"
							   IsTextSearchEnabled="True" />
			</StackPanel>
		</dialogs:ChameleonDialogControl.Content>
	</dialogs:ChameleonDialogControl>
</UserControl>
