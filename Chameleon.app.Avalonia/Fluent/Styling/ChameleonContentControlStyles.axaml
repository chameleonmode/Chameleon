<ResourceDictionary
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrls="using:Chameleon.Av.Fluent.Common.Controls"
	xmlns:ui="using:FluentAvalonia.UI.Controls">

	<Design.PreviewWith>
		<StackPanel>
			<HeaderedContentControl Theme="{StaticResource HasNoItemsTheme}" 
									Header="No favorite profiles selected yet"/>
			
			<HeaderedContentControl Theme="{StaticResource HasSelectedItemsBorder}">
				<HeaderedContentControl.Header>
					<StackPanel Orientation="Horizontal">
						<ui:FAComboBox PlaceholderText="Proxy Country:"
									   BorderThickness="0"
									   VerticalAlignment="Center"
									   Width="150"
									   IsEditable="False"
									   IsTextSearchEnabled="True"
									   ItemsSource="{Binding Countries}"
									   SelectedItem="{Binding Country}">
							<ui:FAComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Name}"/>
								</DataTemplate>
							</ui:FAComboBox.ItemTemplate>
						</ui:FAComboBox>

						<Button VerticalAlignment="Center"
								ToolTip.Tip="Auto Update Proxies:"
								Margin="4 0 0 0"
								Theme="{StaticResource TransparentButton}"
								Command="{Binding FillProxiesCommand}">
							<ui:SymbolIcon Symbol="Refresh" FontSize="22" />
						</Button>
					</StackPanel>
				</HeaderedContentControl.Header>
			</HeaderedContentControl>

			<Border Padding="20" Width="800" Height="480">
				<Grid ColumnDefinitions="*,Auto,0.01*">
					<ctrls:ChameleonContentControl Title="Some Title"
												   TitleDescription="some kinda description over here">
						<ctrls:ChameleonContentControl.TitleContent>
							<Grid>
								<ui:CommandBar DefaultLabelPosition="Right">
									<ui:CommandBar.PrimaryCommands>
										<ui:CommandBarButton IconSource="Save"
														 
															 Label="Save" />
										<ui:CommandBarSeparator />
										<ui:CommandBarButton IconSource="Refresh"
															 Label="Auto Update Proxies" />
									</ui:CommandBar.PrimaryCommands>
									<ui:CommandBar.SecondaryCommands>
										<ui:CommandBarButton IconSource="Cut" Label="Cut" />
										<ui:CommandBarButton IconSource="Copy" Label="Copy" />
										<ui:CommandBarButton IconSource="Paste" Label="Paste" />
										<ui:CommandBarSeparator />
										<ui:CommandBarToggleButton IconSource="Bold" Label="Bold" />
										<ui:CommandBarToggleButton IconSource="Italic" Label="Italic" />
										<ui:CommandBarToggleButton IconSource="Underline" Label="Underline" />
									</ui:CommandBar.SecondaryCommands>
								</ui:CommandBar>
							</Grid>
						</ctrls:ChameleonContentControl.TitleContent>

						<ctrls:ChameleonContentControl.Header>
							<Grid IsVisible="{Binding !HasNoItems}">
								<StackPanel Orientation="Horizontal">
									<Button Content="select-all"
											Tag="Select all"
											Theme="{StaticResource SvgIconTextButton}"
											Command="{Binding SelectAllCommand}" />
									<StackPanel
										Orientation="Horizontal"
										Margin="2 0 0 0">
										<StackPanel.IsVisible>
											<MultiBinding  Converter="{x:Static BoolConverters.Or}">
												<Binding Path="HasFolder"/>
												<Binding Path="IsProfilesExist"/>
											</MultiBinding>
										</StackPanel.IsVisible>
										<Button Content="plus-in-circle"
												Tag="Add profile"
												Theme="{StaticResource SvgIconTextButton}"
												Command="{Binding AddProfilesToFolderCommand}"
												IsEnabled="{Binding IsAddProfilesToFolderCommandEnabled}" />
										<Button Content="minus-in-circle"
												Tag="Remove profile!!!"
												Theme="{StaticResource SvgIconTextButton}"
												Margin="4 0 0 0"
												Command="{Binding RemoveProfilesFromFolderCommand}" />
									</StackPanel>
								</StackPanel>

								<ui:FAComboBox Width="150"
											   IsEditable="False"
											   HorizontalAlignment="Right"
											   Header="Sort by:"
											   ItemsSource="{Binding Sorts}"
											   SelectedItem="{Binding SortSelected}"
											   IsVisible="{Binding IsProfilesExist}" />
							</Grid>
						</ctrls:ChameleonContentControl.Header>

						<ctrls:ChameleonContentControl.Options>
							<StackPanel Spacing="12"
										Margin="4">
								<!--DisplayMemberBinding="{Binding DisplayName, DataType=vm:ComboItem}"
											<Label Content="{Binding Title}"/>-->
								<ui:FAComboBox Header="Folder:"
											   SelectedItem="{Binding SelectedFolder}"
											   ItemsSource="{Binding FolderViewModels.Items}"
											   IsEditable="False"
											   IsTextSearchEnabled="True"
											  HorizontalAlignment="Stretch"/>
								<!--DisplayMemberBinding="{Binding DisplayName, DataType=vm:ComboItem}"
											<Label Content="{Binding Name}"/>-->
								<ui:FAComboBox Header="Current proxy country:"
											  ItemsSource="{Binding Countries.Items}"
											  SelectedItem="{Binding Country}"
											   IsEditable="False"
											   IsTextSearchEnabled="True"
											  HorizontalAlignment="Stretch"/>
							</StackPanel>
						</ctrls:ChameleonContentControl.Options>
						<ctrls:ChameleonContentControl.Content>
							<Grid RowDefinitions="*,Auto">

								<DataGrid ItemsSource="{Binding ViewModels}"
										  AutoGenerateColumns="False"
									  GridLinesVisibility="None"
									  CanUserResizeColumns="False"
									  CanUserReorderColumns="False"
									  SelectionMode="Single"
									  CanUserSortColumns="True"
									  BorderThickness="1 0 1 0">

									<DataGrid.Columns>
										<DataGridTemplateColumn Width="Auto">
											<DataGridTemplateColumn.Header>
												<CheckBox HorizontalAlignment="Center"
											IsChecked="{Binding Path=DataContext.IsSelectedAll,
                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid, AncestorLevel=1}}"/>
											</DataGridTemplateColumn.Header>
											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate>
													<CheckBox  HorizontalAlignment="Center"  IsChecked="{Binding IsSelected}"/>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>
										<DataGridTextColumn IsReadOnly="True"
															Header="PROJECT NAME"
															Binding="{Binding InProject}"
															CanUserSort="True"/>
										<DataGridTemplateColumn IsReadOnly="True"
																Width="*"
																Header="PROFILE">
											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate>
													<StackPanel Orientation="Horizontal">
														<Grid>
															<Ellipse Grid.Column="1"
																	 Fill="{StaticResource AccentFillColorSelectedTextBackgroundBrush}"
																	 Width="28"
																	 Height="28"
																	 VerticalAlignment="Center">
															</Ellipse>
															<TextBlock Text="{Binding Code}"
																	   Foreground="{StaticResource TextOnAccentFillColorSelectedTextBrush}"
																	   VerticalAlignment="Center"
																	   HorizontalAlignment="Center"  />
														</Grid>
														<TextBlock VerticalAlignment="Center"
																   Margin="13 0 0 0"
																   Text="{Binding Title}"/>
													</StackPanel>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>
										<DataGridTextColumn IsReadOnly="True"
															Width="Auto"
															Header="IP"
															Binding="{Binding UserProfileModel.Proxy.Host}"/>
										<DataGridTextColumn IsReadOnly="True"
															Width="Auto"
															Header="PORT"
															Binding="{Binding UserProfileModel.Proxy.Port}"/>
										<DataGridTextColumn IsReadOnly="True"
															Width="Auto"
															Header="USERNAME"
															Binding="{Binding UserProfileModel.Proxy.UserName}"/>
										<DataGridTextColumn IsReadOnly="True"
															Header="PASSWORD"
															Binding="{Binding UserProfileModel.Proxy.Password}"/>
										<DataGridTemplateColumn IsReadOnly="True" >
											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate>
													<StackPanel Orientation="Horizontal"
																Cursor="Hand"
																Background="Transparent">
														<Button Theme="{StaticResource TransparentButton}"
																Command="{Binding ClickIconChangeProxiesCommand}">
															<ui:SymbolIcon Symbol="Add" />
														</Button>
													</StackPanel>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>
									</DataGrid.Columns>
								</DataGrid>
								<Button Grid.Row="1"
														 DataContext="{Binding PaginatorViewModel}" />
								<!--{Binding HasSelectedItems}-->
								<Border Grid.Row="0"
										Grid.Column="0"
										Grid.ColumnSpan="2"
										Grid.RowSpan="2"
										IsVisible="False"
										Background="{StaticResource AccentFillColorDefaultBrush}"
										Padding="{StaticResource ChameleonControlMargin}"
										VerticalAlignment="Bottom">
									<StackPanel Orientation="Horizontal"
												HorizontalAlignment="Center"
												Spacing="16">
										<StackPanel Orientation="Horizontal"
													VerticalAlignment="Center">
											<TextBlock Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
													   Text="{Binding SelectedCount}"/>
											<TextBlock Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
													   Text=" Selected"/>
										</StackPanel>
										<Button Content="Unselect"
												Grid.Column="1"
												 Classes="accent"
												Command="{Binding UnselectItemsCommand}" />
										<Button Content="Change proxies"
												 Grid.Column="2"
												 Command="{Binding ChangeProxiesCommand}"/>
									</StackPanel>
								</Border>
							</Grid>
						</ctrls:ChameleonContentControl.Content>

						<ctrls:ChameleonContentControl.Footer>
							<Expander Header="PROXIES EDITOR"
									  VerticalAlignment="Bottom"
										 Name="SettingsExpander4"
									  ExpandDirection="Down"
												 IsExpanded="True">
								<Grid>
									<!--{Binding ShowCustomizeProxies}-->
									<Border CornerRadius="5 0"
										  Background="{StaticResource LayerFillColorDefaultBrush}"
										  VerticalAlignment="Bottom"
										  IsVisible="True">
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="*"/>
											</Grid.RowDefinitions>
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition/>
													<ColumnDefinition/>
												</Grid.ColumnDefinitions>
												<TextBlock Text="CUSTOMIZE PROXIES"
														   Theme="{StaticResource SubtitleTextBlockStyle}"
														   Grid.Column="0"
														   VerticalAlignment="Center"
														   HorizontalAlignment="Left"
														   Margin="25 0 0 0"/>
												<DockPanel Grid.Column="1"
														   HorizontalAlignment="Right"
														   VerticalAlignment="Center" >
													<Button Classes="accent" Command="{Binding HideCustomizeProxiesCommand}">
														<ui:SymbolIcon Symbol="Clear" />
													</Button>
												</DockPanel>
											</Grid>
											<Grid  Grid.Row="1">
												<Grid.RowDefinitions>
													<RowDefinition Height="Auto"/>
													<RowDefinition Height="Auto"/>
													<RowDefinition Height="*"/>
												</Grid.RowDefinitions>
												<Grid.ColumnDefinitions>
													<ColumnDefinition/>
													<ColumnDefinition/>
												</Grid.ColumnDefinitions>
												<TextBlock FontSize="14"
													   Text="Please add your proxies using the format below"
													   Margin="36 0 0 0"
													   VerticalAlignment="Center"/>
												<Button Width="148"
													Height="46"
													Margin="0 12 33 10"
													Content="Apply changes"
													VerticalAlignment="Center"
													HorizontalAlignment="Right"
													Grid.Column="1"
													Command="{Binding ApplyProxyCommand}"/>
												<TextBlock Grid.Row="1" Grid.Column="0"
														   FontSize="14"
														   Text="NEW PROXY"
														   Margin="36 0 0 0"
														   VerticalAlignment="Center"/>
												<TextBlock Grid.Row="1" Grid.Column="1"
														   FontSize="14"
														   Text="CURRENT PROXY"
														   Margin="36 0 0 0"
														   VerticalAlignment="Center"/>
												<StackPanel Grid.Row="2"
															Grid.Column="0">
													<TextBox
															 Margin="24 9 0 0"
															 AcceptsReturn="True"
															 TextWrapping="NoWrap"
															 Height="199"
															 Text="{Binding ApplingProxy}"
															 BorderBrush="{StaticResource BorderOutlineButton}">
													</TextBox>
													<TextBox
															 Margin="24 10 0 0"
															 Text=":"
															 BorderBrush="{StaticResource BorderOutlineButton}"
															 IsHitTestVisible="False">
													</TextBox>
												</StackPanel>
												<ListBox Grid.Row="2"
															  Grid.Column="1"
															  x:Name="itemsList"
															  ItemsSource="{Binding ViewModels}"
															  Margin="16 0 22 0"
														 IsHitTestVisible="False">
													<ListBox.ItemTemplate>
														<DataTemplate>
															<TextBox IsReadOnly="True"
																	 VerticalAlignment="Center"
																	 Margin="0 8 0 0"
																	 BorderBrush="{StaticResource BorderOutlineButton}">
																<TextBox.Text>
																	<MultiBinding Converter="{StaticResource MultiStringJoin}">
																		<Binding Path="UserProfileModel.Proxy.Host"/>
																		<Binding Path="UserProfileModel.Proxy.Port" />
																		<Binding Path="UserProfileModel.Proxy.UserName" />
																		<Binding Path="UserProfileModel.Proxy.Password" />
																	</MultiBinding>
																</TextBox.Text>
															</TextBox>
														</DataTemplate>
													</ListBox.ItemTemplate>
												</ListBox>
											</Grid>
										</Grid>
									</Border>
								</Grid>
							</Expander>
						</ctrls:ChameleonContentControl.Footer>

					</ctrls:ChameleonContentControl>

					<!--<GridSplitter Grid.Column="1" />-->
				</Grid>
			</Border>
		</StackPanel>
	</Design.PreviewWith>
	<ControlTheme TargetType="ctrls:ChameleonContentControl"
                  x:Key="{x:Type ctrls:ChameleonContentControl}">
		<Setter Property="Margin" Value="12 0 12 12" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid RowDefinitions="Auto,*">

					<!-- Header -->
					<Grid ColumnDefinitions="Auto,*">

						<TextBlock Text="{TemplateBinding Title}"
								   Padding="12"
								   Theme="{StaticResource SubtitleTextBlockStyle}" />

						<ContentPresenter Grid.Column="1"
										  Name="TitlePresenter"
								  Content="{TemplateBinding TitleContent}"
								  HorizontalAlignment="Stretch"
										  VerticalAlignment="Bottom"/>
					</Grid>

					<!-- Content Area -->
					<Border Name="ControlPreviewAreaHost"
								 Grid.Row="1"
							BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
							BorderThickness="0"
							Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
							TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
							CornerRadius="{DynamicResource OverlayCornerRadius}">
						<Grid RowDefinitions="Auto,*">
							<Grid RowDefinitions="Auto,*">
								<StackPanel>
									<TextBlock Text="{TemplateBinding TitleDescription}"
											   Padding="6 14 6 0"
											   Margin="12 0 12 12"
											   Theme="{StaticResource CaptionTextBlockStyle}"
											   IsVisible="{TemplateBinding TitleDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
									<ContentPresenter Name="HeaderPresenter"
													  Padding="0 0 6 0"
													  Margin="12 0 12 12"
													  Grid.Row="1"
													  Content="{TemplateBinding Header}"
													  ContentTemplate="{TemplateBinding HeaderTemplate}"
													  HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
													  VerticalContentAlignment="Center"
													  IsVisible="{TemplateBinding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
								</StackPanel>


								<Grid Grid.Row="1"
									  ColumnDefinitions="*,Auto"
									  RowDefinitions="Auto,*,Auto,Auto">
									<Rectangle Name="TopRowPlaceholder"
											   IsHitTestVisible="False"
											   IsVisible="False"
											   MinHeight="36" />

									<ContentPresenter Name="ContentsPresenter"
													  Content="{TemplateBinding Content}"
													  ContentTemplate="{TemplateBinding ContentTemplate}"
													  HorizontalAlignment="Stretch"
													  VerticalAlignment="Stretch"
													  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
													  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
													  Padding="12 0 12 12"
													  Grid.ColumnSpan="1"
													  Grid.Row="1">
										<ContentPresenter.Transitions>
											<Transitions>
												<ThicknessTransition Duration="00:00:00.167"
																	 Property="Padding" />
											</Transitions>
										</ContentPresenter.Transitions>
									</ContentPresenter>

									<!-- Options Area -->
									<Border
										VerticalAlignment="Top"
										Name="OptionsHost"
										Margin="12 0 12 12"
										Padding="12"
											CornerRadius="{DynamicResource OverlayCornerRadius}"
											Grid.Column="1"
											Grid.Row="1"
											Background="{DynamicResource LayerFillColorDefaultBrush}"
											BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
											BorderThickness="1"
											Opacity="1"
											IsVisible="False">
										<Border.Transitions>
											<Transitions>
												<DoubleTransition Property="Opacity"
																  Duration="00:00:00.167" />
											</Transitions>
										</Border.Transitions>
										<StackPanel>
											<DockPanel LastChildFill="False">
												<TextBlock
													Text="Options"
													DockPanel.Dock="Left"
													HorizontalAlignment="Left"
													VerticalAlignment="Center"
													FontWeight="SemiBold"
													Margin="0 3 0 0" />

												<Button
													Name="ShowHideOptionsButton"
													Theme="{StaticResource TransparentButton}"
													DockPanel.Dock="Right"
													Margin="6 0 0 0"
													IsVisible="False">
													<ui:SymbolIcon Symbol="{TemplateBinding IconShevron}" />
												</Button>
											</DockPanel>
											<ContentPresenter Name="OptionPresenter"
															   Margin="0 12 0 0"
															  Content="{TemplateBinding Options}"
															  HorizontalContentAlignment="Stretch"
															  VerticalContentAlignment="Stretch"
															  IsVisible="{TemplateBinding IsOptionsExpanded}"/>
										</StackPanel>
									</Border>

								</Grid>

							</Grid>

							<!-- Footer Area -->
							<ContentPresenter Name="FooterPresenter"
											  Content="{TemplateBinding Footer}"
											  HorizontalAlignment="Stretch"
											  VerticalAlignment="Bottom"
											  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
											  Margin="12 0 12 12"
											  CornerRadius="0 0 8 8"
											  Grid.ColumnSpan="2"
											  Grid.Row="2">
							</ContentPresenter>
						</Grid>
					</Border>
				</Grid>
			</ControlTemplate>
		</Setter>

		<Style Selector="^ /template/ Border#ControlPreviewAreaHost">
			<Setter Property="CornerRadius" Value="{Binding Source={StaticResource OverlayCornerRadius}, Converter={StaticResource BottomCornerRadiusFilterConverter}}" />
		</Style>

		<Style Selector="^:options /template/ Border#OptionsHost">
			<Setter Property="IsVisible" Value="True" />
		</Style>

		<Style Selector="^:mediumWidth">
			<Style Selector="^ /template/ ContentPresenter#ContentsPresenter">
				<Setter Property="Grid.ColumnSpan" Value="2" />
				<!--<Setter Property="Padding" Value="12 24 12 12" />-->
			</Style>

			<Style Selector="^ /template/ Border#OptionsHost">
				<Setter Property="Grid.Column" Value="0" />
				<Setter Property="Grid.Row" Value="0" />
				<Setter Property="Grid.RowSpan" Value="2" />
				<Setter Property="HorizontalAlignment" Value="Right" />
				<Setter Property="VerticalAlignment" Value="Top" />
				<Setter Property="Opacity" Value="0.5" />
				<Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
			</Style>
			<Style Selector="^ /template/ Rectangle#TopRowPlaceholder">
				<Setter Property="IsVisible" Value="True" />
			</Style>
			<Style Selector="^ /template/ Button#ShowHideOptionsButton">
				<Setter Property="IsVisible" Value="True" />
			</Style>

			<Style Selector="^ /template/ Border#OptionsHost:pointerover">
				<Setter Property="Opacity" Value="1" />
			</Style>

			<!-- Small width applies on top of medium width -->
			<Style Selector="^:smallWidth">
				<Style Selector="^ /template/ Button#ShowHideOptionsButton">
					<Setter Property="IsVisible" Value="False" />
				</Style>

				<Style Selector="^ /template/ Border#OptionsHost">
					<Setter Property="Grid.Column" Value="0" />
					<Setter Property="Grid.ColumnSpan" Value="2" />
					<Setter Property="Grid.Row" Value="2" />
					<Setter Property="Grid.RowSpan" Value="1" />
					<Setter Property="HorizontalAlignment" Value="Center" />
					<Setter Property="VerticalAlignment" Value="Top" />
					<Setter Property="Opacity" Value="1" />
					<Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
				</Style>
				<Style Selector="^ /template/ Rectangle#TopRowPlaceholder">
					<Setter Property="IsVisible" Value="False" />
				</Style>
			</Style>
		</Style>

		<Style Selector="^:optionsfull /template/ ui|SymbolIcon#OptionsChevron">
			<Setter Property="Symbol" Value="ChevronUp" />
		</Style>

	</ControlTheme>

	<ControlTheme x:Key="HasSelectedItemsBorder"
		  TargetType="HeaderedContentControl">
		<Setter Property="IsVisible" Value="{Binding HasSelectedItems}" />
		<Setter Property="VerticalAlignment" Value="Bottom" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="MinWidth" Value="420" />
		<!--<Setter Property="TextElement.Foreground"  />-->
		<!--Value="{StaticResource TextOnAccentFillColorPrimaryBrush}"-->
		<Setter Property="Template">
			<ControlTemplate>
				<Border
					Background="{StaticResource LayerFillColorDefaultBrush}"
					HorizontalAlignment="Center"
					Height="50"
					CornerRadius="{StaticResource ControlCornerRadius}"
					Margin="0 0 0 3"
					BoxShadow="0 8 32 0 #66000000">
					<Grid Margin="24 0"
						 ColumnDefinitions="*,Auto">
						<TextBlock VerticalAlignment="Center">
							<Run Text="{Binding SelectedCount}" />
							<Run Text=" Selected" />
						</TextBlock>

						<StackPanel Orientation="Horizontal"
									Grid.Column="1">
							<Border
								BorderBrush="{StaticResource DividerStrokeColorDefaultBrush}"
								Margin="18 6"
								BorderThickness="1 0 0 0"
								IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}"/>

							<ContentPresenter Content="{TemplateBinding Header}" />

							<Border BorderBrush="{StaticResource DividerStrokeColorDefaultBrush}"
									Margin="18 6"
									BorderThickness="1 0 0 0" />

							<Button Theme="{StaticResource TransparentButton}"
									Classes="accent"
									Content="Unselect"
									Command="{Binding UnselectItemsCommand}" />
						</StackPanel>
					</Grid>
				</Border>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<ControlTheme x:Key="HasNoItemsTheme" TargetType="HeaderedContentControl">
		<Setter Property="Content" Value="&#xE1D3;" />
		<Setter Property="IsVisible" Value="{Binding HasNoItems}" />
		<Setter Property="Margin" Value="6 38 6 6" />
		<Setter Property="Height" Value="156" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Template">
			<ControlTemplate>
				<StackPanel>
					<!--
					&#xE155;
					&#xE178;
					&#xE1D2;
					&#xE138;
					&#xE703;
					&#xE155;
					&#xE753;
					&#xE130; document
					&#xE188; folder
					&#xE1D3; library
					&#xE14C;; list
					-->
					<Border CornerRadius="180"
							Width="90"
							Height="90"
							BorderThickness="2"
							BorderBrush="{StaticResource AccentFillColorTertiaryBrush}"
							Background="{StaticResource ControlOnImageFillColorDefaultBrush}">
						<ui:FontIcon
							Glyph="{TemplateBinding Content}"
							FontSize="54"
							Foreground="{StaticResource AccentFillColorTertiaryBrush}"
							FontFamily="{StaticResource SymbolThemeFontFamily}" />
					</Border>

					<TextBlock
						Margin="0 25 0 0"
						Text="{TemplateBinding Header}"
						Theme="{StaticResource SubtitleTextBlockStyle}" />
				</StackPanel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>
</ResourceDictionary>
