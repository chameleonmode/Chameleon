	<ui:SymbolIconSource Symbol="Settings" x:Key="SettingsIcon" />
	<ui:SymbolIconSource Symbol="SettingsFilled" x:Key="SettingsIconFilled" />

	<!-- subpage Icons -->
	<ui:SymbolIconSource x:Key="DefaultSettingsPageIcon" Symbol="TwoPage" />
	<ui:SymbolIconSource x:Key="Proxy" Symbol="Globe" />
	<ui:SymbolIconSource x:Key="ProxyCred" Symbol="CloudSync" />
	<ui:SymbolIconSource x:Key="CellPhone" Symbol="CellPhone" />
	<ui:SymbolIconSource x:Key="Phone" Symbol="Phone" />
	<ui:SymbolIconSource x:Key="User" Symbol="OtherUser" />

	<!-- Icons -->
	<ui:SymbolIconSource x:Key="ClosePane" Symbol="ClosePane" />
	<ui:SymbolIconSource x:Key="Import" Symbol="Import" />
	<ui:SymbolIconSource x:Key="GoIcon" Symbol="ChevronRight" />
	<ui:SymbolIconSource Symbol="Save"  x:Key="SaveIcon" />

	<ui:BitmapIconSource x:Key="logosymbolIcon" UriSource="avares://Chameleon.app.Avalonia/Assets/logosymbol.ico" />
	<ui:ImageIconSource x:Key="logo_big" Source="avares://Chameleon.app.Avalonia/Assets/logo-big.png" />
