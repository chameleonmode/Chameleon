<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:FluentAvalonia.UI.Controls" >
	<Design.PreviewWith>
		<Viewbox Width="28"
				Height="28"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				Margin="12 6">
			<ui:IconSourceElement IconSource="{StaticResource logo_symbol}"
								  MinHeight="12"
								  MinWidth="12" />
		</Viewbox>
	</Design.PreviewWith>
	
    <!-- Override this so content doesn't appear in title bar area -->
    <Thickness x:Key="NavigationViewContentMargin">0,48,0,0</Thickness>
	
	<!-- Marginz and paddingz -->
	<Thickness x:Key="ChameleonAppPageMargin">8 0</Thickness>
	<Thickness x:Key="ChameleonControlMargin">8</Thickness>
	<Thickness x:Key="ChameleonInnerControlMargin">4</Thickness>
	<Thickness x:Key="ScrollviewerAppPageMargin">20 20 20 0</Thickness>

	<!-- page Icons-->	
	<ui:SymbolIconSource Symbol="Home" x:Key="HomeIcon" />
	<ui:SymbolIconSource Symbol="HomeFilled" x:Key="HomeIconFilled" />
	
	<ui:SymbolIconSource Symbol="ContactInfo" x:Key="ContactIcon" />
	<ui:SymbolIconSource Symbol="ContactInfoFilled" x:Key="ContactIconFilled" />

	<ui:SymbolIconSource Symbol="Play" x:Key="AutomationIcon" />
	<ui:SymbolIconSource Symbol="PlayFilled" x:Key="AutomationIconFilled" />

