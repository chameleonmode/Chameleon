<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 Name="Chameleon"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Chameleon.app.Avalonia.App">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://Chameleon.app.Avalonia/Common/Fluent/Styling/Resources.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
		<FontFamily x:Key="ContentControlThemeFontFamily">avares://Chameleon.app.Avalonia/Assets/Fonts/Nunito#Nunito</FontFamily>
	</Application.Resources>

	<Application.Styles>
		<!-- As of preview5, these properties now default to false -->
		<sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" TextVerticalAlignmentOverrideBehavior="AlwaysEnabled" />
		<StyleInclude Source="avares://Chameleon.app.Avalonia/Common/Avalonia/Styles/Icons.axaml" />
		<StyleInclude Source="avares://Chameleon.app.Avalonia/Common/Fluent/Styling/ChameleonStyles.axaml" />
		<!--<StyleInclude Source="avares://FAControlsGallery/Styling/ControlsGalleryStyles.axaml" />-->
	</Application.Styles>

	<NativeMenu.Menu>
		<NativeMenu>
			<NativeMenuItem Header="Chameleon" />
		</NativeMenu>
	</NativeMenu.Menu>
</Application>
