<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:folder="using:Chameleon.app.Avalonia.Features.Search.ByTags"
			 xmlns:controls="using:Chameleon.app.Avalonia.Features.Search.ByTags.Controls"
             x:Class="Chameleon.app.Avalonia.Features.Search.ByTags.View">
	<Border Background="#EBEBEB" Padding="5" CornerRadius="5" DataContext="{Binding ViewModel}">
		<ItemsControl ItemsSource="{Binding Items}">
			<ItemsControl.DataTemplates>
				<folder:TagsTemplateSelector>
					<DataTemplate x:Key="Folder">
						<controls:TagFolderSearchControl TagItem="{Binding}"/>
					</DataTemplate>
					<DataTemplate x:Key="Profiles">
						<controls:TagProfilesSearchControl TagItem="{Binding}"/>
					</DataTemplate>
				</folder:TagsTemplateSelector>
			</ItemsControl.DataTemplates>
		</ItemsControl>
	</Border>
</UserControl>
