<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
			 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
			 xmlns:appuc="using:Chameleon.app.Avalonia.Controls"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:controls="using:Chameleon.app.Avalonia.Controls"
             x:Class="Chameleon.app.Avalonia.TestUserControl" BorderThickness="0" Background="Transparent">
	<Border Background="#EBEBEB" Padding="5" CornerRadius="5">
		<ScrollViewer>
			<StackPanel Spacing="5">
				<StackPanel>
					<Label FontSize="16">Profiles</Label>
					<StackPanel Spacing="3">
						<controls:UserProfileUserControl Background="White"/>
						<controls:UserProfileUserControl Background="White"/>
						<controls:UserProfileUserControl Background="White"/>
						<controls:UserProfileUserControl Background="White"/>
					</StackPanel>
				</StackPanel>
				<StackPanel>
					<Label FontSize="16">Folders</Label>
					<StackPanel Spacing="3">
						<controls:FolderUserControl Background="White"/>
						<controls:FolderUserControl Background="White"/>
						<controls:FolderUserControl Background="White"/>
						<controls:FolderUserControl Background="White"/>
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Border>
</UserControl>
