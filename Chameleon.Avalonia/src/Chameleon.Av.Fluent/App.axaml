<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Chameleon.Av.Fluent.App">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://Chameleon.Av.Fluent.Common/Styling/Resources.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
		<FontFamily x:Key="ContentControlThemeFontFamily">avares://Chameleon.Avalonia.Common/Assets/Fonts/Nunito#Nunito</FontFamily>
	</Application.Resources>

	<Application.Styles>
		<!-- As of preview5, these properties now default to false -->
		<sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" TextVerticalAlignmentOverrideBehavior="AlwaysEnabled" />
		<StyleInclude Source="avares://Chameleon.Avalonia.Common/Styles/Icons.axaml" />
		<StyleInclude Source="avares://Chameleon.Av.Fluent.Common/Styling/ChameleonStyles.axaml" />
		<!--<StyleInclude Source="avares://FAControlsGallery/Styling/ControlsGalleryStyles.axaml" />-->
	</Application.Styles>
	
</Application>
