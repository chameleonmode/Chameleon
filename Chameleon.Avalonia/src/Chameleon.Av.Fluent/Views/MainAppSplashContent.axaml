<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:dialogs="using:Chameleon.Av.Fluent.Dialogs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chameleon.Av.Fluent.Views.MainAppSplashContent">
	<Panel>
		<StackPanel Spacing="1"
                    VerticalAlignment="Center">
			<ui:IconSourceElement IconSource="{StaticResource logo_symbol}"
								   Width="150"
								  Height="160"/>

			<ProgressBar Name="TargetProgressBar"
						 IsIndeterminate="False"
						 IsVisible="True"
						 MaxWidth="250"
						 MaxHeight="200"
						 Margin="10 20 0 20"
						 Orientation="Horizontal"
						 HorizontalAlignment="Stretch"
						 VerticalAlignment="Stretch" />


			<TextBlock Text="Loading..."
                       Name="LoadingText"
                       HorizontalAlignment="Center"
                       FontSize="20"/>
		</StackPanel>
		<!--<dialogs:LoginTaskDialog IsVisible="False"
						 Name="LoginTaskDialogHost" />-->
	</Panel>
</UserControl>
