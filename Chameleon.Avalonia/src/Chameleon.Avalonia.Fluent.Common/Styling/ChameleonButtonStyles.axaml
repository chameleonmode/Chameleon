	<afv:SvgIconControl
		IconName="select-all"
		Margin="0 0 10 0"
		Width="16"
		Height="16"/>
	<TextBlock
		Text="{Binding $parent[Button].Tag}"
		Margin="0 0 12 0"
		VerticalAlignment="Center"/>
</StackPanel>-->