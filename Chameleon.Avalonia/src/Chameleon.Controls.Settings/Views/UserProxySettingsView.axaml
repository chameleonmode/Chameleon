<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:vm="using:Chameleon.Avalonia.Controls.Settings.ViewModels"
			 xmlns:interfaces="using:Chameleon.Interfaces.Proxies"
			 xmlns:paginator="using:Chameleon.Avalonia.Controls.Paginator"
			 xmlns:conv="using:Chameleon.Avalonia.Common.Converters.ValueConverters"
			 xmlns:avfCommon="using:Chameleon.Av.Fluent.Common.Controls"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1480"
			 x:DataType="vm:UserProxySettingsViewModel"
             x:Class="Chameleon.Avalonia.Controls.Settings.UserProxySettingsView">
	<UserControl.Resources>
		<conv:MultiStringJoinConverter x:Key="MultiStringJoin" />
		<!--<converter:MultiStringJoinConverter x:Key="MultiStringJoin"/>-->
	</UserControl.Resources>
		<Border Padding="20">
			<Grid RowDefinitions="*,Auto">
				<avfCommon:ChameleonContentControl Title="Proxies list"
												   TitleDescription="Select proxies to edit them">
					<avfCommon:ChameleonContentControl.TitleContent>
						<Grid HorizontalAlignment="Right">
							<ui:CommandBar DefaultLabelPosition="Right">
								<ui:CommandBar.PrimaryCommands>
									<ui:CommandBarElementContainer>
										<ui:FAComboBox PlaceholderText="Proxy Country:"
													   ItemsSource="{Binding Countries.Items}"
													SelectedItem="{Binding Country}"
													 IsEditable="False"
													 IsTextSearchEnabled="True"
														VerticalAlignment="Center">
											<ui:FAComboBox.ItemTemplate>
												<DataTemplate>
													<Label Content="{Binding Name}"/>
												</DataTemplate>
											</ui:FAComboBox.ItemTemplate>
										</ui:FAComboBox>
									</ui:CommandBarElementContainer>
									<ui:CommandBarButton IconSource="Refresh"
														 Label="Auto Update Proxies"
														 Command="{Binding FillProxiesCommand}"
														 IsEnabled="{Binding FillProxiesIsEnabled}"/>
								</ui:CommandBar.PrimaryCommands>
							</ui:CommandBar>
						</Grid>
					</avfCommon:ChameleonContentControl.TitleContent>

					<avfCommon:ChameleonContentControl.Header>
						<StackPanel>
								<Button Content="select-all"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Tag="Select all"
										Theme="{StaticResource SvgIconTextButton}"
										Command="{Binding SelectAllCommand}" />
							

							<HeaderedContentControl Grid.Row="1"
													Theme="{StaticResource HasSelectedItemsBorder}">
								<HeaderedContentControl.Header>
									<Button Theme="{StaticResource TransparentButton}"
											TextElement.Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
											Content="Change proxies"
											Grid.Column="2"
											Command="{Binding ChangeProxiesCommand}"/>
								</HeaderedContentControl.Header>
							</HeaderedContentControl>
						</StackPanel>
					</avfCommon:ChameleonContentControl.Header>
					
					<avfCommon:ChameleonContentControl.Options>
						<StackPanel Spacing="12">
							<ui:FAComboBox PlaceholderText="Selected Folder"
										   Width="180"
										   Header="Folder:"
										   IsEditable="False"
										   IsTextSearchEnabled="True"
										   HorizontalAlignment="Stretch"
										   SelectedItem="{Binding SelectedFolder}"
										   ItemsSource="{Binding FolderViewModels.Items}"
										   DisplayMemberBinding="{Binding Title, x:DataType=vm:ProfileFolderViewModel}" />
						</StackPanel>
					</avfCommon:ChameleonContentControl.Options>
					
					<avfCommon:ChameleonContentControl.Content>
						<StackPanel>
							<paginator:PaginatorView Grid.Row="1"
													 DataContext="{Binding PaginatorViewModel}" />
								<ListBox 
									Theme="{StaticResource ListBoxNoScroller}"
									ItemContainerTheme="{StaticResource GridViewItem}"
									ItemsSource="{Binding ViewModels}">
									<ListBox.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel />
										</ItemsPanelTemplate>
									</ListBox.ItemsPanel>
									<ListBox.ItemTemplate>
										<DataTemplate>
											<Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
													CornerRadius="{StaticResource ControlCornerRadius}"
													BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
													BorderThickness="1"
													Padding="6">
												<Grid ColumnDefinitions="Auto,Auto,*,Auto">
													<CheckBox IsChecked="{Binding IsSelected}"
															  Margin="6 0 0 0" />
													
													<Border Grid.Column="1"
															Background="{StaticResource AccentFillColorDefaultBrush}"
															BorderBrush="{StaticResource ControlStrokeColorOnAccentDefaultBrush}"
															CornerRadius="180"
															Width="30"
															Height="30">
														<TextBlock Text="{Binding Code}"
																   Margin="0 -1 0 0"
																   Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
																   VerticalAlignment="Center"
																   HorizontalAlignment="Center"  />
													</Border>

													<Grid Grid.Column="2"
														  Margin="12 0">
														<avfCommon:HeaderdInputFieldsControl Title="{Binding Title}"
																							 Header="False">
															<avfCommon:HeaderdInputFieldsControl.TextBoxes>
																<TextBox Text="{Binding Path=UserProfileModel.Proxy.Host}"
																		 IsReadOnly="True" />
																<TextBox Text="{Binding Path=UserProfileModel.Proxy.PortString}"
																		 IsReadOnly="True" />
																<TextBox Text="{Binding Path=UserProfileModel.Proxy.UserName}"
																		 IsReadOnly="True" />
																<TextBox Text="{Binding Path=UserProfileModel.Proxy.Password}"
																		 IsReadOnly="True" />
															</avfCommon:HeaderdInputFieldsControl.TextBoxes>
														</avfCommon:HeaderdInputFieldsControl>
													</Grid>

													<Button Grid.Column="4"
															Margin="0 0 6 0"
															Theme="{StaticResource TransparentButton}"
															Command="{Binding ClickIconChangeProxiesCommand}">
														<ui:SymbolIcon Symbol="Add" />
													</Button>
												</Grid>
											</Border>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>

						</StackPanel>
					</avfCommon:ChameleonContentControl.Content>

					<avfCommon:ChameleonContentControl.Footer>
						<ui:SettingsExpander Header="PROXIES EDITOR"
											 VerticalAlignment="Bottom"
											 IsVisible="{Binding ShowCustomizeProxies}"
											 IsExpanded="True"
									 IconSource="Image">
							<ui:SettingsExpanderItem>
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="*"/>
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition/>
										<ColumnDefinition/>
									</Grid.ColumnDefinitions>
									<Grid Grid.ColumnSpan="2"
										  Margin="12">
										<TextBlock Theme="{StaticResource CaptionTextBlockStyle}"
												   Text="Please add your proxies using the format below" />
										<Button Width="148"
												Height="46"
												Content="Apply changes"
												HorizontalAlignment="Right"
												Classes="accent"
												Command="{Binding ApplyProxyCommand}"/>
									</Grid>

									<StackPanel Grid.Row="1"
												Grid.Column="0"
											Margin="12">
										<TextBlock Grid.Row="1"
												   Grid.Column="0"
												   Margin="0 0 0 0"
												   Theme="{StaticResource SubtitleTextBlockStyle}"
												   Text="NEW PROXY"/>
										<TextBox Margin="0 12 0 0"
												 AcceptsReturn="True"
												 TextWrapping="NoWrap"
												 Height="200"
												 Text="{Binding ApplingProxy}">
										</TextBox>
										<TextBox Margin="0 10 0 0"
												 Text=":"
												 BorderBrush="{StaticResource BorderOutlineButton}"
												 IsHitTestVisible="False">
										</TextBox>
									</StackPanel>
									<StackPanel Grid.Row="1"
											 Grid.Column="1"
											Margin="12">
										<TextBlock Grid.Row="1"
											   Grid.Column="1"
											   Margin="0 0 0 0"
											   Theme="{StaticResource SubtitleTextBlockStyle}"
											   Text="CURRENT PROXY"/>
										<ItemsControl
											 x:Name="itemsList"
											 ItemsSource="{Binding ViewModels}"
											 Margin="0 0 22 0">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<avfCommon:HeaderdInputFieldsControl Title="{Binding Title}"
																						 IsVisible="{Binding IsSelected}"
																						 Header="False">
														<avfCommon:HeaderdInputFieldsControl.TextBoxes>
															<TextBox Text="{Binding Path=UserProfileModel.Proxy.Host}" />
															<TextBox Text="{Binding Path=UserProfileModel.Proxy.PortString}"/>
															<TextBox Text="{Binding Path=UserProfileModel.Proxy.UserName}"/>
															<TextBox Text="{Binding Path=UserProfileModel.Proxy.Password}" />
														</avfCommon:HeaderdInputFieldsControl.TextBoxes>
													</avfCommon:HeaderdInputFieldsControl>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Grid>
							</ui:SettingsExpanderItem>
						</ui:SettingsExpander>
					</avfCommon:ChameleonContentControl.Footer>
				</avfCommon:ChameleonContentControl>
			</Grid>
		</Border>
</UserControl>
