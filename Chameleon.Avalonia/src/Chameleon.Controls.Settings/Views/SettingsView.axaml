<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Chameleon.Avalonia.Controls.Settings.ViewModels"
             xmlns:contrls="using:Chameleon.Av.Fluent.Common.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="vm:SettingsViewModel"
			 x:CompileBindings="True"
             x:Class="Chameleon.Avalonia.Controls.Settings.SettingsView">
	<UserControl.Resources>
		<ui:SymbolIconSource x:Key="Proxy" Symbol="WifiProtected" />
		<ui:SymbolIconSource x:Key="ProxyCred" Symbol="WifiWarning" />
		<ui:SymbolIconSource x:Key="CellPhone" Symbol="CellPhone" />
		<ui:SymbolIconSource x:Key="User" Symbol="OtherUser" />
		<ui:SymbolIconSource x:Key="Import" Symbol="Import" />
		<ui:SymbolIconSource x:Key="GoIcon" Symbol="ChevronRight" />
	</UserControl.Resources>
	
	<DockPanel>
		<!--<StackPanel DockPanel.Dock="Top" Spacing="5">
			<Grid Background="LightGray" ColumnDefinitions="Auto, *">
				<TextBlock Text="{Binding Title}"
						   Grid.Column="1"
						   Margin="5"
						   VerticalAlignment="Center"
						   FontWeight="Bold" />
			</Grid>
		</StackPanel>-->

		<ScrollViewer>
			<StackPanel>
				<contrls:PageHeaderControl TextType="FAControls"
										   Classes="smaller"/>
				<!--<TextBlock Text="Settings"
                        Margin="30 -30 0 0"
						   Theme="{StaticResource TitleLargeTextBlockStyle}"/>-->
			<StackPanel Spacing="15"
                        Margin="30 0 30 30">
				<ui:SettingsExpander Header="Default"
					 IconSource="{StaticResource DefaultSettingsPageIcon}"
					 Description="Default home pages"
					 IsClickEnabled="True"
					 ActionIconSource="{StaticResource GoIcon}"
					 Command="{Binding CmdNavigateToChildCommand}"
					 CommandParameter="DEFAULTS"/>
				<ui:SettingsExpander Header="PROXY"
					 IconSource="{StaticResource Proxy}"
					 Description="Proxy settings"
					 IsClickEnabled="True"
					 ActionIconSource="{StaticResource GoIcon}"
					 Command="{Binding CmdNavigateToChildCommand}"
					 CommandParameter="PROXY"/>
				<ui:SettingsExpander Header="PROXY CREDIT"
					 IconSource="{StaticResource ProxyCred}"
					 Description="Proxy credit settings"
					 IsClickEnabled="True"
					 ActionIconSource="{StaticResource GoIcon}"
					 Command="{Binding CmdNavigateToChildCommand}"
					 CommandParameter="PROXYCREDIT"/>
				<ui:SettingsExpander Header="PHONE VERIFICATION"
					 IconSource="{StaticResource CellPhone}"
					 Description="Phone verification settings"
					 IsClickEnabled="True"
					 ActionIconSource="{StaticResource GoIcon}"
					 Command="{Binding CmdNavigateToChildCommand}"
					 CommandParameter="PHONEVERIFICATION"/>
				<ui:SettingsExpander Header="USERS"
					 IconSource="{StaticResource User}"
					 Description="Users settings"
					 IsClickEnabled="True"
					 ActionIconSource="{StaticResource GoIcon}"
					 Command="{Binding CmdNavigateToChildCommand}"
					 CommandParameter="USERS"/>
				<ui:SettingsExpander Header="IMPORT PROFILES"
					 IconSource="{StaticResource Import}"
					 Description="Import profiles from file"
					 IsClickEnabled="True"
					 ActionIconSource="{StaticResource GoIcon}"
					 Command="{Binding CmdNavigateToChildCommand}"
					 CommandParameter="IMPORTPROFILES"/>
			</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
	<!--<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Border Grid.Row="0"
                BorderBrush="{StaticResource DividerLine}"
                BorderThickness="0 1 0 0">
			<TextBlock Foreground="Black"
                       Text="Settings"
                       FontSize="18"
                       Margin="23 18 0 18" />
		</Border>
		<TabControl Grid.Row="1"
					SelectedIndex="{Binding SelectedIndex}">
			<TabItem Header="DEFAULTS">
				<ContentControl x:Name="userDefaultSettingsView" />
			</TabItem>
			<TabItem Header="PROXY"
                     IsVisible="{Binding CustomTabs.HasProxySettingsView}">
				<ContentControl x:Name="userProxySettingsView" />
			</TabItem>
			<TabItem Header="PROXY CREDIT"
                     IsVisible="{Binding CustomTabs.HasProxyCredit}">
				<ContentControl x:Name="proxyCreditView" />
			</TabItem>
			<TabItem Header="PHONE VERIFICATION"
                     IsVisible="{Binding CustomTabs.HasPhoneVerification}">
				<ContentControl x:Name="phoneVerificationView" />
			</TabItem>
			<TabItem Header="USERS"
                     IsVisible="{Binding CustomTabs.HasAssistantUsers}">
				<ContentControl x:Name="assistantUsersView" />
			</TabItem>
			<TabItem Header="IMPORT PROFILES"
                     IsVisible="{Binding CustomTabs.HasImport}">
				<ContentControl x:Name="importView" />
			</TabItem>
			<TabItem Header="EXPORT PROFILES"
                     IsVisible="{Binding CustomTabs.HasExport}">
				<ContentControl x:Name="exportView" />
			</TabItem>
		</TabControl>

		<materialDesign:Snackbar Style="{StaticResource SnackbarBinded}">
			<materialDesign:SnackbarMessage Style="{StaticResource SnackbarMessageBinded}" />
		</materialDesign:Snackbar>
	</Grid>-->
</UserControl>
