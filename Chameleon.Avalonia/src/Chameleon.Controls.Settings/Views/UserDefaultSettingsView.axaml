<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Chameleon.Avalonia.Controls.Settings.ViewModels"
			 xmlns:ctrls="using:Chameleon.Av.Fluent.Common.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:CompileBindings="True"
			 x:DataType="vm:UserDefaultSettingsViewModel"
             x:Class="Chameleon.Avalonia.Controls.Settings.UserDefaultSettingsView">
	<UserControl.Resources>

	</UserControl.Resources>
	<Border Padding="20">
			<ctrls:ChameleonContentControl Title="Saved Pages"
										   TitleDescription="Select and edit default saved pages">
				<ctrls:ChameleonContentControl.TitleContent>
					<ui:CommandBar DefaultLabelPosition="Right"
								   HorizontalAlignment="Right">
						<ui:CommandBar.PrimaryCommands>
							<ui:CommandBarButton IconSource="Save"
												 Label="Save"
												 Command="{Binding SaveCommand}"/>
							<ui:CommandBarButton IconSource="Add"
												 Label="New"
												 Command="{Binding CreateNewDefaultSettingsCommand}"/>
							<ui:CommandBarButton IconSource="Page"
												 Label="Add pages"
												 Command="{Binding BulkAddPagesCommand}"/>
						</ui:CommandBar.PrimaryCommands>
					</ui:CommandBar>
				</ctrls:ChameleonContentControl.TitleContent>
				<ctrls:ChameleonContentControl.Header>
					<HeaderedContentControl Theme="{StaticResource HasSelectedItemsBorder}">
						<HeaderedContentControl.Header>
							<Button Theme="{StaticResource SvgIconTextButton}"
									Content="delete"
									Tag="Delete"
									Margin="3 0 0 0"
									Command="{Binding RemoveSelectedItemsCommand}" />
						</HeaderedContentControl.Header>
					</HeaderedContentControl>
				</ctrls:ChameleonContentControl.Header>
				<ctrls:ChameleonContentControl.Content>
					<Panel>
					<ListBox ItemsSource="{Binding ViewModels}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid Margin="{StaticResource ChameleonInnerControlMargin}"
									  ColumnDefinitions="Auto,*,Auto">
									<CheckBox Grid.Column="0"
											  IsChecked="{Binding IsChecked}"/>
									<TextBox Grid.Column="1"
											  Margin="{StaticResource ChameleonInnerControlMargin}"
											 Text="{Binding DefaultUrl}"  />
									<Button Theme="{DynamicResource TransparentButton}"
											Grid.Column="2"
											 Margin="{StaticResource ChameleonInnerControlMargin}"
											Content="Delete"
											 Classes="accent"
											Command="{Binding DeleteDefaultSettingsCommand}">
										<ui:SymbolIcon Symbol="Delete" />
									</Button>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					</Panel>
				</ctrls:ChameleonContentControl.Content>

				<ctrls:ChameleonContentControl.Footer>

				</ctrls:ChameleonContentControl.Footer>
			</ctrls:ChameleonContentControl>
	</Border>
</UserControl>
