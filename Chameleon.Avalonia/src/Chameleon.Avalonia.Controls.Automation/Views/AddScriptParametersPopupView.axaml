<UserControl
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:dialogs="using:Chameleon.Av.Fluent.Common.Controls.Dialogs"
    x:Class="Chameleon.Avalonia.Controls.Automation.Views.AddScriptParametersPopupView"
	xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
	xmlns:ui="using:FluentAvalonia.UI.Controls"
	Width="450"
    mc:Ignorable="d">

	<dialogs:ChameleonDialogControl
		TitleDescription="{Binding ScriptDescription.Parameters.Count, StringFormat='Script has {0} parameters:'}">
		<dialogs:ChameleonDialogControl.Content>
			<ListBox 
				ItemsSource="{Binding ScriptDescription.Parameters}"
				ScrollViewer.VerticalScrollBarVisibility="Auto"
				Margin="0 20"
				MaxHeight="300">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Margin="0 0 15 10">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<!--No Hard Coded Colors-->
							<TextBlock
								Grid.Row="0"
								Text="{Binding Name}"
								Foreground="#8094AE" 
								Padding="0 5"/>
							<TextBox
								Grid.Row="1"
								Text="{Binding Value, Mode=TwoWay}"
								ToolTip.Tip="{Binding Value}"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</dialogs:ChameleonDialogControl.Content>
	</dialogs:ChameleonDialogControl>

</UserControl>
