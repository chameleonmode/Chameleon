<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Chameleon.Avalonia.Controls.Settings.Functional.ViewModels"
			 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
			 x:DataType="vm:PhoneVerificationViewModel"
			 xmlns:local="using:Chameleon.Avalonia.Controls.Settings.Functional"
			 x:CompileBindings="False"
             x:Class="Chameleon.Avalonia.Controls.Settings.Functional.PVAUserControl">
	<afv:ChameleonContentControl Title="{Binding $parent.Title}"
								 TitleContent="{Binding $parent.TitleContent}"
								 Header="{Binding $parent.HeaderContentContent}"
								 Content="{Binding $parent.ContentContent}">
	</afv:ChameleonContentControl>
</UserControl>
