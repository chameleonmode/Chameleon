<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Chameleon.Avalonia.Controls.Settings.Functional.ViewModels"
			 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
             x:Class="Chameleon.Avalonia.Controls.Settings.Functional.Views.PhoneVerificationView">
	<Border Padding="20">
		<afv:ChameleonContentControl Title="SMS PVA"
									 TitleDescription="">
			<afv:ChameleonContentControl.TitleContent>
			</afv:ChameleonContentControl.TitleContent>
			
			<afv:ChameleonContentControl.Header>
				<Grid RowDefinitions="Auto,Auto">
					<TextBlock Margin="0 8 0 8"
							   Text="Enter your phone API Key"/>
					<Border Grid.Row="1">
						<StackPanel Orientation="Horizontal">
							<TextBox 
								Width="425"
								Text="{Binding ApiKey}"/>
							<Button
								Theme="{StaticResource AccentSymbleIconButton}"
								HorizontalAlignment="Left"
								Margin="10 0 0 0"
								Content="Save"
								Command="{Binding SaveCommand}" />
						</StackPanel>
					</Border>
				</Grid>
			</afv:ChameleonContentControl.Header>
			
			<afv:ChameleonContentControl.Content>
			</afv:ChameleonContentControl.Content>

			<afv:ChameleonContentControl.Footer>
			</afv:ChameleonContentControl.Footer>
		</afv:ChameleonContentControl>
	</Border>
</UserControl>
