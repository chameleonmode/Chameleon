{
  "name": "Chameleon",
  "description": "__MSG_extDescription__",
  "author": "ezexe@Chameleonmode",
  "version": "0.22.61.1",
  "version_name": "0.22.61",
  "manifest_version": 2,
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "ezexe@Chameleonmode",
      "strict_min_version": "68.0a1"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "<all_urls>",
    "alarms",
    "contextMenus",
    "notifications",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "privacy"
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'"
}