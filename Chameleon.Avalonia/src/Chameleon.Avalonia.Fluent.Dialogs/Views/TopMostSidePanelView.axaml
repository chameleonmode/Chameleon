<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:userProfiles="using:Chameleon.Avalonia.Controls.UserProfilesView"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chameleon.Av.Fluent.Dialogs.TopMostSidePanelView">
	<Panel>
		<ListBox VerticalAlignment="Top"
				 ItemsSource="{Binding ViewModels}"
				 Theme="{StaticResource ListBoxNoScroller}"
				 ItemContainerTheme="{StaticResource GridViewItem}">
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<UniformGrid Columns="1"/>
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<userProfiles:UserProfileView HorizontalAlignment="Stretch" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Panel>
</UserControl>
