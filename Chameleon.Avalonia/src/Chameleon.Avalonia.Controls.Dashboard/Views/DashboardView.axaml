<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="1101"  
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:converter="using:Chameleon.Common.ValueConverters"
             xmlns:userProfiles="using:Chameleon.Avalonia.Controls.UserProfilesView"
			 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
			 xmlns:vm="using:Chameleon.Avalonia.Controls.Dashboard.ViewModels"
			 x:DataType="vm:DashboardViewModel"
			 x:CompileBindings="True"
             x:Class="Chameleon.Avalonia.Controls.Dashboard.DashboardView">
	<UserControl.Resources>
		<converter:ListSortDirectionToNameConverter x:Key="ListSortDirectionToName"/>
	</UserControl.Resources>

	<ScrollViewer> 
		<StackPanel >
			<afv:PageHeaderControl 
				TextType="Dashboard" 
				Margin="12 12 12 0"
				Classes="smallest">
				<afv:PageHeaderControl.ContentObject>
					<Button Theme="{StaticResource SyncChangesButton}" Margin="6 -18 6 6"  />
				</afv:PageHeaderControl.ContentObject>
			</afv:PageHeaderControl>
			
			<Grid Margin="12 0 12 12">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="280*" />
					<RowDefinition Height="220*" />
				</Grid.RowDefinitions>
						<!--<breadcrumbsView:BreadcrumbsView DataContext="{Binding BreadcrumbsViewModel}"
														 VerticalAlignment="Center"
														 Margin="23 0 0 0" />-->
				<!--<Button Theme="{StaticResource SyncChangesButton}" />-->

				<!--<TextBox Grid.Row="1"
						 HorizontalAlignment="Center"
								 Margin="0 0 0 12"
								 Width="300"
								 Text="{Binding SearchText}" />-->
				
				<afv:ChameleonContentControl Grid.Row="2"
												   Title="Favorite Profiles"
										TitleDescription="{Binding ViewModels.Count,
											StringFormat='You have {0} favorited profiles.'}">
					<afv:ChameleonContentControl.Options>
						<ui:FAComboBox Header="Sort by:"
									   HorizontalAlignment="Right"
									   ItemsSource="{Binding Sorts}"
									   SelectedItem="{Binding SortSelected}"
									   Width="150"
									   IsEditable="False"/>
					</afv:ChameleonContentControl.Options>

					<afv:ChameleonContentControl.Content>
						<Panel>
							<ListBox Name="lbProfiles"
								IsVisible="{Binding !HasNoItems}"
								ItemsSource="{Binding ViewModels}"
								Theme="{StaticResource ListBoxNoScroller}"
								ItemContainerTheme="{StaticResource GridViewItem}">
								<ListBox.ItemsPanel>
									<ItemsPanelTemplate>
										<UniformGrid Columns="1"/>
									</ItemsPanelTemplate>
								</ListBox.ItemsPanel>
								<ListBox.ItemTemplate>
									<DataTemplate>
										<userProfiles:UserProfileView HorizontalAlignment="Stretch" />
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>

							<StackPanel
								IsVisible="{Binding HasNoItems}"
								Height="280"
								HorizontalAlignment="Center"
								VerticalAlignment="Center">
								<StackPanel IsVisible="{Binding NoSearchResultsInFavorite}">
									<afv:SvgIconControl IconName="not-profiles"
													  Height="102"
													  Width="97"/>

									<TextBlock Margin="0 25 0 0"
											   Text="No favorite profiles selected yet"
											   Theme="{StaticResource SubtitleTextBlockStyle}" />
								</StackPanel>

								<TextBlock Margin="0 25 0 0"
										   Text="Profiles not found"
										   Theme="{StaticResource SubtitleTextBlockStyle}"
										   IsVisible="{Binding !NoSearchResultsInFavorite}" />
							</StackPanel>
						</Panel>
					</afv:ChameleonContentControl.Content>
				</afv:ChameleonContentControl>

				<afv:ChameleonContentControl Grid.Row="3"
											 Title="Favorite Folders"
											 TitleDescription="{Binding FoldersCount,
											StringFormat='You have {0} favorited folders.'}">
					<afv:ChameleonContentControl.Options>
						<ui:FAComboBox Header="Sort by:"
									   HorizontalAlignment="Right"
									   ItemsSource="{Binding Sorts}"
									   SelectedItem="{Binding FolderSortSelected}"
									   Width="150"
									   IsEditable="False"/>
					</afv:ChameleonContentControl.Options>

					<afv:ChameleonContentControl.Content>
						<Panel>
							<ListBox
								ItemsSource="{Binding FolderViewModels}"
								Theme="{StaticResource ListBoxNoScroller}"
								ItemContainerTheme="{StaticResource GridViewItem}"
								Grid.Row="1"
								IsVisible="{Binding !HasNoFolderItems}">
								<ListBox.ItemsPanel>
									<ItemsPanelTemplate>
										<UniformGrid Columns="2"/>
									</ItemsPanelTemplate>
								</ListBox.ItemsPanel>
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid ColumnDefinitions="Auto,Auto,*,Auto">
												<Viewbox Width="30"
														 Height="30"
														 Margin="12 8"
														 VerticalAlignment="Center"
														 Name="IconHost">
													<Path
														Data="M3.15 1.83333C2.79196 1.83333 2.44858 1.9782 2.19541 2.23606C1.94223 2.49392 1.8 2.84366 1.8 3.20833V6.41667H25.2V5.04167C25.2 4.67699 25.0578 4.32726 24.8046 4.06939C24.5514 3.81153 24.208 3.66667 23.85 3.66667H11.4812C10.8593 3.66665 10.2512 3.47912 9.73377 3.12771C9.73375 3.1277 9.73372 3.12768 9.7337 3.12767L8.1677 2.06433C7.94594 1.91372 7.68536 1.83335 7.41881 1.83333C7.4188 1.83333 7.41882 1.83333 7.41881 1.83333H3.15ZM25.2 8.25H1.8V18.7917C1.8 19.1563 1.94223 19.5061 2.19541 19.7639C2.44858 20.0218 2.79196 20.1667 3.15 20.1667H23.85C24.208 20.1667 24.5514 20.0218 24.8046 19.7639C25.0578 19.5061 25.2 19.1563 25.2 18.7917V8.25ZM0 18.7917C0 19.6426 0.331874 20.4586 0.922614 21.0603C1.51335 21.662 2.31457 22 3.15 22H23.85C24.6854 22 25.4866 21.662 26.0774 21.0603C26.6681 20.4586 27 19.6426 27 18.7917V5.04167C27 4.19076 26.6681 3.37471 26.0774 2.77303C25.4866 2.17135 24.6854 1.83333 23.85 1.83333H11.4812C11.4812 1.83333 11.4812 1.83333 11.4812 1.83333C11.2147 1.83332 10.9541 1.75294 10.7323 1.60233L9.1663 0.539C9.16628 0.538985 9.16625 0.538969 9.16623 0.538954C8.64878 0.187546 8.04077 1.62274e-05 7.41884 0H3.15C2.31457 0 1.51335 0.33802 0.922614 0.939699C0.331874 1.54138 0 2.35743 0 3.20833V18.7917Z"
														Fill="{StaticResource AccentFillColorDefaultBrush}" />
												</Viewbox>

												<StackPanel Grid.Column="1"
															Margin="12 6"
															Spacing="4">
													<TextBlock Text="{Binding Title}"
															   Theme="{StaticResource BodyStrongTextBlockStyle}"/>
													<TextBlock Theme="{StaticResource CaptionTextBlockStyle}">
														<Run Text="{Binding ProfilesCount}" />
														<Run Text=" profiles" />
													</TextBlock>
												</StackPanel>



												<StackPanel Grid.Column="3"
													Margin="12 0"
													Orientation="Horizontal"
													Grid.Row="1"
													Grid.ColumnSpan="3"
													HorizontalAlignment="Right">
													<Button
														Content="View"
														Theme="{StaticResource TransparentButton}"
														Command="{Binding ViewGroupCommand}" />
													<Button Grid.Column="2"
															VerticalAlignment="Top"
															Margin="5"
															Command="{Binding SetFavoriteFolderCommand}"
															Theme="{StaticResource FavoriteButton}"/>
												</StackPanel>
											</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>


							<StackPanel IsVisible="{Binding HasNoFolderItems}"
										Orientation="Vertical"
										HorizontalAlignment="Center"
										VerticalAlignment="Center">
								
								<StackPanel IsVisible="{Binding NoSearchResultsInFavorite}">
									<afv:SvgIconControl  IconName="not-profiles"
													   Height="102"
													   Width="97" />

									<TextBlock Margin="0 25 0 0"
											   Text="No favorite folders selected yet"
										   Theme="{StaticResource SubtitleTextBlockStyle}" />
								</StackPanel>

								<TextBlock Margin="0 25 0 0"
										   Text="Folders not found"
										   Theme="{StaticResource SubtitleTextBlockStyle}"
										   IsVisible="{Binding !NoSearchResultsInFavorite}" />
							</StackPanel>
						</Panel>
					</afv:ChameleonContentControl.Content>
				</afv:ChameleonContentControl>


			</Grid>			
		</StackPanel>
	</ScrollViewer>
</UserControl>
