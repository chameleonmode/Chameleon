<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:converter="using:Chameleon.Common.ValueConverters"
             xmlns:userProfiles="using:Chameleon.Avalonia.Controls.UserProfilesView"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chameleon.Avalonia.Controls.Dashboard.DashboardView">
	<UserControl.Resources>
		<converter:ListSortDirectionToNameConverter x:Key="ListSortDirectionToNameConverter"/>
		<!--BorderBrush="{StaticResource InsertProfilesLine}"-->
		<DataTemplate x:Key="DashbordProfilesListViewTemplate">
			<Border x:Name="Border"
                    BorderThickness="0 1 0 0"
                    Height="56"
                    >
				<userProfiles:UserProfileView />
			</Border>

			<!--<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}"
                             Value="{x:Null}">
					<Setter TargetName="Border"
                            Property="BorderThickness"
                            Value="0" />
				</DataTrigger>

			</DataTemplate.Triggers>-->
		</DataTemplate>

				<Style Selector="TextBlock.ProfileCountSubtext"
			   x:Key="ProfileCountSubtext">
			<Setter Property="FontWeight"
					Value="Normal" />
			<Setter Property="FontSize"
					Value="12" />
			<Setter Property="FontFamily"
					Value="Open Sans" />
			<!--<Setter Property="Foreground"
					Value="{StaticResource SecondaryText}" />-->
		</Style>

		<Style Selector="TextBlock.ProfileCount"
			   x:Key="ProfileCount">
			<Setter Property="FontWeight"
					Value="Normal" />
			<Setter Property="FontSize"
					Value="12" />
			<Setter Property="FontFamily"
					Value="Open Sans" />
			<!--<Setter Property="Foreground"
					Value="{StaticResource FolderProfiles}" />-->
		</Style>

		<Style Selector="Border.MainBorderStyle"
	   x:Key="MainBorderStyle">
			<Setter Property="CornerRadius"
					Value="4" />
			<Setter Property="BorderThickness"
					Value="1" />
			<!--<Setter Property="Background"
					Value="{StaticResource White}" />
			<Setter Property="BorderBrush"
					Value="{StaticResource DividerLine}" />-->
		</Style>

		<!--Virtualised ItemsControl-->
	</UserControl.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="280*" />
			<RowDefinition Height="220*" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="404" />
		</Grid.ColumnDefinitions>
<!--BorderBrush="{StaticResource DividerLine}"-->
		<Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                
                BorderThickness="1"
			    Height="60"
				IsVisible="{Binding IsSyncChangesBtnVisible}">
			<Grid>   <!--Foreground="{StaticResource ButtonDarkBrush}"-->
				<Button Width="153"
                        Height="40"
                        Margin="0 0 24 0"
                        Background="Transparent"
                     
                        BorderThickness="0"
                        Command="{Binding SyncChangesCommand}"
                        HorizontalAlignment="Right">
					<StackPanel Orientation="Horizontal">
						<!--<svgIcons:SvgIconView IconName="sync"
                                              Foreground="{StaticResource ButtonDarkBrush}"
                                              Width="14.25"
                                              Height="17.43"
                                              VerticalAlignment="Center"
                                              Margin="0 0 10 0" />-->
						<TextBlock VerticalAlignment="Center"
                                   Margin="0"
                                   Text="Sync changes"
                                   FontWeight="DemiBold"
                                   FontFamily="Open Sans"
                                   FontSize="14" />
					</StackPanel>
				</Button>
			</Grid>
		</Border>
<!--BorderBrush="{StaticResource DividerLine}"-->
		<Border Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="1"
                
                BorderThickness="1 0 0 0">
			<!--<taskForseView:TaskForceView />-->
		</Border>
<!--Background="{StaticResource BackGroundGreyColor}"-->
		<Grid Grid.Row="1"
              >
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0"
                        Grid.Column="0"
                        Margin="0 16 24 0">
				<!--<TextBox Margin="0 0 0 12"
                         Background="White"
                         BorderThickness="1"
                         Width="300"
                         Padding="10 5 10 5"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         materialDesign:HintAssist.Hint="Search"
                         materialDesign:HintAssist.IsFloating="False"
                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Search"
                         materialDesign:TextFieldAssist.LeadingIconSize="15"
                         materialDesign:TextFieldAssist.TextFieldCornerRadius="4"
                         Text="{Binding SearchText, Mode=OneWayToSource}"
                         BorderBrush="{StaticResource BorderOutlineButton}" />-->

				<TextBlock Margin="24 0 0 0"
                           FontFamily="Open Sans"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Text="Favorite profiles"
                           IsVisible="{Binding NoSearchResultsInFavorite}" />

				<TextBlock Margin="24 0 0 0"
                           FontFamily="Open Sans"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Text="Profiles"
                           IsVisible="{Binding !NoSearchResultsInFavorite}"/>

				<Grid Margin="0 8 0 0"
                      IsVisible="{Binding !HasNoItems}">
					<StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="24 0 0 16">
						<TextBlock Classes="ProfileCountSubtext"
                                   VerticalAlignment="Bottom"
                                   Text="You have " />

						<TextBlock Classes="ProfileCount"
								   VerticalAlignment="Bottom"
                                   Text="{Binding ViewModels.Count}" />

						<TextBlock Classes="ProfileCountSubtext"
                                   VerticalAlignment="Bottom"
                                   Text=" favorite profiles"
                                   IsVisible="{Binding NoSearchResultsInFavorite}" />

						<TextBlock Classes="ProfileCountSubtext"
                                   VerticalAlignment="Bottom"
                                   Text=" profiles"
                                   IsVisible="{Binding !NoSearchResultsInFavorite}" />
					</StackPanel>

					<StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
						<TextBlock Classes="ProfileCountSubtext"
                                   VerticalAlignment="Bottom"
                                   Text="Sort by:"
                                   FontWeight="DemiBold"
                                   Margin="0 0 0 16" />
<!--materialDesign:HintAssist.Foreground="Transparent"--><!--Foreground="{StaticResource SecondaryText}"-->
						<ComboBox ItemsSource="{Binding Sorts}"
                                  Padding="0"
                                  Margin="6 0 0 16"
                                  Height="14"
                                  VerticalAlignment="Bottom"
                                  SelectedItem="{Binding SortSelected}"
                                  
                                  BorderThickness="0"
                                  FontFamily="Open Sans"
                                  FontStyle="Normal"
                                  FontSize="12"
                                  
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
							<ComboBox.ItemTemplate>
								<!--Foreground="{StaticResource MainBlack}"-->
								<DataTemplate>
									<Label Margin="0"
                                           Content="{Binding Converter={StaticResource ListSortDirectionToNameConverter}}"
                                           
                                           FontFamily="Open Sans"
                                           FontWeight="DemiBold"
                                           FontSize="12"
                                           Padding="0" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</StackPanel>
				</Grid>
			</StackPanel>
<!--BorderBrush="{StaticResource InsertProfilesLine}"-->
			<Grid Grid.Row="1"
                  Grid.Column="0"
                  Margin="24 0 24 24">
				<Border CornerRadius="4"
                        
                        BorderThickness="1"
                        IsVisible="{Binding !HasNoItems}"
                        VerticalAlignment="Top">
					<!--Classes="ItemsControlVirtualizedStyle"-->
					<ItemsControl x:Name="itemsList"
                                  ItemsSource="{Binding ViewModels}"
                                  ItemTemplate="{StaticResource DashbordProfilesListViewTemplate}"
                                  VerticalAlignment="Top"
                                  Background="White"
                                   />
				</Border>
			</Grid>

			<Grid Grid.Row="2"
                  Grid.Column="0"
                  IsVisible="{Binding HasNoItems}"
                  Height="280">
				<StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

					<StackPanel IsVisible="{Binding NoSearchResultsInFavorite}">
						<!--<svgIcons:SvgView IconName="not-profiles"
                                          Height="102"
                                          Width="97"
                                          Foreground="{StaticResource SecondaryText}" />-->
<!--Foreground="{StaticResource SecondaryText}"-->
						<TextBlock Margin="0 25 0 0"
                                   Text="No favorite profiles selected yet"
                                   FontSize="18"
                                   FontFamily="Open Sans"
                                   FontWeight="DemiBold"
                                   HorizontalAlignment="Center"
                                    />
					</StackPanel>
<!--Foreground="{StaticResource SecondaryText}"-->
					<TextBlock Margin="0 25 0 0"
                               Text="Profiles not found"
                               FontSize="18"
                               FontFamily="Open Sans"
                               FontWeight="DemiBold"
                               HorizontalAlignment="Center"
                               
                               IsVisible="{Binding !NoSearchResultsInFavorite}" />
				</StackPanel>
			</Grid>

			<!--<wait:WaitIndicatorView Grid.Row="2"
                                    Grid.RowSpan="2"
                                    DataContext="{Binding}"
                                    IsIndicatorVisible="{Binding IsWaiting}" />-->
		</Grid><!--Background="{StaticResource BackGroundGreyColor}"-->
		<Grid Grid.Row="2"
              >
			<Grid Margin="24 0 24 0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
<!--Foreground="{StaticResource MainBlack}"-->
				<TextBlock Text="Favorite folders"
                           FontFamily="Open Sans"
                           FontWeight="Bold"
                           FontSize="16"
                           
                           IsVisible="{Binding NoSearchResultsInFavorite}" /><!--Foreground="{StaticResource MainBlack}"-->
				<TextBlock Text="Folders"
                           FontFamily="Open Sans"
                           FontWeight="Bold"
                           FontSize="16"
                           
                           IsVisible="{Binding !NoSearchResultsInFavorite}" />
				<StackPanel Grid.Row="1"
                           IsVisible="{Binding !HasNoFolderItems}"

                           Margin="0 8 0 8">
					<TextBlock Classes="ProfileCountSubtext"
                               VerticalAlignment="Bottom"
                               Text="You have" />

					<TextBlock Classes="ProfileCount"
                               VerticalAlignment="Bottom"
                               Text="{Binding FoldersCount}" />

					<TextBlock  Classes="ProfileCountSubtext"
                                VerticalAlignment="Bottom"
                                Text="favorite folders"
                                IsVisible="{Binding NoSearchResultsInFavorite}" />

					<TextBlock  Classes="ProfileCountSubtext"
                                VerticalAlignment="Bottom"
                                Text="folders"
                                IsVisible="{Binding !NoSearchResultsInFavorite}" />
				</StackPanel>
				<StackPanel Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            IsVisible="{Binding !HasNoFolderItems}">
					<TextBlock Classes="ProfileCountSubtext"
                               VerticalAlignment="Bottom"
                               Text="Sort by:"
                               FontWeight="DemiBold"
                               Margin="0 0 0 16" />
					<!--materialDesign:HintAssist.Foreground="Transparent"--><!--Foreground="{StaticResource SecondaryText}"-->
					<ComboBox ItemsSource="{Binding Sorts}"
                              Padding="0"
                              Margin="6 0 0 16"
                              Height="14"
                              Cursor="Hand"
                              VerticalAlignment="Bottom"
                              SelectedItem="{Binding FolderSortSelected}"
                              
                              BorderThickness="0"
                              FontFamily="Open Sans"
                              FontStyle="Normal"
                              FontSize="12"
                              
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ComboBox.ItemTemplate>
							<DataTemplate><!--Foreground="{StaticResource MainBlack}"-->
								<Label Margin="0"
                                       Content="{Binding Converter={StaticResource ListSortDirectionToNameConverter}}"
                                       
                                       FontFamily="Open Sans"
                                       FontWeight="DemiBold"
                                       FontSize="12"
                                       Padding="0"
                                       Cursor="Hand" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>
				<ScrollViewer Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding !HasNoFolderItems}">
					<ItemsControl ItemsSource="{Binding FolderViewModels}"
                                  Margin="-8 0 -8 0">
						<!--<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid IsItemsHost="True"
                                             Columns="2"
                                             Margin="0"
                                             VerticalAlignment="Top" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>-->
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Classes="MainBorderStyle"
                                        MinWidth="300"
                                        HorizontalAlignment="Stretch"
                                        Height="73"
                                        Margin="8">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<Canvas Grid.Column="0"
                                                Height="22"
                                                Width="27"
                                                Margin="20 0 24 0">
											<Path Data="M3.15 1.83333C2.79196 1.83333 2.44858 1.9782 2.19541 2.23606C1.94223 2.49392 1.8 2.84366 1.8 3.20833V6.41667H25.2V5.04167C25.2 4.67699 25.0578 4.32726 24.8046 4.06939C24.5514 3.81153 24.208 3.66667 23.85 3.66667H11.4812C10.8593 3.66665 10.2512 3.47912 9.73377 3.12771C9.73375 3.1277 9.73372 3.12768 9.7337 3.12767L8.1677 2.06433C7.94594 1.91372 7.68536 1.83335 7.41881 1.83333C7.4188 1.83333 7.41882 1.83333 7.41881 1.83333H3.15ZM25.2 8.25H1.8V18.7917C1.8 19.1563 1.94223 19.5061 2.19541 19.7639C2.44858 20.0218 2.79196 20.1667 3.15 20.1667H23.85C24.208 20.1667 24.5514 20.0218 24.8046 19.7639C25.0578 19.5061 25.2 19.1563 25.2 18.7917V8.25ZM0 18.7917C0 19.6426 0.331874 20.4586 0.922614 21.0603C1.51335 21.662 2.31457 22 3.15 22H23.85C24.6854 22 25.4866 21.662 26.0774 21.0603C26.6681 20.4586 27 19.6426 27 18.7917V5.04167C27 4.19076 26.6681 3.37471 26.0774 2.77303C25.4866 2.17135 24.6854 1.83333 23.85 1.83333H11.4812C11.4812 1.83333 11.4812 1.83333 11.4812 1.83333C11.2147 1.83332 10.9541 1.75294 10.7323 1.60233L9.1663 0.539C9.16628 0.538985 9.16625 0.538969 9.16623 0.538954C8.64878 0.187546 8.04077 1.62274e-05 7.41884 0H3.15C2.31457 0 1.51335 0.33802 0.922614 0.939699C0.331874 1.54138 0 2.35743 0 3.20833V18.7917Z"
                                                  Fill="#8094AE" />
										</Canvas>
										<StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"><!--Foreground="{StaticResource MainBlack}"-->
											<TextBlock Text="{Binding Title}"
                                                       FontFamily="Open Sans"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                        />
											<StackPanel Orientation="Horizontal"
                                                        Margin="0 6 0 0"><!--Foreground="{StaticResource SecondaryText}"-->
												<TextBlock Text="{Binding ProfilesCount}"
                                                           FontSize="14"
                                                           FontWeight="Normal"
                                                           FontFamily="Open Sans"
                                                            /><!--Foreground="{StaticResource SecondaryText}"-->
												<TextBlock Text=" profiles"
                                                           FontSize="14"
                                                           FontWeight="Normal"
                                                           FontFamily="Open Sans"
                                                            />
											</StackPanel>
										</StackPanel>
										<!--Style="{StaticResource OutlinedButton}"-->
										<Button Grid.Column="2"
                                                Content="View group"
                                                Width="80"
                                                Height="32"
                                                Command="{Binding ViewGroupCommand}" />
										<!--Style="{StaticResource SvgButton}"-->
										<Button Grid.Column="3"
                                                Width="34"
                                                Height="34"
                                                Margin="5 0"
                                                Command="{Binding SetFavoriteFolderCommand}">
											<Grid>
												<StackPanel IsVisible="{Binding !IsFavorite}">
													<!--<svgIcons:SvgView  IconName="not-favorites"
                                                                       Width="15"
                                                                       Height="15" />-->
												</StackPanel>
												<StackPanel IsVisible="{Binding IsFavorite}">
													<!--<svgIcons:SvgIconView IconName="in-favorites"
                                                                          Width="14"
                                                                          Height="14" />-->
												</StackPanel>
											</Grid>
										</Button>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Grid>
		<Grid Grid.Row="2"
              IsVisible="{Binding HasNoFolderItems}">
			<StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
				<StackPanel IsVisible="{Binding NoSearchResultsInFavorite}">
					<!--<svgIcons:SvgView  IconName="not-profiles"
                                       Height="102"
                                       Width="97"
                                       Foreground="{StaticResource SecondaryText}" />-->
					<!--Foreground="{StaticResource SecondaryText}"-->
					<TextBlock Margin="0 25 0 0"
                               Text="No favorite folders selected yet"
                               FontSize="18"
                               FontFamily="Open Sans"
                               FontWeight="DemiBold"
                               HorizontalAlignment="Center"
                            />
				</StackPanel>
<!--Foreground="{StaticResource SecondaryText}"-->
				<TextBlock Margin="0 25 0 0"
                           Text="Folders not found"
                           FontSize="18"
                           FontFamily="Open Sans"
                           FontWeight="DemiBold"
                           HorizontalAlignment="Center"
                           
                           IsVisible="{Binding !NoSearchResultsInFavorite}" />
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
