<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:avCommon="using:Chameleon.Avalonia.Common"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:avfCommon="using:Chameleon.Av.Fluent.Common.Controls"
             mc:Ignorable="d" 
             x:Class="Chameleon.Avalonia.Controls.UserProfilesView.UserProfileView">
	<Border Theme="{StaticResource MainBorderStyle}"
											Height="56"
											Padding="6"
											Margin="6 0 6 6">
		<Grid ColumnDefinitions="Auto,*,Auto">
			<StackPanel Orientation="Horizontal"
						Spacing="6">
				<CheckBox Margin="6 0 -12 0" IsChecked="{Binding IsSelected}"
						  IsVisible="{Binding IsShowCheckboxColumn}"
						  IsEnabled="{Binding IsEnabledCheckboxColumn}">
				</CheckBox>

				<Grid Width="28"
					  Height="28"
					  VerticalAlignment="Center">
					<Ellipse Fill="{StaticResource AccentFillColorDefaultBrush}"
							 Stroke="{StaticResource FocusStrokeColorOuterBrush}">
					</Ellipse>
					<TextBlock Text="{Binding Code}"
							   VerticalAlignment="Center"
							   HorizontalAlignment="Center"
							   Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
							   FontSize="11"
							   FontWeight="Bold"
							   FontFamily="Open Sans" />

					<Grid IsVisible="{Binding IsSharedProfile}"
						  Width="10"
						  Height="10"
						  Margin="0 0 1 0"
						  VerticalAlignment="Bottom" HorizontalAlignment="Right">

						<Ellipse Fill="{StaticResource AccentFillColorTertiaryBrush}"/>

						<!--<materialDesign:PackIcon Kind="ShareVariant"
                                         Width="8" Height="8"
                                         Margin="0 0 1 0"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                         Foreground="{StaticResource AccentFillColorDefaultBrush}" />-->
					</Grid>
				</Grid>
			</StackPanel>

			<TextBlock Grid.Column="1" 
					   Margin="6 0 0 0"
					   HorizontalAlignment="Left"
					   Text="{Binding Title, FallbackValue=Cannot find name}"
					   VerticalAlignment="Center"
					   ToolTip.Tip="{Binding SubTitle}"
					   Theme="{StaticResource BodyStrongTextBlockStyle}">
			</TextBlock>

			<StackPanel Grid.Column="2"
						Spacing="6"
						Orientation="Horizontal">
				<StackPanel Orientation="Horizontal"
							IsVisible="{Binding HasMultiOptions}"
							Spacing="6">
					<Button Content="chrome"
							ToolTip.Tip="Open In System Chrome"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenChromeCommand}"/>
					<Button Content="firefox"
							ToolTip.Tip="Open In System Firefox"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenFirefoxCommand}"/>
					<Button Content="brave"
							ToolTip.Tip="Open In System Brave"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenBraveCommand}"/>
					<Button Content="chameleon-logo"
							ToolTip.Tip="Open In Chameleon Browser"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenBrowserCommand}"/>

					<Border BorderBrush="{StaticResource DividerStrokeColorDefaultBrush}"
							BorderThickness="1 0 0 0" />

					<Button ToolTip.Tip="Open copy-paste window"
							Command="{Binding ShowViewProfileCommand}">
						<ui:SymbolIcon Symbol="ClipboardCode" FontSize="20" />
					</Button>
				</StackPanel>

				<Button Content="three-dots"
						Background="{StaticResource ControlFillColorDefaultBrush}"
						Theme="{StaticResource SvgIconButton}"
						ToolTip.Tip="Details"
						Command="{Binding OpenMenuCommand}">
					<Button.Flyout>
						<ui:FAMenuFlyout Placement="Bottom">
							<ui:MenuFlyoutItem Text="View profile"
											   IconSource="Contact"
											   Command="{Binding OpenUserProfileCommand}"/>
							<ui:MenuFlyoutItem Text="Delete"
											   IconSource="Delete"
											   IsVisible="{Binding IsDeleteProfileBtnVisible}"
											   Command="{Binding DeleteUserProfile}" />
						</ui:FAMenuFlyout>
					</Button.Flyout>
				</Button>


				<Button Theme="{StaticResource FavoriteButton}"/>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
