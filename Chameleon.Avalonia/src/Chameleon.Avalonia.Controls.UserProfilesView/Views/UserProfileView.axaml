<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
			 xmlns:conv="using:Chameleon.Avalonia.Common.Converters.ValueConverters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:avCommon="using:Chameleon.Avalonia.Common"
			 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
             mc:Ignorable="d"
             x:Class="Chameleon.Avalonia.Controls.UserProfilesView.UserProfileView"
			 xmlns:vm="using:Chameleon.Avalonia.Controls.UserProfilesView.ViewModels"
			 x:DataType="vm:UserProfileViewModel"
			 x:CompileBindings="True">
	<UserControl.Resources>
		<conv:IsActiveBackgroundConverter x:Key="activebgConv" />

	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector=":is(Button)[Tag=True]">
			<Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
		</Style>
		<Style Selector=":is(Border)[Tag=True]">
			<Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
		</Style>
		<Style Selector=":is(Border)[Tag=False]">
			<Setter Property="Background" Value="Transparent" />
		</Style>
	</UserControl.Styles>

	<Border Tag="{Binding IsForeground}" 
			ToolTip.Tip="{Binding Title, FallbackValue=Cannot find name}"
			Padding="6">
		<Grid ColumnDefinitions="Auto,Auto,*,Auto">
			<StackPanel Grid.Column="0"
						Orientation="Horizontal">

				<CheckBox Margin="6 0 -6 0"
						  IsChecked="{Binding IsSelected}"
							  IsVisible="{Binding IsShowCheckboxColumn}"
							  IsEnabled="{Binding IsEnabledCheckboxColumn}">
				</CheckBox>


				<Viewbox Width="30"
						Height="30"
						Margin="0 0 0 0"
						Name="IconHost"
						 Tag="{Binding UserProfile}">
					<Grid Width="30"
						  Height="30"
						  VerticalAlignment="Center">
						<Border Background="{StaticResource AccentFillColorDefaultBrush}"
								 BorderBrush="{StaticResource ControlStrokeColorOnAccentDefaultBrush}"
								CornerRadius="180"
								BorderThickness="1">

							<TextBlock Text="{Binding Code,FallbackValue=E}"
									   Margin="0 -1 0 0"
									   Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
									   VerticalAlignment="Center"
									   HorizontalAlignment="Center"
									   Theme="{StaticResource BodyStrongTextBlockStyle}"/>
						</Border>

						<Grid IsVisible="{Binding IsSharedProfile}"
							  Width="10"
							  Height="10"
							  VerticalAlignment="Bottom"
							  HorizontalAlignment="Right">

							<Ellipse Fill="{StaticResource ControlOnImageFillColorDefaultBrush}"/>

							<ui:SymbolIcon Symbol="Share" FontSize="8" />
						</Grid>
					</Grid>
				</Viewbox>
			</StackPanel>

			<TextBlock Grid.Column="1"
					   IsVisible="{Binding IsShowGlyph}"
					   Margin="12 0 0 0"
					   HorizontalAlignment="Left"
					   Text="{Binding Title, FallbackValue=Cannot find name}"
					   VerticalAlignment="Center"
					   ToolTip.Tip="{Binding SubTitle}"
					   Theme="{StaticResource BodyStrongTextBlockStyle}">
			</TextBlock>



			<UniformGrid Grid.Column="3"
						 HorizontalAlignment="Right"
						 Rows="1">
				<Button
					Content="chrome"
					ToolTip.Tip="Open In System Chrome"
					Tag="{Binding IsChromeRunning}"
					Command="{Binding OpenChromeCommand}"
					Theme="{StaticResource SvgIconButton}" />
				<Button
					Content="firefox"
					ToolTip.Tip="Open In System Firefox"
					Tag="{Binding IsFFRunning}"
					Command="{Binding OpenFirefoxCommand}"
					Theme="{StaticResource SvgIconButton}" />
				<Button 
					Content="brave"
					ToolTip.Tip="Open In System Brave"
					Tag="{Binding IsBraveRunning}"
					Command="{Binding OpenBraveCommand}"
					Theme="{StaticResource SvgIconButton}"/>

				<Button 
					Content="chameleon-logo"
					IsVisible="{Binding IsShowC}"
					ToolTip.Tip="Open In Chameleon Browser"
					Theme="{StaticResource SvgIconButton}"
					Command="{Binding OpenUserBrowserCommand}"/>
				<!--Command="{Binding OpenBrowserCommand}"-->

				<!--<Border BorderBrush="{StaticResource DividerStrokeColorDefaultBrush}"  
							BorderThickness="1 0 0 0" />
							IsVisible="{Binding HasMultiOptions}"-->

				<Button Content="copy"
						ToolTip.Tip="Open copy-paste window"
						Theme="{StaticResource SvgIconButton}"
						Command="{Binding ShowViewProfileCommand}"/>

				<Button Content="three-dots"
					IsVisible="{Binding IsShowD}"
						ToolTip.Tip="Details"
						Theme="{StaticResource SvgIconButton}">
					<Button.Flyout>
						<ui:FAMenuFlyout Placement="Bottom">
							<!--<ui:MenuFlyoutItem Text="View profile"
											   IconSource="Contact"
											   Command="{Binding OpenUserProfileCommand}"/>-->
							<ui:MenuFlyoutItem Text="Delete"
											   IconSource="Delete"
											   IsVisible="{Binding IsDeleteProfileBtnVisible}"
											   Command="{Binding DeleteUserProfileCommand}" />
						</ui:FAMenuFlyout>
					</Button.Flyout>
				</Button>

				<Button Grid.Column="3"
					IsVisible="{Binding IsShowF}"
						Theme="{StaticResource FavoriteButton}"
						Command="{Binding FavoriteCommand}"/>
			</UniformGrid>
		</Grid>
	</Border>
</UserControl>
