<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:avfCommon="using:Chameleon.Av.Fluent.Common.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:userProfiles="using:Chameleon.Avalonia.Controls.UserProfilesView"
			 xmlns:pagnator="using:Chameleon.Avalonia.Controls.Paginator"
			 xmlns:converter="using:Chameleon.Common.ValueConverters"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="Chameleon.Avalonia.Controls.UserProfilesView.UserProfilesView">
	<UserControl.Resources>
		<converter:ListSortDirectionToNameConverter x:Key="ListSortDirectionToName"/>
	</UserControl.Resources>
	<avfCommon:ChameleonContentControl Title="{Binding SelectedFolderTitle}"
										TitleDescription="{Binding TotalCount,
											StringFormat='You have {0} profiles.'}">
		<avfCommon:ChameleonContentControl.TitleContent>
			<Grid ColumnDefinitions="*,Auto">
				<TextBox HorizontalAlignment="Center"
						 Margin="0 0 0 12"
						 Width="300"
						 Text="{Binding SearchText}" />
				<StackPanel
					Grid.Column="1"
					Orientation="Horizontal">
					<Grid
						Width="20"
						Height="16">
						<ui:SymbolIcon
							Symbol="Share"
							IsVisible="{Binding IsSharedFolder}" />
					</Grid>
					<Button
						Margin="0 0 12 0"
						Command="{Binding SetFavoriteCommand}"
						Theme="{StaticResource FavoriteButton}"/>

				</StackPanel>
			</Grid>
		</avfCommon:ChameleonContentControl.TitleContent>

		<avfCommon:ChameleonContentControl.Header>
			<Grid Margin="0 8 0 0"
				  IsVisible="{Binding !HasNoItems}">
				<StackPanel Orientation="Horizontal">
					<Button Content="select-all"
							Tag="Select all"
							Theme="{StaticResource SvgIconTextButton}"
							Command="{Binding SelectAllCommand}" />
					<StackPanel
						Orientation="Horizontal"
						Margin="2 0 0 0">
						<StackPanel.IsVisible>
							<MultiBinding  Converter="{x:Static BoolConverters.Or}">
								<Binding Path="HasFolder"/>
								<Binding Path="IsProfilesExist"/>
							</MultiBinding>
						</StackPanel.IsVisible>
						<Button Content="plus-in-circle"
								Tag="Add profile"
								Theme="{StaticResource SvgIconTextButton}"
								Command="{Binding AddProfilesToFolderCommand}"
								IsEnabled="{Binding IsAddProfilesToFolderCommandEnabled}" />
						<Button Content="minus-in-circle"
								Tag="Remove profile"
								Theme="{StaticResource SvgIconTextButton}"
								Margin="4 0 0 0"
								Command="{Binding RemoveProfilesFromFolderCommand}" />
					</StackPanel>
				</StackPanel>

				<StackPanel HorizontalAlignment="Right"
							Orientation="Horizontal"
							IsVisible="{Binding IsProfilesExist}">
					<TextBlock Text="Sort by:"
							   VerticalAlignment="Bottom"
							   FontWeight="DemiBold"
							   Margin="0 0 6 10"/>
					<ComboBox ItemsSource="{Binding Sorts}"
							  VerticalAlignment="Bottom"
							  SelectedItem="{Binding SortSelected}"
							  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock
									Text="{Binding Converter={StaticResource ListSortDirectionToName}}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>
			</Grid>
		</avfCommon:ChameleonContentControl.Header>

		<avfCommon:ChameleonContentControl.Options>
		</avfCommon:ChameleonContentControl.Options>

		<avfCommon:ChameleonContentControl.Content>
			<Grid>
				<ItemsControl ItemsSource="{Binding ViewModels}">
					<ItemsControl.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.And}">
							<Binding Path="!HasNoItems"/>
							<Binding Path="IsProfilesExist"/>
						</MultiBinding>
					</ItemsControl.IsVisible>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<userProfiles:UserProfileView HorizontalAlignment="Stretch" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<Grid>
					<Grid.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.Or}">
							<Binding Path="HasNoItems" />
							<Binding Path="!IsProfilesExist"/>
						</MultiBinding>
					</Grid.IsVisible>
					<Border
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
						<TextBlock
							Grid.Row="2"
							Margin="0 25 0 0"
							Text="Profiles not found"
							Theme="{StaticResource SubtitleTextBlockStyle}"
							HorizontalAlignment="Center"
							IsVisible="{Binding !IsProfilesExist}"/>
					</Border>
					<StackPanel
						Orientation="Vertical"
						HorizontalAlignment="Center"
						Margin="0 140 0 0">
						<avfCommon:SvgIconControl
							IconName="not-profiles"
							Height="102"
							Width="97" />
						<TextBlock
							Margin="0 35 0 0"
							Text="No Profiles yet created"
							Theme="{StaticResource SubtitleTextBlockStyle}"
							HorizontalAlignment="Center"
							IsVisible="{Binding !HasFolder}"/>
						<TextBlock
							Margin="0 25 0 0"
							Text="No Profiles yet in this folder"
							Theme="{StaticResource SubtitleTextBlockStyle}"
							HorizontalAlignment="Center">
							<TextBlock.IsVisible>
								<MultiBinding>
									<Binding Path="HasNoItems" />
									<Binding Path="IsProfilesExist"/>
								</MultiBinding>
							</TextBlock.IsVisible>
						</TextBlock>
						<Button
							Theme="{StaticResource SvgIconTextButton}"
							HorizontalAlignment="Center"
							Content="plus-in-circle"
							Tag="Add profile"
							Command="{Binding AddProfilesToFolderCommand}"
							IsEnabled="{Binding IsAddProfilesToFolderCommandEnabled}" />
					</StackPanel>
				</Grid>

				<!--<wait:WaitIndicatorView
					Grid.Row="1"
					DataContext="{Binding}"
					IsIndicatorVisible="{Binding IsWaiting}"/>-->
			</Grid>
		</avfCommon:ChameleonContentControl.Content>

		<avfCommon:ChameleonContentControl.Footer>
			<StackPanel>
				<pagnator:PaginatorView
					DataContext="{Binding PaginatorViewModel}" />
				<!--Select multiple profiles and run browser (Chameleon, Brave, Firefox or Chrome)-->
				<Border
					Background="{StaticResource AccentFillColorDefaultBrush}"
					HorizontalAlignment="Center"
					Height="50"
					CornerRadius="{StaticResource ControlCornerRadius}"
					Margin="0 0 0 3"
					IsVisible="{Binding HasSelectedProfiles}">
					<StackPanel Margin="24 0"
						HorizontalAlignment="Left"
						Orientation="Horizontal">
						<TextBlock
							Text="{Binding SelectedCount}"
							VerticalAlignment="Center" />
						<TextBlock
							Text=" selected"
							VerticalAlignment="Center" />

						<Border BorderBrush="{StaticResource DividerStrokeColorDefaultBrush}"
								Margin="18 6"
								BorderThickness="1 0 0 0" />

						<Button
							Content="chrome"
							ToolTip.Tip="Open In System Chrome"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenChromeCommand}"/>
						<Button
							Content="firefox"
							Margin="3 0 0 0"
							ToolTip.Tip="Open In System Firefox"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenFirefoxCommand}"/>
						<Button
							Content="brave"
							Margin="3 0 0 0"
							ToolTip.Tip="Open In System Brave"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenBraveCommand}"/>
						<Button
							Content="chameleon-logo"
							Margin="3 0 0 0"
							ToolTip.Tip="Open In Chameleon Browser"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenChameleonBrowserCommand}"/>

						<Border BorderBrush="{StaticResource DividerStrokeColorDefaultBrush}"
								Margin="18 6"
								BorderThickness="1 0 0 0" />

						<Button
							Theme="{StaticResource SvgIconTextButton}"
							Content="up-folder"
							Tag="Move"
							Command="{Binding MoveProfilesToFolderCommand}" />
						<Button
							Theme="{StaticResource SvgIconTextButton}"
							Content="delete"
							Tag="Delete"
							Margin="3 0 0 0"
							Command="{Binding DeleteCommand}" />

						<Border BorderBrush="{StaticResource DividerStrokeColorDefaultBrush}"
								Margin="18 6"
								BorderThickness="1 0 0 0" />

						<Button
							Theme="{StaticResource TransparentButton}"
							Content="Unselect"
							Command="{Binding UnselectCommand}"/>
					</StackPanel>
				</Border>
			</StackPanel>
		</avfCommon:ChameleonContentControl.Footer>
	</avfCommon:ChameleonContentControl>
</UserControl>
