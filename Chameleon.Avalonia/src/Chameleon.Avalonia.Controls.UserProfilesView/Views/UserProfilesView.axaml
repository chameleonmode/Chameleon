<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:userProfiles="using:Chameleon.Avalonia.Controls.UserProfilesView"
			 xmlns:pagnator="using:Chameleon.Avalonia.Controls.Paginator"
			 xmlns:converter="using:Chameleon.Common.ValueConverters"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
			 xmlns:vm="using:Chameleon.Avalonia.Controls.UserProfilesView.ViewModels"
			 x:DataType="vm:UserProfilesViewModel"
			 x:CompileBindings="True"
             x:Class="Chameleon.Avalonia.Controls.UserProfilesView.UserProfilesView">

	<UserControl.Resources>
		<converter:ListSortDirectionToNameConverter x:Key="ListSortDirectionToName"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="ui|SymbolIcon.spinner">
			<Style.Animations>
				<Animation Duration="0:0:1" IterationCount="INFINITE">
					<KeyFrame Cue="0%">
						<Setter Property="RotateTransform.Angle" Value="0.0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="RotateTransform.Angle" Value="360.0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</UserControl.Styles>

	<afv:ChameleonContentControl
		  Title="{Binding SelectedFolderTitle}"
		  TitleDescription="{Binding TotalCount, StringFormat='You have {0} profiles.'}">
		<afv:ChameleonContentControl.TitleContent>
			<pagnator:PaginatorView DataContext="{Binding PaginatorViewModel}" />
		</afv:ChameleonContentControl.TitleContent>

		<afv:ChameleonContentControl.Header>
			<StackPanel>
				<TextBox
					HorizontalAlignment="Left"
					Margin="0 0 -6 6"
					Width="300"
					Text="{Binding SearchText}" />

				<HeaderedContentControl Theme="{StaticResource HasSelectedItemsBorder}">
					<HeaderedContentControl.Header>
						<StackPanel Orientation="Horizontal">

							<Button
								Content="chrome"
								ToolTip.Tip="Open In System Chrome"
								Theme="{StaticResource SvgIconButton}"
								Command="{Binding OpenChromeCommand}"/>
							<Button
								Content="firefox"
								Margin="3 0 0 0"
								ToolTip.Tip="Open In System Firefox"
								Theme="{StaticResource SvgIconButton}"
								Command="{Binding OpenFirefoxCommand}"/>
							<Button
								Content="brave"
								Margin="3 0 0 0"
								ToolTip.Tip="Open In System Brave"
								Theme="{StaticResource SvgIconButton}"
								Command="{Binding OpenBraveCommand}"/>
							<Button
								Content="chameleon-logo"
								Margin="3 0 0 0"
								ToolTip.Tip="Open In Chameleon Browser"
								Theme="{StaticResource SvgIconButton}"
								Command="{Binding OpenChameleonBrowserCommand}"/>

							<Border
								BorderBrush="{StaticResource DividerStrokeColorDefaultBrush}"
								Margin="18 6"
								BorderThickness="1 0 0 0" />

							<Button
								Content="up-folder"
								Tag="Move"
								Command="{Binding MoveProfilesToFolderCommand}"
								Theme="{StaticResource SvgIconTextButton}" />

							<Button
								Content="minus-in-circle"
								Tag="Remove profile"
								Command="{Binding RemoveProfilesFromFolderCommand}"
								Theme="{StaticResource SvgIconTextButton}"
								Margin="4 0 0 0"
								IsVisible="{Binding HasFolder}"/>

							<Button
								Theme="{StaticResource SvgIconTextButton}"
								Content="delete"
								Tag="Delete"
								Margin="3 0 0 0"
								Command="{Binding DeleteCommand}" />
						</StackPanel>
					</HeaderedContentControl.Header>
				</HeaderedContentControl>
			</StackPanel>
		</afv:ChameleonContentControl.Header>

		<afv:ChameleonContentControl.Options>
			<StackPanel
				IsVisible="{Binding IsProfilesExist}"
				Spacing="12">
				<Button
					Content="select-all"
					Tag="Select all"
					Theme="{StaticResource SvgIconTextButton}"
					Command="{Binding SelectAllCommand}" />
				<Button
					Content="select-all"
					Tag="Select all in folder"
					Theme="{StaticResource SvgIconTextButton}"
					Command="{Binding SelectAllProfilesFromFolderCommand}" />
				<StackPanel
					Orientation="Horizontal"
					Margin="2 0 0 0">
					<StackPanel.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.And}">
							<Binding Path="HasFolder"/>
							<Binding Path="IsProfilesExist"/>
						</MultiBinding>
					</StackPanel.IsVisible>
					<Button
						Content="plus-in-circle"
						Tag="Add profile"
						Theme="{StaticResource SvgIconTextButton}"
						Command="{Binding AddProfilesToFolderCommand}" />
				</StackPanel>

				<ui:FAComboBox
					Width="200"
					IsEditable="False"
					HorizontalAlignment="Right"
					Header="Sort by:"
					ItemsSource="{Binding Sorts}"
					SelectedItem="{Binding SortSelected}" />

				<!--<ToggleSplitButton 
					Width="200"
					IsChecked="{Binding IsVisibleStopButton}"
					Command="{Binding RunAutomationCommand}">
					<ToggleSplitButton.Content>
						<StackPanel Orientation="Horizontal">
							<TextBlock
								Text="{Binding SelectedAutomationScript.Title}"
								ToolTip.Tip="{Binding $self.Text}" />
							<StackPanel
								Orientation="Horizontal" >
								<ui:SymbolIcon
									Symbol="Play"
									Margin="0 0 5 0"/>
								<TextBlock
									Text="Run"/>
							</StackPanel>
						</StackPanel>
					</ToggleSplitButton.Content>
					<ToggleSplitButton.Flyout>
						<Flyout Placement="Bottom">
							<ListBox
								ItemsSource="{Binding ScriptViewModels}"
								SelectedItem="{Binding SelectedAutomationScript}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<TextBlock
											Text="{Binding Title}"
											ToolTip.Tip="{Binding Title}" />
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Flyout>
					</ToggleSplitButton.Flyout>
				</ToggleSplitButton>-->
				
				<!--Automation Section in Options container-->
				<!--Scripts-->
				<ui:FAComboBox
							  PlaceholderText="Select an automation..."
							  IsEditable="False"
							  HorizontalAlignment="Right"
							  Header="Automation"
							  ItemsSource="{Binding ScriptViewModels}"
							  SelectedItem="{Binding SelectedAutomationScript}"
							  Grid.Row="0"
							  Grid.Column="0"
							  Grid.ColumnSpan="3"
							  Width="200">
					<ui:FAComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock
								Text="{Binding Title}"
								TextTrimming="CharacterEllipsis"
								ToolTip.Tip="{Binding Title}" />
						</DataTemplate>
					</ui:FAComboBox.ItemTemplate>
				</ui:FAComboBox>
				
				<Grid ColumnDefinitions="Auto,Auto,Auto">
					<!--Select Browser-->
					<ui:FAComboBox
						MaxWidth="66"
						HorizontalAlignment="Left"
						SelectedItem="{Binding SelectedBrowserItem}"
						ItemsSource="{Binding BrowserItems}">
						<ui:FAComboBox.ItemTemplate>
							<DataTemplate>
								<StackPanel
									HorizontalAlignment="Center"
									VerticalAlignment="Center">
									<afv:SvgIconControl
										IconName="{Binding IconName}"
										Height="20"
										Width="20"/>
								</StackPanel>
							</DataTemplate>
						</ui:FAComboBox.ItemTemplate>
					</ui:FAComboBox>

					<ToggleButton 
						Margin="20 0 6 0"
						Grid.Column="1"
						IsChecked="{Binding IsRecordSelected}"
						ToolTip.Tip="Record">
						<ui:SymbolIcon
							Symbol="RadioButtonFilled"
							Height="20" />
					</ToggleButton>

					<Panel 
						Grid.Column="2"
						HorizontalAlignment="Right">
						<!--Run Button-->
						<Button
							Classes="accent"
							Width="72"
							Command="{Binding RunAutomationCommand}"
							IsVisible="{Binding IsVisibleRunButton}">
							<StackPanel Orientation="Horizontal" >
								<ui:SymbolIcon
									Symbol="Play"
									Margin="0 0 5 0"/>
								<TextBlock
									Text="Run"/>
							</StackPanel>
						</Button>
						<!--Stop Button-->
						<Button
							Classes="accent"
							Width="72"
							Command="{Binding StopAutomationCommand}"
							IsVisible="{Binding IsVisibleStopButton}">
							<StackPanel Orientation="Horizontal">
								<ui:SymbolIcon
									Symbol="Stop"
									Margin="0 0 5 0"/>
								<TextBlock Text="Stop"/>
							</StackPanel>
						</Button>

						<!--Wait Buttom-->
						<Button
							Classes="accent"
							Width="72"
							IsVisible="{Binding IsVisibleWaitButton}">
							<ui:SymbolIcon
								Symbol="Refresh"
								Height="20"
								Classes="spinner"/>
						</Button>
					</Panel>

					<!--<DropDownButton
						HorizontalAlignment="Right"
						Grid.Row="1"
						Grid.Column="1"
						Margin="0 18 0 0">
						<DropDownButton.Content>
							<StackPanel Orientation="Horizontal">
								<afv:SvgIconControl
									IconName="{Binding SelectedBrowserItem.IconName}"
									Height="20"
									Width="20"/>
								<Panel>
									<StackPanel
										IsVisible="{Binding !IsVisibleWaitButton}"
										Orientation="Horizontal">
										<ui:SymbolIcon
											Symbol="Play"
											Margin="0 0 5 0"/>
										<TextBlock
											Text="Run"
											ToolTip.Tip="{Binding SelectedAutomationScript.Title}"/>
									</StackPanel>
									<ui:SymbolIcon
										IsVisible="{Binding IsVisibleWaitButton}"
										Symbol="Refresh"
										Height="20"
										Classes="spinner"/>
								</Panel>
							</StackPanel>
						</DropDownButton.Content>
						<DropDownButton.Flyout>
							<Flyout Placement="Bottom">
								<ListBox
									ItemsSource="{Binding ScriptViewModels}"
									SelectedItem="{Binding SelectedAutomationScript}">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<TextBlock
												Text="{Binding Title}"
												ToolTip.Tip="{Binding Title}" />
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</Flyout>
						</DropDownButton.Flyout>
					</DropDownButton>-->
				</Grid>

			</StackPanel>
		</afv:ChameleonContentControl.Options>

		<afv:ChameleonContentControl.Content>
			<Panel>
				<Panel VerticalAlignment="Top">
					<Panel.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.And}">
							<Binding Path="!HasNoItems"/>
							<Binding Path="IsProfilesExist"/>
						</MultiBinding>
					</Panel.IsVisible>
					<ListBox
								  Name="lbProfiles"
								  ItemsSource="{Binding ViewModels}"
								  Theme="{StaticResource ListBoxNoScroller}"
								  ItemContainerTheme="{StaticResource GridViewItem}">
						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="1"/>
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<userProfiles:UserProfileView HorizontalAlignment="Stretch" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Panel>
				<Panel>
					<Panel.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.Or}">
							<Binding Path="HasNoItems" />
							<Binding Path="!IsProfilesExist"/>
						</MultiBinding>
					</Panel.IsVisible>
					<afv:SvgIconControl
								  IconName="not-profiles"
								  Width="128"
								  Margin="0 0 0 178" />
					<!--<TextBlock
							Margin="0 35 0 0"
							Text="No Profiles yet created"
							Theme="{StaticResource SubtitleTextBlockStyle}"
							HorizontalAlignment="Center"
							IsVisible="{Binding !HasFolder}"/>-->
					<!--<TextBlock
							Margin="0 12 0 12"
							Text="No Profiles yet in this folder"
							Theme="{StaticResource SubtitleTextBlockStyle}"
							HorizontalAlignment="Center">
							<TextBlock.IsVisible>
								<MultiBinding Converter="{x:Static BoolConverters.And}">
									<Binding Path="HasNoItems" />
									<Binding Path="IsProfilesExist"/>
								</MultiBinding>
							</TextBlock.IsVisible>
						</TextBlock>-->
					<!--<Button
						Theme="{StaticResource SvgIconTextButton}"
						HorizontalAlignment="Center"
						Content="plus-in-circle"
						Tag="Add profile"
						Command="{Binding AddProfilesToFolderCommand}" />-->
				</Panel>
				<!--</Panel>-->

				<!--<wait:WaitIndicatorView
					Grid.Row="1"
					DataContext="{Binding}"
					IsIndicatorVisible="{Binding IsWaiting}"/>-->
			</Panel>
		</afv:ChameleonContentControl.Content>

		<!--<afv:ChameleonContentControl.Footer>
			<pagnator:PaginatorView
				DataContext="{Binding PaginatorViewModel}" />
		</afv:ChameleonContentControl.Footer>-->
	</afv:ChameleonContentControl>
</UserControl>
