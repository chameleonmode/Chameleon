<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:avfCommon="using:Chameleon.Av.Fluent.Common.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:userProfiles="using:Chameleon.Avalonia.Controls.UserProfilesView"
			 xmlns:pagnator="using:Chameleon.Avalonia.Controls.Paginator"
			 xmlns:converter="using:Chameleon.Common.ValueConverters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="Chameleon.Avalonia.Controls.UserProfilesView.UserProfilesView">
	<UserControl.Resources>
		<converter:ListSortDirectionToNameConverter x:Key="ListSortDirectionToName"/>
	</UserControl.Resources>
	<StackPanel Spacing="6">
		<StackPanel Grid.Row="0"
			Margin="0 15 24 0">
			<TextBox Margin="0 0 0 0"
				Width="300"
				Padding="10 5 10 5"
					 Text="{Binding SearchText}" />
		</StackPanel>
	<avfCommon:ChameleonContentControl Title="{Binding SelectedFolderTitle}"
									    TitleDescription="{Binding TotalCount,
										StringFormat='You have {0} profiles.'}">
		<avfCommon:ChameleonContentControl.TitleContent>
			<Grid>
				<StackPanel Orientation="Horizontal" Margin="24 0 0 6">
					<Grid Width="20" Height="16">
						<ui:SymbolIcon Symbol="Share"
									   IsVisible="{Binding IsSharedFolder}" />
						<!--<avfCommon:SvgIconControl IconName="folder"
												  Foreground="{StaticResource FolderProfiles}"/>
						<Grid IsVisible="{Binding !IsSharedFolder}"
									  Width="10" Height="10"
									  Margin="0 0 -2 -3"
									  VerticalAlignment="Bottom" HorizontalAlignment="Right">

							<Ellipse Fill="{StaticResource FolderProfiles}"/>
							<ui:SymbolIcon Symbol="Share" />
						</Grid>-->
					</Grid>
					<Button Margin="0 0 12 0"
							Command="{Binding SetFavoriteCommand}"
							Theme="{StaticResource FavoriteButton}"/>

				</StackPanel>
				<!--<ui:CommandBar DefaultLabelPosition="Right">
					<ui:CommandBar.PrimaryCommands>
						<ui:CommandBarToggleButton IconSource="Star"
												   IsVisible="{Binding ShowFavoriteIcon}"
												   Label="Favorite"
												   ToolTip.Tip="Toggle Favorites"
												   Command="{Binding SetFavoriteCommand}" />
					</ui:CommandBar.PrimaryCommands>
				</ui:CommandBar>-->
			</Grid>
		</avfCommon:ChameleonContentControl.TitleContent>
		
		<avfCommon:ChameleonContentControl.Header>
			<Grid Margin="0 8 0 0"
				  IsVisible="{Binding !HasNoItems}">
				<StackPanel Orientation="Horizontal">

					<!--Style="{StaticResource ProfileButton}"-->
					<Button
						Theme="{DynamicResource TransparentButton}"
						Command="{Binding SelectAllCommand}"
						HorizontalAlignment="Left"
						Margin="2 0 0 0">
						<Button.IsVisible>
							<MultiBinding Converter="{x:Static BoolConverters.And}">
								<Binding Path="!HasFolder"/>
								<Binding Path="IsProfilesExist"/>
							</MultiBinding>
						</Button.IsVisible>
						<StackPanel Orientation="Horizontal">
							<avfCommon:SvgIconControl
								IconName="select-all"
								Margin="0 0 10 0"
								Width="16"
								Height="16"/>
							<TextBlock
								Text="Select all"
								Margin="0 0 12 0"
								VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<StackPanel
						Orientation="Horizontal"
						Margin="2 0 0 0">
						<StackPanel.IsVisible>
							<MultiBinding  Converter="{x:Static BoolConverters.Or}">
								<Binding Path="HasFolder"/>
								<Binding Path="IsProfilesExist"/>
							</MultiBinding>
						</StackPanel.IsVisible>
						<Button Theme="{DynamicResource TransparentButton}"
								Command="{Binding AddProfilesToFolderCommand}"
								IsEnabled="{Binding IsAddProfilesToFolderCommandEnabled}">
							<StackPanel Orientation="Horizontal">
								<avfCommon:SvgIconControl
									IconName="plus-in-circle"
									Margin="8 0 0 0"
									Width="16"
									Height="16"/>
								<TextBlock
									Text="Add profile"
									Margin="10 0 6.5 0"
									VerticalAlignment="Center"/>
							</StackPanel>

						</Button>
						<Button
							Theme="{DynamicResource TransparentButton}"
							IsEnabled="{Binding HasSelectedProfiles}"
							Margin="4 0 0 0"
							Command="{Binding RemoveProfilesFromFolderCommand}">
							<StackPanel Orientation="Horizontal">
								<avfCommon:SvgIconControl
									IconName="minus-in-circle"
									Margin="8 0 0 0"
									Width="16"
									Height="16"/>
								<TextBlock
									Text="Remove profile"
									Margin="10 0 6.5 0"
									VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<!--Style="{StaticResource ProfileButton}"-->
						<Button
							Theme="{DynamicResource TransparentButton}"		
							Margin="4 0 0 0"
							Command="{Binding SelectAllProfilesFromFolderCommand}"
							IsVisible="{Binding HasFolder}">
							<StackPanel Orientation="Horizontal">
								<avfCommon:SvgIconControl
									IconName="select-all"
									Margin="8 0 0 0"
									Width="16"
									Height="16"/>
								<TextBlock
									Text="Select all"
									Margin="10 0 6.5 0"
									VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

					</StackPanel>
				</StackPanel>

				<StackPanel
					HorizontalAlignment="Right"
					Orientation="Horizontal"
					IsVisible="{Binding IsProfilesExist}">
					<!--Style="{StaticResource ProfileCountSubtext}"-->
					<TextBlock
								
						VerticalAlignment="Bottom"
						Text="Sort by:"
						FontWeight="DemiBold"
						Margin="0 0 6 10"/>
					<!--materialDesign:HintAssist.Foreground="Transparent"-->
					<!--Foreground="{StaticResource SecondaryText}"-->
					<ComboBox
						ItemsSource="{Binding Sorts}"
						VerticalAlignment="Bottom"
						SelectedItem="{Binding SortSelected}"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<!--Foreground="{StaticResource MainBlack}"-->
								<Label Content="{Binding Converter={StaticResource ListSortDirectionToName}}"
                                       />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>
			</Grid>
		</avfCommon:ChameleonContentControl.Header>

		<avfCommon:ChameleonContentControl.Options>
		</avfCommon:ChameleonContentControl.Options>
		
		<Grid>
								<ItemsControl ItemsSource="{Binding ViewModels}">
									<ItemsControl.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="!HasNoItems"/>
											<Binding Path="IsProfilesExist"/>
										</MultiBinding>
									</ItemsControl.IsVisible>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
												<userProfiles:UserProfileView HorizontalAlignment="Stretch" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							<!--ItemTemplate="{StaticResource ProfilesListViewTemplate}"-->


			<Grid>
				<Border
					HorizontalAlignment="Center"
					VerticalAlignment="Center">

					<!--			Foreground="{StaticResource SecondaryText}"-->
					<TextBlock
						Grid.Row="2"
						Margin="0 25 0 0"
						Text="Profiles not found"
						FontSize="18"
						FontFamily="Open Sans"
						FontWeight="DemiBold"
						HorizontalAlignment="Center"
				
						IsVisible="{Binding !IsProfilesExist}"/>
				</Border>
			</Grid>

			<Grid Grid.Row="1" IsVisible="True">
				<Grid.IsVisible>
					<MultiBinding Converter="{x:Static BoolConverters.Or}">
						<Binding Path="HasNoItems" />
						<Binding Path="!IsProfilesExist"/>
					</MultiBinding>
				</Grid.IsVisible>
				<StackPanel
					Orientation="Vertical"
					HorizontalAlignment="Center"
					Margin="0 140 0 0">

					<!--Foreground="{StaticResource SecondaryText}"-->
					<avfCommon:SvgIconControl
						IconName="not-profiles"
						Height="102"
						Width="97"
							/>

					<!--Foreground="{StaticResource SecondaryText}"-->
					<TextBlock
						Margin="0 35 0 0"
						Text="No Profiles yet created"
						FontSize="18"
						FontFamily="Open Sans"
						FontWeight="DemiBold"
						HorizontalAlignment="Center"
							
						IsVisible="{Binding !HasFolder}"/>

					<!--Foreground="{StaticResource SecondaryText}"-->
					<TextBlock
						Margin="0 25 0 0"
						Text="No Profiles yet in this folder"
						FontSize="18"
						FontFamily="Open Sans"
						FontWeight="DemiBold"
						HorizontalAlignment="Center"
							>
						<TextBlock.IsVisible>
							<MultiBinding>
								<Binding Path="HasNoItems" />
								<Binding Path="IsProfilesExist"/>
							</MultiBinding>
						</TextBlock.IsVisible>
					</TextBlock>
					<!--Style="{StaticResource ProfileAddButton}"-->
					<Button Theme="{DynamicResource TransparentButton}"
							HorizontalAlignment="Center"
							Command="{Binding AddProfilesToFolderCommand}"
							IsEnabled="{Binding IsAddProfilesToFolderCommandEnabled}"
							IsVisible="{Binding HasFolder}">
						<StackPanel Orientation="Horizontal">
							<avfCommon:SvgIconControl
								IconName="plus-in-circle"
								Margin="8 0 0 0"
								Width="16"
								Height="16"/>
							<TextBlock
								Text="Add profile"
								Margin="10 0 6.5 0"
								VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>

			<!--<wait:WaitIndicatorView
					Grid.Row="1"
					DataContext="{Binding}"
					IsIndicatorVisible="{Binding IsWaiting}"/>-->
		</Grid>

		<avfCommon:ChameleonContentControl.Footer>
			<StackPanel>

				<pagnator:PaginatorView
					DataContext="{Binding PaginatorViewModel}" />
				
							<Border
				Background="{StaticResource AccentFillColorDefaultBrush}"
				Grid.Row="2"
				VerticalAlignment="Bottom"
				HorizontalAlignment="Center"
				Height="50"
				CornerRadius="4"
				Margin="0 0 0 3"
				IsVisible="{Binding !HasSelectedProfiles}">
				<StackPanel
					HorizontalAlignment="Left"
					Orientation="Horizontal">
					<TextBlock
						Text="{Binding SelectedCount}"
						Margin="24 0 0 0"
						VerticalAlignment="Center"
							/>
					<!--Style="{StaticResource GreyText}"-->
					<TextBlock
						Text=" selected"
						VerticalAlignment="Center"
							/>
					<!--Select multiple profiles and run browser (Chameleon, Brave, Firefox or Chrome)-->
					<Button Content="chrome"
							Margin="20 0 0 0"
							ToolTip.Tip="Open In System Chrome"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenChromeCommand}"/>
					<Button Content="firefox"
							 Margin="3 0 0 0"
							ToolTip.Tip="Open In System Firefox"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenFirefoxCommand}"/>
					<Button Content="brave"
							 Margin="3 0 0 0"
							ToolTip.Tip="Open In System Brave"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenBraveCommand}"/>
					<Button Content="chameleon-logo"
							 Margin="3 0 0 0"
							ToolTip.Tip="Open In Chameleon Browser"
							Theme="{StaticResource SvgIconButton}"
							Command="{Binding OpenChameleonBrowserCommand}"/>
					<Button
						Theme="{StaticResource TransparentButton}"
						Margin="10 0 0 0"
						Padding="6"
						Height="36"
						Command="{Binding MoveProfilesToFolderCommand}">
						<StackPanel
							Orientation="Horizontal">
							<avfCommon:SvgIconControl
								IconName="up-folder"
								Width="14"
								Height="14"/>
							<TextBlock
								Text="Move"
								Margin="10 0 0 0" />
						</StackPanel>
					</Button>
					<Button
						Theme="{StaticResource TransparentButton}"
							Foreground="{StaticResource SystemFillColorCriticalBrush}"
						Margin="10 0 0 0"
						Padding="6"
						Height="36"
						Command="{Binding DeleteCommand}">
						<StackPanel
							Orientation="Horizontal">
							<avfCommon:SvgIconControl
								IconName="delete"
								Width="14"
								Height="14"/>
							<TextBlock
								Text="Delete"
								Margin="10 0 0 0" />
						</StackPanel>
					</Button>

					<Border
						BorderThickness="1 0 0 0"
						Opacity="0.45"
						Height="26"
						VerticalAlignment="Center"
						Margin="6 0 0 0"/>
					<Button
						Theme="{StaticResource TransparentButton}"
						Margin="16 0 24 0"
						Padding="6"
						Height="36"
						Content="Unselect"
						Command="{Binding UnselectCommand}"/>
				</StackPanel>
			</Border>

			</StackPanel>

		</avfCommon:ChameleonContentControl.Footer>
	</avfCommon:ChameleonContentControl>
	</StackPanel>		
</UserControl>
