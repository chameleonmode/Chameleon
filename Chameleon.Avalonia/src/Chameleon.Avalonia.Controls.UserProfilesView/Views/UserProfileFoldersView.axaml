<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:avfCommon="using:Chameleon.Av.Fluent.Common.Controls"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="450"
             x:Class="Chameleon.Avalonia.Controls.UserProfilesView.UserProfileFoldersView">
	<UserControl.Resources>
<!--materialDesign:ButtonAssist.CornerRadius="0"-->
		<!--Style="{StaticResource OutlinedButton}"-->
		<DataTemplate x:Key="FoldersListViewTemplate">
			<Grid>
				<Button
                    HorizontalAlignment="Stretch"
                    
                    
                    BorderThickness="0"
                    Padding="0"
                    Height="40"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding OpenCommand}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Grid Grid.Column="0"
                              Width="17" Height="14"
                              Margin="16 11 0 13">
						<!--Foreground="{StaticResource SecondaryText}"-->	<avfCommon:SvgIconControl IconName="folder"
                                      />

							<Grid IsVisible="{Binding IsSharedFolder}"
                                  Width="8" Height="8"
                                  Margin="0 0 -2 -3"
                                  VerticalAlignment="Bottom" HorizontalAlignment="Right">

							<!--Fill="{StaticResource SecondaryText}"-->	<Ellipse />
								<!--<materialDesign:PackIcon Kind="ShareVariant"
                                                         Width="7" Height="7"
                                                         Margin="0 0 1 0"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Foreground="{StaticResource White}"/>-->
							</Grid>
						</Grid>

			<!--Foreground="{StaticResource MainBlack}"-->			<TextBlock
                            Text="{Binding UserProfileFolder.Title}"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="11 0 0 0"
                            FontFamily="Open Sans"
                            FontSize="14"
                            FontWeight="DemiBold"
                             />
					</Grid>
				</Button>
	<!--BorderBrush="{StaticResource DividerLine}"-->		<!--Background="{StaticResource LightPurple29}"-->	
				<Border
                    IsVisible="{Binding IsSelected}"
                    BorderThickness="0 1 0 1"
                    
                    Height="40">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
				<!--BorderBrush="{StaticResource PrimaryHueMidBrush}"-->		<Border  Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            
                            BorderThickness="3 0 0 0"
                            Margin="1 0 0 0"
                            Width="3"
                            Height="23"/>

						<Grid Grid.Column="0"
                              Width="17" Height="14"
                              Margin="16 11 0 13">
						<!--Foreground="{StaticResource SecondaryText}"-->	<avfCommon:SvgIconControl IconName="selected-folder"
                                      />

							<Grid IsVisible="{Binding IsSharedFolder}"
                                  Width="8" Height="8"
                                  Margin="0 0 -2 -3"
                                  VerticalAlignment="Bottom" HorizontalAlignment="Right">

							<!--Stroke="{StaticResource SecondaryText}"-->	<!--Fill="{StaticResource White}"--><Ellipse  />
								<!--<materialDesign:PackIcon Kind="ShareVariant"
                                                         Width="7" Height="7"
                                                         Margin="0 0 1 0"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Foreground="{StaticResource SecondaryText}"/>-->
							</Grid>
						</Grid>

				<!--Style="{StaticResource FolderTextBox}"-->		<!--IsVisibleChanged="SetKeyboardFocus"-->
						<Grid ColumnDefinitions="*, Auto"
							  Grid.Column="1">
							<TextBox Grid.Column="0"
                            IsVisible="{Binding IsRenamed}"
                            
                            Name="RenameTextBox"
                            Text="{Binding Title}"
                            Margin="9 0 0 0"
                            
                            VerticalAlignment="Center">
							<!--<TextBox.InputBindings>
								<KeyBinding Key="Return" Command="{Binding SaveRenameCommand}" />
							</TextBox.InputBindings>-->
						</TextBox>
						</Grid>
						<Button Content="Save"
								IsVisible="{Binding IsRenamed}"
								Command="{Binding SaveRenameCommand}"/>
<!--Style="{StaticResource MaterialDesignIconForegroundButton}"-->
						<Button Grid.Column="2"
                            HorizontalAlignment="Right"
                            Theme="{DynamicResource TransparentButton}"
                            ToolTip.Tip="Details"
                            VerticalAlignment="Center"
                            Command="{Binding OpenMenuCommand}">
				<!--Foreground="{StaticResource FolderMenu}"-->			
							<avfCommon:SvgIconControl Grid.Column="0"
                                HorizontalAlignment="Left"
                                Margin="0"
                                IconName="three-dots"
                                
                                Width="23"
                                Height="23"/>
						</Button>

						<!--Placement="Mouse"--><Popup x:Name="menuPopup"
               Placement="Pointer"
                                   Width="152"
                                   IsOpen="{Binding IsOpenMenuPopup}">
						<!--BorderBrush="{StaticResource MaterialDesignDivider}"-->	<Border
                                    Width="152"
                                    
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Background="Transparent">
								<Grid Background="White">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
								<!--Style="{StaticResource OutlinedButton}"-->	<Button Grid.Row="0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding ChangeProxiesCommand}"
                                            
                                            Padding="0"
                                            BorderThickness="0"
                                            Width="152"
                                            Height="35"
                                            IsEnabled="{Binding IsContextMenuItemEnabled}">
										<Grid Width="152">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="4*"/>
											</Grid.ColumnDefinitions>
											<!--Foreground="{StaticResource SecondaryText}"--><avfCommon:SvgIconControl Grid.Column="0"
                                                IconName="change-proxies"
                                                Width="13"
                                                Height="13"
                                                Margin="12 6 0 8"
                                                />
											<TextBlock
                                                Text="Change Proxies"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Grid.Column="1"
                                                Margin="11 9 25 10"/>
										</Grid>
									</Button>
								<!--Style="{StaticResource OutlinedButton}"-->	<Button Grid.Row="1"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding StartRenameCommand}"
                                            
                                            Padding="0"
                                            BorderThickness="0"
                                            Width="152"
                                            Height="35"
                                            IsEnabled="{Binding IsContextMenuItemEnabled}">
										<Grid Width="152">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="4*"/>
											</Grid.ColumnDefinitions>
											<!--Foreground="{StaticResource SecondaryText}"--><avfCommon:SvgIconControl Grid.Column="0"
                                                IconName="re-name"
                                                Width="13"
                                                Height="13"
                                                Margin="12 6 0 8"
                                                />
											<TextBlock
                                                Text="Rename folder"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Grid.Column="1"
                                                Margin="11 9 25 10"/>
										</Grid>
									</Button>
								<!--Style="{StaticResource OutlinedButton}"-->	<Button Grid.Row="2"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding DeleteCommand}"
                                        
                                        BorderThickness="0"
                                        Padding="0"
                                        Width="152"
                                        Height="35"
                                        IsEnabled="{Binding IsContextMenuItemEnabled}">
										<Grid Width="152">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="4*"/>
											</Grid.ColumnDefinitions>
											<!--Foreground="{StaticResource SecondaryText}"--><avfCommon:SvgIconControl Grid.Column="0"
                                                IconName="delete"
                                                Width="13"
                                                Height="14"
                                                Margin="14 11 0 11"
                                                />
											<TextBlock
                                                Text="Delete folder"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                FontSize="12"
                                                Grid.Column="1"
                                                Margin="10 8 38 4"/>
										</Grid>
									</Button>
								</Grid>
							</Border>
						</Popup>
					</Grid>
				</Border>
			</Grid>
		</DataTemplate>
	</UserControl.Resources>
	<Grid Width="275" Margin="0">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Border Grid.Row="0">
			<Grid>
			<!--Style="{StaticResource MaterialDesignHeadline6TextBlock}"-->	<TextBlock
                    
                    Margin="16 17 0 6"
                    HorizontalAlignment="Left"
                    Text="Folders"
                    FontFamily="Open Sans"
                    FontSize="16"
                    FontWeight="Bold"
                    Height="24"
                    />
				<!--Style="{StaticResource OutlinedButton}"--><Button
                    
                    Command="{Binding CreateCommand}"
                    ToolTip.Tip="Create Folder"
                    Margin="0 13 15 12"
                    HorizontalAlignment="Right"
                    Height="20"
                    Width="23"
                    BorderThickness="0"
                    IsEnabled="{Binding IsCreateBtnEnabled}">
					<avfCommon:SvgIconControl
                        IconName="new-folder"
                        Width="20"
                        Height="16"
                        Margin="3 4 0 0"/>
				</Button>
			</Grid>
		</Border><!--Style="{StaticResource OutlinedButton}"-->
<!--materialDesign:ButtonAssist.CornerRadius="0"-->
<!--BorderBrush="{DynamicResource MaterialDesignDivider}"-->		<Button Grid.Row="1"
            
            
            
            BorderThickness="1 1 0 1"
            Padding="0"
            HorizontalAlignment="Stretch"
            DataContext="{Binding AllProfiles}"
            Height="40"
            HorizontalContentAlignment="Left"
            Command="{Binding OpenCommand}">
			<Grid HorizontalAlignment="Left">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

		<!--Foreground="{StaticResource SecondaryText}"-->		<avfCommon:SvgIconControl
                    Grid.Column="0"
                    Margin="16 11 0 13"
                    IconName="folder"
                    
                    Width="17"
                    Height="14"/>

		<!--Foreground="{StaticResource MainBlack}"-->		<TextBlock
                    Text="{Binding UserProfileFolder.Title}"
                    Margin="11 0 0 0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Open sans"
                    FontSize="14"
                    FontWeight="DemiBold"
                    >

				</TextBlock>
			</Grid>
		</Button>
<!--Background="{StaticResource LightPurple29}"-->		<Grid Grid.Row="1"
              Height="40"
              
              Panel.ZIndex="100"
              IsVisible="{Binding AllProfiles.IsSelected}">
	<!--BorderBrush="{StaticResource PrimaryHueMidBrush}"-->		<Border HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Height="23"
                    
                    BorderThickness="3 0 0 0"
                    Margin="1 0 0 0"/>
		</Grid>
		<ScrollViewer Grid.Row="2">
		<!--ItemContainerStyle="{StaticResource VisibleToggle}"-->	<ItemsControl
                x:Name="itemsList"
                ItemsSource="{Binding ViewModels}"
                ItemTemplate="{StaticResource FoldersListViewTemplate}"
                
                Padding="0"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"/>
		</ScrollViewer>
		<!--BorderBrush="{StaticResource DividerLine}"--><Border Grid.Row="2"
                
                BorderThickness="1 0 0 0"/>
		<!--<wait:WaitIndicatorView
            Grid.Row="2"
            DataContext="{Binding}"
            IsIndicatorVisible="{Binding IsWaiting}"/>-->
	</Grid>
</UserControl>
