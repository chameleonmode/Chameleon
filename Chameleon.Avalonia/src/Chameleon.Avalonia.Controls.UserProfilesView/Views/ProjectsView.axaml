<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="using:Chameleon.Avalonia.Controls.UserProfilesView"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:avfCommon="using:Chameleon.Av.Fluent.Common.Controls"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="850"
			 xmlns:vm="using:Chameleon.Avalonia.Controls.UserProfilesView.ViewModels"
			 x:DataType="vm:ProjectsViewModel"
			 x:CompileBindings="True"
             x:Class="Chameleon.Avalonia.Controls.UserProfilesView.ProjectsView">
	<ScrollViewer>
		<StackPanel Spacing="-18">
			<avfCommon:PageHeaderControl Grid.Row="0"
										 TextType="Profiles"
										 Classes="smallest"/>

			<Grid Grid.Row="1"
				  Margin="{StaticResource ChameleonAppPageMargin}">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition  Width="3*" />
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
						<!--<breadcrumbsView:BreadcrumbsView
							DataContext="{Binding ElementName=profilesView, Path=DataContext.BreadcrumbsViewModel}"
							VerticalAlignment="Center"
							Margin="23 0 0 0"/>-->
						<Panel Grid.ColumnSpan="2">
							<Button Theme="{StaticResource SyncChangesButton}" />
							<Button HorizontalAlignment="Left"
									Margin="6 0"
									Classes="accent"
									Command="{Binding CreateProfileCommand}"
									IsVisible="{Binding IsCreateProfileBtnVisible}">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<ui:SymbolIcon Symbol="Add"  />
									<TextBlock Text="New Profile"
											   VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
							<!--featureTouring:TourHelper.ElementID="{x:Static guidedTour:ElementID.CreateProfileBtn}"
									featureTouring:TourHelper.Placement="BottomRight"-->
						</Panel>
				<local:UserProfilesView
					Grid.Column="0"
					Grid.Row="1"
					x:Name="profilesView">
				</local:UserProfilesView>

				<local:UserProfileFoldersView
					Grid.Column="1"
					Grid.Row="1"
					x:Name="foldersView"
					BorderThickness="1 0 0 0">
				</local:UserProfileFoldersView>
			</Grid>
		</StackPanel>
	</ScrollViewer>
</UserControl>
