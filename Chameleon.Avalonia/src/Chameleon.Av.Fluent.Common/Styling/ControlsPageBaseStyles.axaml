<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:ctrls="using:Chameleon.Av.Fluent.Common.Controls"
		xmlns:pg="using:Chameleon.Av.Fluent.Common.Pages"
		xmlns:ui="using:FluentAvalonia.UI.Controls">
  <Design.PreviewWith>
    <Border Width="700" Background="{DynamicResource LayerFillColorDefaultBrush}">
		<pg:ChameleonPageBase PreviewImage="{StaticResource DashboardPageIcon}" 
							  ControlName="Dashboard"
							  Description="Your favorited profiles and folders">
			<ctrls:ChameleonContentControl Title="S titi"
											   >
				<ctrls:ChameleonContentControl.Header>
					<Grid HorizontalAlignment="Right">
						<ui:CommandBar DefaultLabelPosition="Right">
							<ui:CommandBar.PrimaryCommands>
								<ui:CommandBarButton IconSource="Save"
													 Label="Save" />
								<ui:CommandBarSeparator />
								<ui:CommandBarButton IconSource="Refresh"
													 Label="Auto Update Proxies" />
							</ui:CommandBar.PrimaryCommands>
							<ui:CommandBar.SecondaryCommands>
								<ui:CommandBarButton IconSource="Cut" Label="Cut" />
								<ui:CommandBarButton IconSource="Copy" Label="Copy" />
								<ui:CommandBarButton IconSource="Paste" Label="Paste" />
								<ui:CommandBarSeparator />
								<ui:CommandBarToggleButton IconSource="Bold" Label="Bold" />
								<ui:CommandBarToggleButton IconSource="Italic" Label="Italic" />
								<ui:CommandBarToggleButton IconSource="Underline" Label="Underline" />
							</ui:CommandBar.SecondaryCommands>
						</ui:CommandBar>
						<!--<Button Classes="accent"
									Margin="4 0 0 0"
									Width="175"
									Content="Auto Update Proxies"
									Command="{Binding FillProxiesCommand}"
									IsEnabled="{Binding FillProxiesIsEnabled}"/>-->
					</Grid>
				</ctrls:ChameleonContentControl.Header>

				<ctrls:ChameleonContentControl.Options>
					<StackPanel Spacing="12"
								Margin="4">
						<!--DisplayMemberBinding="{Binding DisplayName, DataType=vm:ComboItem}"
											<Label Content="{Binding Title}"/>-->
						<ui:FAComboBox Header="Folder:"
									   SelectedItem="{Binding SelectedFolder}"
									   ItemsSource="{Binding FolderViewModels.Items}"
									   IsEditable="False"
									   IsTextSearchEnabled="True"
									  HorizontalAlignment="Stretch"/>
						<!--DisplayMemberBinding="{Binding DisplayName, DataType=vm:ComboItem}"
											<Label Content="{Binding Name}"/>-->
						<ui:FAComboBox Header="Current proxy country:"
									  ItemsSource="{Binding Countries.Items}"
									  SelectedItem="{Binding Country}"
									   IsEditable="False"
									   IsTextSearchEnabled="True"
									  HorizontalAlignment="Stretch"/>
					</StackPanel>
				</ctrls:ChameleonContentControl.Options>
				<ctrls:ChameleonContentControl.Content>
					<Grid RowDefinitions="*,Auto">

						<DataGrid ItemsSource="{Binding ViewModels}"
								  VerticalAlignment="Top"
									  AutoGenerateColumns="False"
								  GridLinesVisibility="None"
								  CanUserResizeColumns="False"
								  CanUserReorderColumns="False"
								  SelectionMode="Single"
								  CanUserSortColumns="True"
								  BorderThickness="1 0 1 0">

							<DataGrid.Columns>
								<DataGridTemplateColumn Width="Auto">
									<DataGridTemplateColumn.Header>
										<CheckBox HorizontalAlignment="Center"
									IsChecked="{Binding Path=DataContext.IsSelectedAll,
                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid, AncestorLevel=1}}"/>
									</DataGridTemplateColumn.Header>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<CheckBox IsChecked="{Binding IsSelected}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTextColumn IsReadOnly="True"
													Header="PROJECT NAME"
													Binding="{Binding InProject}"
													CanUserSort="True"/>
								<DataGridTemplateColumn IsReadOnly="True"
														Width="*"
														Header="PROFILE">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<StackPanel Orientation="Horizontal">
												<Grid>
													<Ellipse Grid.Column="1"
															 Fill="{StaticResource AccentFillColorSelectedTextBackgroundBrush}"
															 Width="28"
															 Height="28"
															 VerticalAlignment="Center">
													</Ellipse>
													<TextBlock Text="{Binding Code}"
															   Foreground="{StaticResource TextOnAccentFillColorSelectedTextBrush}"
															   VerticalAlignment="Center"
															   HorizontalAlignment="Center"  />
												</Grid>
												<TextBlock VerticalAlignment="Center"
														   Margin="13 0 0 0"
														   Text="{Binding Title}"/>
											</StackPanel>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTextColumn IsReadOnly="True"
													Width="Auto"
													Header="IP"
													Binding="{Binding UserProfileModel.Proxy.Host}"/>
								<DataGridTextColumn IsReadOnly="True"
													Width="Auto"
													Header="PORT"
													Binding="{Binding UserProfileModel.Proxy.Port}"/>
								<DataGridTextColumn IsReadOnly="True"
													Width="Auto"
													Header="USERNAME"
													Binding="{Binding UserProfileModel.Proxy.UserName}"/>
								<DataGridTextColumn IsReadOnly="True"
													Header="PASSWORD"
													Binding="{Binding UserProfileModel.Proxy.Password}"/>
								<DataGridTemplateColumn IsReadOnly="True" >
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<StackPanel Orientation="Horizontal"
														Cursor="Hand"
														Background="Transparent">
												<Button Theme="{StaticResource TransparentButton}"
														Command="{Binding ClickIconChangeProxiesCommand}">
													<ui:SymbolIcon Symbol="Add" />
												</Button>
											</StackPanel>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>
						<Button Grid.Row="1"
												 DataContext="{Binding PaginatorViewModel}" />
						<!--{Binding HasSelectedItems}-->
						<!--<Border Grid.Row="0"
								Grid.Column="0"
								Grid.ColumnSpan="2"
								Grid.RowSpan="2"
								IsVisible="{Binding HasSelectedItems}"
								Background="{StaticResource AccentFillColorDefaultBrush}"
								Padding="{StaticResource ChameleonControlMargin}"
								VerticalAlignment="Bottom">
							<StackPanel Orientation="Horizontal"
										HorizontalAlignment="Center"
										Spacing="16">
								<StackPanel Orientation="Horizontal"
											VerticalAlignment="Center">
									<TextBlock Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
											   Text="{Binding SelectedCount}"/>
									<TextBlock Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
											   Text=" Selected"/>
								</StackPanel>
								<Button Content="Unselect"
										Grid.Column="1"
										 Classes="accent"
										Command="{Binding UnselectItemsCommand}" />
								<Button Content="Change proxies"
										 Grid.Column="2"
										 Command="{Binding ChangeProxiesCommand}"/>
							</StackPanel>
						</Border>-->
					</Grid>
				</ctrls:ChameleonContentControl.Content>

				<ctrls:ChameleonContentControl.Footer>
					<ui:SettingsExpander Header="PROXIES EDITOR"
								 IconSource="Image"
								 Name="SettingsExpander4"
										 IsExpanded="True">
						<ui:SettingsExpanderItem>
							<Grid>
								<!--{Binding ShowCustomizeProxies}-->
								<Border CornerRadius="5 0"
									  Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
									  VerticalAlignment="Bottom"
									  IsVisible="True">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="*"/>
										</Grid.RowDefinitions>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition/>
												<ColumnDefinition/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="CUSTOMIZE PROXIES"
													   Theme="{StaticResource SubtitleTextBlockStyle}"
													   Grid.Column="0"
													   VerticalAlignment="Center"
													   HorizontalAlignment="Left"
													   Margin="25 0 0 0"/>
											<DockPanel Grid.Column="1"
													   HorizontalAlignment="Right"
													   VerticalAlignment="Center" >
												<Button Classes="accent" Command="{Binding HideCustomizeProxiesCommand}">
													<ui:SymbolIcon Symbol="Clear" />
												</Button>
											</DockPanel>
										</Grid>
										<Grid  Grid.Row="1">
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="*"/>
											</Grid.RowDefinitions>
											<Grid.ColumnDefinitions>
												<ColumnDefinition/>
												<ColumnDefinition/>
											</Grid.ColumnDefinitions>
											<TextBlock FontSize="14"
												   Text="Please add your proxies using the format below"
												   Margin="36 0 0 0"
												   VerticalAlignment="Center"/>
											<Button Width="148"
												Height="46"
												Margin="0 12 33 10"
												Content="Apply changes"
												VerticalAlignment="Center"
												HorizontalAlignment="Right"
												Grid.Column="1"
												Command="{Binding ApplyProxyCommand}"/>
											<TextBlock Grid.Row="1" Grid.Column="0"
													   FontSize="14"
													   Text="NEW PROXY"
													   Margin="36 0 0 0"
													   VerticalAlignment="Center"/>
											<TextBlock Grid.Row="1" Grid.Column="1"
													   FontSize="14"
													   Text="CURRENT PROXY"
													   Margin="36 0 0 0"
													   VerticalAlignment="Center"/>
											<StackPanel Grid.Row="2"
														Grid.Column="0">
												<TextBox
														 Margin="24 9 0 0"
														 AcceptsReturn="True"
														 TextWrapping="NoWrap"
														 Height="199"
														 Text="{Binding ApplingProxy}"
														 BorderBrush="{StaticResource BorderOutlineButton}">
												</TextBox>
												<TextBox
														 Margin="24 10 0 0"
														 Text=":"
														 BorderBrush="{StaticResource BorderOutlineButton}"
														 IsHitTestVisible="False">
												</TextBox>
											</StackPanel>
											<ListBox Grid.Row="2"
														  Grid.Column="1"
														  x:Name="itemsList"
														  ItemsSource="{Binding ViewModels}"
														  Margin="16 0 22 0"
													 IsHitTestVisible="False">
												<ListBox.ItemTemplate>
													<DataTemplate>
														<TextBox IsReadOnly="True"
																 VerticalAlignment="Center"
																 Margin="0 8 0 0"
																 BorderBrush="{StaticResource BorderOutlineButton}">
															<TextBox.Text>
																<MultiBinding Converter="{StaticResource MultiStringJoin}">
																	<Binding Path="UserProfileModel.Proxy.Host"/>
																	<Binding Path="UserProfileModel.Proxy.Port" />
																	<Binding Path="UserProfileModel.Proxy.UserName" />
																	<Binding Path="UserProfileModel.Proxy.Password" />
																</MultiBinding>
															</TextBox.Text>
														</TextBox>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>
										</Grid>
									</Grid>
								</Border>
							</Grid>
						</ui:SettingsExpanderItem>
					</ui:SettingsExpander>
				</ctrls:ChameleonContentControl.Footer>

			</ctrls:ChameleonContentControl>
		</pg:ChameleonPageBase>
    </Border>
  </Design.PreviewWith>

	<Style Selector="pg|ChameleonPageBase">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
		<Setter Property="Template">
			<ControlTemplate>
				<DockPanel Name="Root"
                           Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
					<Panel Name="HeaderRegion"
                           DockPanel.Dock="Top"
                           ClipToBounds="False">
						<Border Background="{DynamicResource PageHeaderBackgroundBrush}"
                                OpacityMask="{DynamicResource HeaderOpacityMaskBrush}"
                                Height="80"
                                VerticalAlignment="Top"/>
						<Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="*,Auto"
                              Margin="0 3 0 0"
                              ClipToBounds="False">
							<Panel Name="PageDetails"
                                   Margin="2 0 0 0"
                                   ClipToBounds="False">
								<Border Width="50"
										Height="50"
                                        CornerRadius="{DynamicResource OverlayCornerRadius}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Name="ImageHost"
                                        ClipToBounds="False">
									<Border.Transitions>
										<Transitions>
											<DoubleTransition Property="Width"
                                                              Duration="00:00:01.25"
                                                              Easing="0,0 0,1" />
											<DoubleTransition Property="Height"
                                                              Duration="00:00:00.25"
                                                              Easing="0,0 0,1" />
										</Transitions>
									</Border.Transitions>
									<Viewbox Margin="12" 
											 ClipToBounds="False">
										<ui:IconSourceElement Name="PreviewImageElement"
															  IconSource="{TemplateBinding PreviewImage}" />
									</Viewbox>
								</Border>
								<StackPanel Margin="60 0 0 0"
                                            VerticalAlignment="Top"
                                            Name="DetailsTextHost">
									<TextBlock Text="{TemplateBinding ControlName}"
                                               Theme="{StaticResource TitleTextBlockStyle}"
                                               Name="ControlNameTextBlock">
										<TextBlock.Transitions>
											<Transitions>
												<DoubleTransition Duration="00:00:00.167"
                                                                  Property="FontSize" />
											</Transitions>
										</TextBlock.Transitions>
									</TextBlock>

									<TextBlock Text="{TemplateBinding Description}"
											   Theme="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
											   FontStyle="Italic"
											   Name="NamespaceText" />
								</StackPanel>
							</Panel>

						</Grid>
					</Panel>

					<ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  Padding="{DynamicResource ChameleonAppPageMargin}"
                                  Name="PageScroller">
						<ContentPresenter Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  HorizontalContentAlignment="Stretch"
										  VerticalContentAlignment="Stretch"
										  HorizontalAlignment="Stretch"
										  VerticalAlignment="Stretch"
										  Name="PART_ContentPresenter" />
					</ScrollViewer>
				</DockPanel>
			</ControlTemplate>
		</Setter>
	</Style>
	
	<!--<Style Selector="pg|ChameleonPageBase:smallWidth">
		<Style Selector="^ /template/ TextBlock#ControlNameTextBlock">
			<Setter Property="FontSize" Value="26" />
		</Style>
		<Style Selector="^ /template/ StackPanel#DetailsTextHost">
			<Setter Property="Margin" Value="60 0 0 0" />
		</Style>
		<Style Selector="^ /template/ Border#ImageHost">
			<Setter Property="Width" Value="50" />
			<Setter Property="Height" Value="50" />
		</Style>
	</Style>

	<Style Selector="pg|ChameleonPageBase:smallWidth2">

		<Style Selector="^ /template/ Panel#PageDetails">
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="Margin" Value="0" />
		</Style>
	</Style>-->
</Styles>
