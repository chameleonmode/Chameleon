<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:ctrls="using:Chameleon.Av.Fluent.Common.Controls"
		xmlns:ui="using:FluentAvalonia.UI.Controls">
	<Design.PreviewWith>
		<Border Padding="20" Width="780" Height="480">
			<Grid ColumnDefinitions="*,Auto,0.01*">
				<ctrls:ChameleonContentControl Title="S titi"
											   >
					<ctrls:ChameleonContentControl.Header>
						<Grid HorizontalAlignment="Right">
							<ui:CommandBar DefaultLabelPosition="Right">
								<ui:CommandBar.PrimaryCommands>
									<ui:CommandBarButton IconSource="Save"
														 Label="Save" />
									<ui:CommandBarSeparator />
									<ui:CommandBarButton IconSource="Refresh"
														 Label="Auto Update Proxies" />
								</ui:CommandBar.PrimaryCommands>
								<ui:CommandBar.SecondaryCommands>
									<ui:CommandBarButton IconSource="Cut" Label="Cut" />
									<ui:CommandBarButton IconSource="Copy" Label="Copy" />
									<ui:CommandBarButton IconSource="Paste" Label="Paste" />
									<ui:CommandBarSeparator />
									<ui:CommandBarToggleButton IconSource="Bold" Label="Bold" />
									<ui:CommandBarToggleButton IconSource="Italic" Label="Italic" />
									<ui:CommandBarToggleButton IconSource="Underline" Label="Underline" />
								</ui:CommandBar.SecondaryCommands>
							</ui:CommandBar>
							<!--<Button Classes="accent"
									Margin="4 0 0 0"
									Width="175"
									Content="Auto Update Proxies"
									Command="{Binding FillProxiesCommand}"
									IsEnabled="{Binding FillProxiesIsEnabled}"/>-->
						</Grid>
					</ctrls:ChameleonContentControl.Header>

					<ctrls:ChameleonContentControl.Options>
						<StackPanel Spacing="12"
									Margin="4">
							<!--DisplayMemberBinding="{Binding DisplayName, DataType=vm:ComboItem}"
											<Label Content="{Binding Title}"/>-->
							<ui:FAComboBox Header="Folder:"
										   SelectedItem="{Binding SelectedFolder}"
										   ItemsSource="{Binding FolderViewModels.Items}"
										   IsEditable="False"
										   IsTextSearchEnabled="True"
										  HorizontalAlignment="Stretch"/>
							<!--DisplayMemberBinding="{Binding DisplayName, DataType=vm:ComboItem}"
											<Label Content="{Binding Name}"/>-->
							<ui:FAComboBox Header="Current proxy country:"
										  ItemsSource="{Binding Countries.Items}"
										  SelectedItem="{Binding Country}"
										   IsEditable="False"
										   IsTextSearchEnabled="True"
										  HorizontalAlignment="Stretch"/>
						</StackPanel>
					</ctrls:ChameleonContentControl.Options>
					<ctrls:ChameleonContentControl.Content>
						<Grid RowDefinitions="*,Auto">

							<DataGrid ItemsSource="{Binding ViewModels}"
									  AutoGenerateColumns="False"
								  GridLinesVisibility="None"
								  CanUserResizeColumns="False"
								  CanUserReorderColumns="False"
								  SelectionMode="Single"
								  CanUserSortColumns="True"
								  BorderThickness="1 0 1 0">

								<DataGrid.Columns>
									<DataGridTemplateColumn Width="Auto">
										<DataGridTemplateColumn.Header>
											<CheckBox HorizontalAlignment="Center"
										IsChecked="{Binding Path=DataContext.IsSelectedAll,
                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid, AncestorLevel=1}}"/>
										</DataGridTemplateColumn.Header>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<CheckBox  HorizontalAlignment="Center"  IsChecked="{Binding IsSelected}"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn IsReadOnly="True"
														Header="PROJECT NAME"
														Binding="{Binding InProject}"
														CanUserSort="True"/>
									<DataGridTemplateColumn IsReadOnly="True"
															Width="*"
															Header="PROFILE">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal">
													<Grid>
														<Ellipse Grid.Column="1"
																 Fill="{StaticResource AccentFillColorSelectedTextBackgroundBrush}"
																 Width="28"
																 Height="28"
																 VerticalAlignment="Center">
														</Ellipse>
														<TextBlock Text="{Binding Code}"
																   Foreground="{StaticResource TextOnAccentFillColorSelectedTextBrush}"
																   VerticalAlignment="Center"
																   HorizontalAlignment="Center"  />
													</Grid>
													<TextBlock VerticalAlignment="Center"
															   Margin="13 0 0 0"
															   Text="{Binding Title}"/>
												</StackPanel>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn IsReadOnly="True"
														Width="Auto"
														Header="IP"
														Binding="{Binding UserProfileModel.Proxy.Host}"/>
									<DataGridTextColumn IsReadOnly="True"
														Width="Auto"
														Header="PORT"
														Binding="{Binding UserProfileModel.Proxy.Port}"/>
									<DataGridTextColumn IsReadOnly="True"
														Width="Auto"
														Header="USERNAME"
														Binding="{Binding UserProfileModel.Proxy.UserName}"/>
									<DataGridTextColumn IsReadOnly="True"
														Header="PASSWORD"
														Binding="{Binding UserProfileModel.Proxy.Password}"/>
									<DataGridTemplateColumn IsReadOnly="True" >
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal"
															Cursor="Hand"
															Background="Transparent">
													<Button Theme="{StaticResource TransparentButton}"
															Command="{Binding ClickIconChangeProxiesCommand}">
														<ui:SymbolIcon Symbol="Add" />
													</Button>
												</StackPanel>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
							<Button Grid.Row="1"
													 DataContext="{Binding PaginatorViewModel}" />
							<!--{Binding HasSelectedItems}-->
							<Border Grid.Row="0"
									Grid.Column="0"
									Grid.ColumnSpan="2"
									Grid.RowSpan="2"
									IsVisible="False"
									Background="{StaticResource AccentFillColorDefaultBrush}"
									Padding="{StaticResource ChameleonControlMargin}"
									VerticalAlignment="Bottom">
								<StackPanel Orientation="Horizontal"
											HorizontalAlignment="Center"
											Spacing="16">
									<StackPanel Orientation="Horizontal"
												VerticalAlignment="Center">
										<TextBlock Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
												   Text="{Binding SelectedCount}"/>
										<TextBlock Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
												   Text=" Selected"/>
									</StackPanel>
									<Button Content="Unselect"
											Grid.Column="1"
											 Classes="accent"
											Command="{Binding UnselectItemsCommand}" />
									<Button Content="Change proxies"
											 Grid.Column="2"
											 Command="{Binding ChangeProxiesCommand}"/>
								</StackPanel>
							</Border>
						</Grid>
					</ctrls:ChameleonContentControl.Content>

					<ctrls:ChameleonContentControl.Footer>
						<Expander Header="PROXIES EDITOR"
								  VerticalAlignment="Bottom"
									 Name="SettingsExpander4"
								  ExpandDirection="Down"
											 IsExpanded="True">
								<Grid>
									<!--{Binding ShowCustomizeProxies}-->
									<Border CornerRadius="5 0"
										  Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
										  VerticalAlignment="Bottom"
										  IsVisible="True">
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="*"/>
											</Grid.RowDefinitions>
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition/>
													<ColumnDefinition/>
												</Grid.ColumnDefinitions>
												<TextBlock Text="CUSTOMIZE PROXIES"
														   Theme="{StaticResource SubtitleTextBlockStyle}"
														   Grid.Column="0"
														   VerticalAlignment="Center"
														   HorizontalAlignment="Left"
														   Margin="25 0 0 0"/>
												<DockPanel Grid.Column="1"
														   HorizontalAlignment="Right"
														   VerticalAlignment="Center" >
													<Button Classes="accent" Command="{Binding HideCustomizeProxiesCommand}">
														<ui:SymbolIcon Symbol="Clear" />
													</Button>
												</DockPanel>
											</Grid>
											<Grid  Grid.Row="1">
												<Grid.RowDefinitions>
													<RowDefinition Height="Auto"/>
													<RowDefinition Height="Auto"/>
													<RowDefinition Height="*"/>
												</Grid.RowDefinitions>
												<Grid.ColumnDefinitions>
													<ColumnDefinition/>
													<ColumnDefinition/>
												</Grid.ColumnDefinitions>
												<TextBlock FontSize="14"
													   Text="Please add your proxies using the format below"
													   Margin="36 0 0 0"
													   VerticalAlignment="Center"/>
												<Button Width="148"
													Height="46"
													Margin="0 12 33 10"
													Content="Apply changes"
													VerticalAlignment="Center"
													HorizontalAlignment="Right"
													Grid.Column="1"
													Command="{Binding ApplyProxyCommand}"/>
												<TextBlock Grid.Row="1" Grid.Column="0"
														   FontSize="14"
														   Text="NEW PROXY"
														   Margin="36 0 0 0"
														   VerticalAlignment="Center"/>
												<TextBlock Grid.Row="1" Grid.Column="1"
														   FontSize="14"
														   Text="CURRENT PROXY"
														   Margin="36 0 0 0"
														   VerticalAlignment="Center"/>
												<StackPanel Grid.Row="2"
															Grid.Column="0">
													<TextBox
															 Margin="24 9 0 0"
															 AcceptsReturn="True"
															 TextWrapping="NoWrap"
															 Height="199"
															 Text="{Binding ApplingProxy}"
															 BorderBrush="{StaticResource BorderOutlineButton}">
													</TextBox>
													<TextBox
															 Margin="24 10 0 0"
															 Text=":"
															 BorderBrush="{StaticResource BorderOutlineButton}"
															 IsHitTestVisible="False">
													</TextBox>
												</StackPanel>
												<ListBox Grid.Row="2"
															  Grid.Column="1"
															  x:Name="itemsList"
															  ItemsSource="{Binding ViewModels}"
															  Margin="16 0 22 0"
														 IsHitTestVisible="False">
													<ListBox.ItemTemplate>
														<DataTemplate>
															<TextBox IsReadOnly="True"
																	 VerticalAlignment="Center"
																	 Margin="0 8 0 0"
																	 BorderBrush="{StaticResource BorderOutlineButton}">
																<TextBox.Text>
																	<MultiBinding Converter="{StaticResource MultiStringJoin}">
																		<Binding Path="UserProfileModel.Proxy.Host"/>
																		<Binding Path="UserProfileModel.Proxy.Port" />
																		<Binding Path="UserProfileModel.Proxy.UserName" />
																		<Binding Path="UserProfileModel.Proxy.Password" />
																	</MultiBinding>
																</TextBox.Text>
															</TextBox>
														</DataTemplate>
													</ListBox.ItemTemplate>
												</ListBox>
											</Grid>
										</Grid>
									</Border>
								</Grid>
						</Expander>
					</ctrls:ChameleonContentControl.Footer>

				</ctrls:ChameleonContentControl>

				<!--<GridSplitter Grid.Column="1" />-->
			</Grid>
		</Border>
	</Design.PreviewWith>




	<ControlTheme TargetType="ctrls:ChameleonContentControl"
                  x:Key="{x:Type ctrls:ChameleonContentControl}">
		<Setter Property="Template">
			<ControlTemplate>
				<Grid RowDefinitions="Auto,*">

					<!-- Header -->
					<Panel>
						<!--<Button Theme="{StaticResource TransparentButton}"
                                Margin="8"
                                HorizontalAlignment="Right"
                                Name="MoreButton">
							<ui:SymbolIcon Symbol="More" FontSize="18" />
						</Button>-->
						<TextBlock Text="{TemplateBinding Title}"
								   Padding="12 8"
								   Theme="{StaticResource SubtitleTextBlockStyle}" />
					</Panel>

					<!-- Content Area -->
					<ThemeVariantScope Name="ThemeScopeProvider"
									   Grid.Row="1">
						<ui:FABorder Name="ControlPreviewAreaHost"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                CornerRadius="{DynamicResource OverlayCornerRadius}">
							<Grid RowDefinitions="Auto,Auto,Auto">
								<ContentPresenter Name="HeaderPresenter"
												  Content="{TemplateBinding Header}"
												  ContentTemplate="{TemplateBinding HeaderTemplate}"
												  HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
												  VerticalContentAlignment="Center" />
								
								<Grid Grid.Row="1" 
									  ColumnDefinitions="*,Auto"
									  RowDefinitions="Auto,*,Auto,Auto">
									<Rectangle Name="TopRowPlaceholder"
											   IsHitTestVisible="False"
											   IsVisible="False"
											   MinHeight="32" />

									<ContentPresenter Name="ExamplePresenter"
													  Content="{TemplateBinding Content}"
													  ContentTemplate="{TemplateBinding ContentTemplate}"
													  HorizontalAlignment="Stretch"
													  VerticalAlignment="Stretch"
													  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
													  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
													  Margin="12 12 0 12"
													  Grid.ColumnSpan="1"
													  Grid.Row="1"
													  Padding="12">
										<ContentPresenter.Transitions>
											<Transitions>
												<ThicknessTransition Duration="00:00:00.167" Property="Padding" />
											</Transitions>
										</ContentPresenter.Transitions>
									</ContentPresenter>

									<ui:FABorder Name="OptionsHost"
											Margin="12"
											Padding="8"
											CornerRadius="{DynamicResource OverlayCornerRadius}"
											Grid.Column="1"
											Grid.Row="1"
											Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
											BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
											BorderThickness="1"
											Opacity="1"
											IsVisible="False">
										<ui:FABorder.Transitions>
											<Transitions>
												<DoubleTransition Property="Opacity" Duration="00:00:00.167" />
											</Transitions>
										</ui:FABorder.Transitions>
										<StackPanel>
											<DockPanel LastChildFill="False">
												<TextBlock Text="Options"
														   DockPanel.Dock="Left"
														   HorizontalAlignment="Left"
														   VerticalAlignment="Center"
														   FontWeight="SemiBold"
														   Margin="0 3" />

												<Button Name="ShowHideOptionsButton"
														Theme="{StaticResource TransparentButton}"
														DockPanel.Dock="Right"
														Margin="6 0 0 0"
														IsVisible="False">
													<ui:SymbolIcon Name="OptionsChevron"
																   Symbol="ChevronDown" />
												</Button>
											</DockPanel>
											<ContentPresenter Name="OptionPresenter"
															  Content="{TemplateBinding Options}"
															  HorizontalContentAlignment="Stretch"
															  VerticalContentAlignment="Stretch"
															  IsVisible="{TemplateBinding IsOptionsExpanded}"/>
										</StackPanel>
									</ui:FABorder>

								</Grid>

								<ContentPresenter Name="FooterPresenter"
			Content="{TemplateBinding Footer}"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Bottom"
			HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
			VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
			  Margin="12"
			  CornerRadius="0 0 8 8"
			Grid.ColumnSpan="2"
			Grid.Row="2">
								</ContentPresenter>

							</Grid>
							
						</ui:FABorder>
					</ThemeVariantScope>


					<!-- Code Preview -->
					<!--<Expander CornerRadius="0 0 8 8"
                              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                              Name="SourcePreviewArea"
                              IsVisible="False">-->
						<!--<Expander.Header>
							<Panel>
								<ui:IconSourceElement IconSource="{StaticResource SourceCodeIcon}"
                                                      Width="20" Height="20"/>
								<Viewbox Width="20" Height="20"
                                         Stretch="Uniform"
                                         HorizontalAlignment="Left">
									<ui:ImageIcon>
										<DrawingImage>
											<DrawingGroup>
												<GeometryDrawing Brush="{DynamicResource TextFillColorPrimaryBrush}"
                                                                 Geometry="M 13,13 C 12.577726,13 12.156163,13.160231 11.833984,13.482422 L 2.4824219,22.833984 2.3242188,23.017578 C 1.8449479,23.663499 1.896627,24.580156 2.4824219,25.166016 L 11.833984,34.517578 12.017578,34.675781 C 12.663521,35.155161 13.580222,35.103438 14.166016,34.517578 14.810375,33.873198 14.810375,32.827755 14.166016,32.183594 L 5.984375,24 14.166016,15.816406 14.326172,15.630859 C 14.805443,14.984917 14.751811,14.068194 14.166016,13.482422 13.843837,13.160231 13.422274,13 13,13 Z M 34.884766,13.003906 C 34.501635,13.030534 34.126804,13.189524 33.833984,13.482422 33.189603,14.12678 33.189603,15.172026 33.833984,15.816406 L 42.015625,24 33.833984,32.183594 33.673828,32.369141 C 33.194448,33.015062 33.248123,33.931938 33.833984,34.517578 34.478364,35.161958 35.521636,35.161958 36.166016,34.517578 L 45.517578,25.166016 45.675781,24.982422 C 46.155162,24.336502 46.103439,23.419624 45.517578,22.833984 L 36.166016,13.482422 35.982422,13.324219 C 35.659461,13.084572 35.267896,12.977278 34.884766,13.003906 Z" />
												<GeometryDrawing Brush="{DynamicResource AccentFillColorDefaultBrush}"
                                                                 Geometry="M 15.344371,39.275058 29.644335,7.3750199 C 30.017235,6.5434859 30.993375,6.1715759 31.824975,6.5443219 32.587276,6.8860259 32.963256,7.7348519 32.733576,8.5144448 L 32.655696,8.7249188 18.355645,40.624979 C 17.982899,41.45658 17.006604,41.82838 16.17507,41.4557 15.412813,41.114039 15.036789,40.265059 15.266535,39.485599 L 15.344371,39.275058 29.644335,7.3750199 Z" />
											</DrawingGroup>
										</DrawingImage>
									</ui:ImageIcon>
								</Viewbox>
								<TextBlock Text="Example source code"
                                           Margin="32 0 0 0" />
							</Panel>
						</Expander.Header>-->

						<!--<StackPanel>-->

							<!-- Xaml source first -->
							<!--<local:SampleCodePresenter Header="XAML"
													   Code="{TemplateBinding XamlSource}"
													   Substitutions="{TemplateBinding Substitutions}"
													   SampleType="XAML"
													   Name="XamlPresenter"
													   IsVisible="False"/>-->

							<!--<Rectangle Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                       Height="1"
                                       IsVisible="{Binding #XamlPresenter.IsVisible}"
                                       Margin="0 0 0 8" />-->

							<!--<local:SampleCodePresenter Header="C#"
													   Code="{TemplateBinding CSharpSource}"
													   Substitutions="{TemplateBinding Substitutions}"
													   SampleType="CSharp"
													   Name="CSharpPresenter"
													   IsVisible="False"/>-->

							<!--<Rectangle Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                       Height="1"
                                       IsVisible="{Binding #CSharpPresenter.IsVisible}"
                                       Margin="0 0 0 8" />-->

							<!--<local:SampleCodePresenter Header="Additional Notes"
                                                       Code="{TemplateBinding UsageNotes}"
                                                       Substitutions="{TemplateBinding Substitutions}"
                                                       SampleType="Text"
                                                       Name="NotesPresenter"
                                                       IsVisible="False"/>-->

						<!--</StackPanel>
					</Expander>-->
				</Grid>
			</ControlTemplate>
		</Setter>

		<Style Selector="^ /template/ ui|FABorder#ControlPreviewAreaHost">
			<Setter Property="CornerRadius" Value="{Binding Source={StaticResource OverlayCornerRadius}, Converter={StaticResource BottomCornerRadiusFilterConverter}}" />
		</Style>

		<!--<Style Selector="^:codepreview">
			<Style Selector="^ /template/ Expander#SourcePreviewArea">
				<Setter Property="IsVisible" Value="True" />
			</Style>
			<Style Selector="^ /template/ ui|FABorder#ControlPreviewAreaHost">
				<Setter Property="CornerRadius" Value="4 4 0 0" />
				<Setter Property="BorderThickness" Value="1 1 1 0" />
			</Style>

			<Style Selector="^:xamlsource /template/ local|SampleCodePresenter#XamlPresenter">
				<Setter Property="IsVisible" Value="True" />
			</Style>
			<Style Selector="^:csharpsource /template/ local|SampleCodePresenter#CSharpPresenter">
				<Setter Property="IsVisible" Value="True" />
			</Style>
			<Style Selector="^:usagenotes /template/ local|SampleCodePresenter#NotesPresenter">
				<Setter Property="IsVisible" Value="True" />
			</Style>
		</Style>-->

		<Style Selector="^:options /template/ ui|FABorder#OptionsHost">
			<Setter Property="IsVisible" Value="True" />
		</Style>

		<Style Selector="^:mediumWidth">
			<Style Selector="^ /template/ ContentPresenter#ExamplePresenter">
				<Setter Property="Grid.ColumnSpan" Value="2" />
				<Setter Property="Padding" Value="12 24 12 12" />
			</Style>

			<Style Selector="^ /template/ ui|FABorder#OptionsHost">
				<Setter Property="Grid.Column" Value="0" />
				<Setter Property="Grid.Row" Value="0" />
				<Setter Property="Grid.RowSpan" Value="2" />
				<Setter Property="HorizontalAlignment" Value="Right" />
				<Setter Property="VerticalAlignment" Value="Top" />
				<Setter Property="Opacity" Value="0.5" />
				<Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
			</Style>
			<Style Selector="^ /template/ Rectangle#TopRowPlaceholder">
				<Setter Property="IsVisible" Value="True" />
			</Style>
			<Style Selector="^ /template/ Button#ShowHideOptionsButton">
				<Setter Property="IsVisible" Value="True" />
			</Style>

			<Style Selector="^ /template/ ui|FABorder#OptionsHost:pointerover">
				<Setter Property="Opacity" Value="1" />
			</Style>

			<!-- Small width applies on top of medium width -->
			<Style Selector="^:smallWidth">
				<Style Selector="^ /template/ Button#ShowHideOptionsButton">
					<Setter Property="IsVisible" Value="False" />
				</Style>

				<Style Selector="^ /template/ ui|FABorder#OptionsHost">
					<Setter Property="Grid.Column" Value="0" />
					<Setter Property="Grid.ColumnSpan" Value="2" />
					<Setter Property="Grid.Row" Value="2" />
					<Setter Property="Grid.RowSpan" Value="1" />
					<Setter Property="HorizontalAlignment" Value="Center" />
					<Setter Property="VerticalAlignment" Value="Top" />
					<Setter Property="Opacity" Value="1" />
					<Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
				</Style>
				<Style Selector="^ /template/ Rectangle#TopRowPlaceholder">
					<Setter Property="IsVisible" Value="False" />
				</Style>
			</Style>
		</Style>

		<Style Selector="^:optionsfull /template/ ui|SymbolIcon#OptionsChevron">
			<Setter Property="Symbol" Value="ChevronUp" />
		</Style>

	</ControlTheme>
</ResourceDictionary>
