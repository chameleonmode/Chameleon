<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d"
             x:Class="Chameleon.Av.Fluent.Dialogs.DefaultContentDialogTitle">
	<Panel Name="HeaderHost">
		<Viewbox Name="IconHost"
				 Width="{StaticResource DefaultContentDialogIconSize}"
				 Height="{StaticResource DefaultContentDialogIconSize}"
				 VerticalAlignment="Center"
				 HorizontalAlignment="Left"
				 Margin="{StaticResource DefaultContentTaskDialogIconMargin}">
			<ui:FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
						 Glyph="{Binding Glyph}"
						 FontSize="28"/>
		</Viewbox>
		<TextBlock Text="{Binding Title}"
				   TextWrapping="Wrap"
				   FontSize="{DynamicResource TaskDialogHeaderFontSize}"
				   FontWeight="{StaticResource TaskDialogHeaderFontWeight}"
				   VerticalAlignment="Center"
				   HorizontalAlignment="Left"
				   Margin="{DynamicResource TaskDialogHeaderPadding}"
				   IsVisible="True"
				   Name="HeaderText"/>
	</Panel>
</UserControl>
