<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="640"
			 xmlns:ctrls="using:Chameleon.Av.Fluent.Common.Controls"
			 xmlns:vm="using:Chameleon.Av.Fluent.Dialogs.ViewModels"
			 x:DataType="vm:AuthTaskDialogViewModel"
             x:CompileBindings="True"
             x:Class="Chameleon.Av.Fluent.Dialogs.LoginContentDialogContent">
	<ctrls:ChameleonDialogControl>
		<ctrls:ChameleonDialogControl.Header>
			<StackPanel>
				<TextBlock Text="{Binding Title}" />
			</StackPanel>
		</ctrls:ChameleonDialogControl.Header>
		<StackPanel>
			<StackPanel>
				<TextBlock Text="Email:"
							Margin="{StaticResource ContentDialogTitleFieldMargin}"/>
				<TextBox Margin="{StaticResource ContentDialogTextboxFieldMargin}"
					Text="{Binding UserName}"
					IsEnabled="{Binding IsInputEnabled}" />
			</StackPanel>

			<StackPanel>
				<TextBlock Text="Licence Key:"
						   Margin="{StaticResource ContentDialogTitleFieldMargin}"/>
				<TextBox Margin="{StaticResource ContentDialogTextboxFieldMargin}"
					Text="{Binding LicenceKey}"
					IsEnabled="{Binding IsInputEnabled}" />
			</StackPanel>
		</StackPanel>
	</ctrls:ChameleonDialogControl>
</UserControl>
