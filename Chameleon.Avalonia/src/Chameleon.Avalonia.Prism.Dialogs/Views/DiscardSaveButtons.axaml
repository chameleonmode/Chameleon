<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Chameleon.Avalonia.Prism.Dialogs.DiscardSaveButtons">
	<StackPanel
        Orientation="Horizontal"
        HorizontalAlignment="Right">
		<!--Style="{StaticResource OutlinedButton}"-->
		<Button
            Content="Discard"
            Command="{Binding DiscardCommand}"
            Height="40"
            Width="143"
            
            FontSize="14"
            Foreground="{StaticResource MainBlack}"
            Background="{StaticResource GradientButtonBackground}"/>
		<Button
            Margin="8 0 0 0"
            Content="Save changes"
            Command="{Binding SaveChangesCommand}"
            IsEnabled="{Binding HasSelected}"
            Height="40"
            Width="137"
            Background="{StaticResource ButtonDarkBrush}"
            Foreground="White"
            FontFamily="Open Sans"
            FontWeight="DemiBold"
            FontSize="14"/>
	</StackPanel>
</UserControl>
