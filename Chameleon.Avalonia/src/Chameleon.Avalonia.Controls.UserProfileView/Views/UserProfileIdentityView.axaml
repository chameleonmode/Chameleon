<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:afv="using:Chameleon.Av.Fluent.Common.Controls"
			 xmlns:ups="using:Chameleon.Avalonia.Controls.UserProfilesView"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="800"
			 xmlns:vm="using:Chameleon.Avalonia.Controls.UserProfileView.ViewModels"
			 x:DataType="vm:UserProfileIdentityViewModel"
			 x:CompileBindings="True"
             x:Class="Chameleon.Avalonia.Controls.UserProfileView.UserProfileIdentityView"
			 Name="UC">
	<UserControl.Resources>
		<ControlTheme x:Key="TheseTabHeaderPanels"
					  TargetType="HeaderedContentControl">
			<Setter Property="Template">
				<ControlTemplate>
					<Panel Width="144"
						   Height="36">
						<StackPanel
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							VerticalAlignment="Center">
							<afv:SvgIconControl
								Height="18"
								IconName="{TemplateBinding Content}" />
							<TextBlock
								Text="{TemplateBinding Header}"
								VerticalAlignment="Center"
								Theme="{StaticResource SubtitleTextBlockStyle}"
								Margin="6 0 0 0"/>
						</StackPanel>
					</Panel>
				</ControlTemplate>
			</Setter>
		</ControlTheme>

		<ControlTheme x:Key="TheseOptionsHeaderPanels"
					  TargetType="HeaderedContentControl">
			<Setter Property="Template">
				<ControlTemplate>
					<Grid VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock Text="{TemplateBinding Header}"
								   VerticalAlignment="Center"
								   Theme="{StaticResource SubtitleTextBlockStyle}"/>
						<Button
							Grid.Column="1"
							Content="plus-in-circle"
							Theme="{StaticResource SvgIconTextButton}"
							Tag="{TemplateBinding Content}"
							CommandParameter="{TemplateBinding Tag}"
							Command="{Binding CfromVCommand}" />
					</Grid>
				</ControlTemplate>
			</Setter>
		</ControlTheme>
	</UserControl.Resources>
	<UserControl.Styles>
		<Style Selector="Button.TheseDeleteBtns">
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="Tag" Value="Delete" />
			<Setter Property="Content" Value="delete" />
			<Setter Property="Theme" Value="{StaticResource SvgIconTextButton}" />
			<Setter Property="CommandParameter" Value="{Binding}" />
		</Style>
		<Style Selector="Expander.TheseExpanders">
			<Setter Property="IsExpanded" Value="{ReflectionBinding IsOpenSearchParameters, FallbackValue=True}" />
			<Setter Property="Header" Value="{ReflectionBinding Title}" />
			<Setter Property="Margin" Value="0 0 0 6" />
			<Setter Property="Background" Value="{StaticResource LayerFillColorDefaultBrush}" />
		</Style>
		<Style Selector="ItemsControl.TheseItemControls">
			<Setter Property="Grid.Row" Value="1" />
			<Setter Property="Margin" Value="0 20 0 0" />
		</Style>
		<!--Use Classes="RadioButtonListBox" in any ListBox to represent its items as RadioButtons-->
		<!--https://github.com/AvaloniaUI/Avalonia/issues/3016-->
		<Style Selector="ListBox.RadioButtonListBox">
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="ListBox.RadioButtonListBox ListBoxItem">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate>
						<Border Background="Transparent">
							<RadioButton Content="{TemplateBinding ContentPresenter.Content}"
										 VerticalAlignment="Center"
										 IsChecked="{Binding Path=IsSelected,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Styles>
	<Grid RowDefinitions="Auto,*">
		<Grid ColumnDefinitions="*,Auto">
			<ups:UserProfileView Name="UPView" DataContext="{Binding ProfileVM}" />

				<StackPanel Grid.Column="1"
							Orientation="Horizontal"
							HorizontalAlignment="Right"
							Margin="6 6 12 0"
							Spacing="4">
					<Button
						ToolTip.Tip="Discard changes"
						Content="Undo"
						Classes="accent"
						Theme="{StaticResource AccentSymbleIconButton}"
						Command="{Binding DiscardCommand}"/>
					<Button 
						ToolTip.Tip="Save Changes"
						Content="Save" 
						Classes="accent"
						Theme="{StaticResource AccentSymbleIconButton}"
						Command="{Binding SaveChangesCommand}"/>
				</StackPanel>
		</Grid>

		<TabControl Grid.Row="2"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					Padding="108 18"
					BorderThickness="0"
					SelectedIndex="{Binding SelectedTadIndex}">
			<TabItem>
				<TabItem.Header>
					<HeaderedContentControl
						Content="profile-main"
						Header="Main"
						Theme="{StaticResource TheseTabHeaderPanels}"/>
				</TabItem.Header>
				<TabItem.Content>
					<StackPanel Spacing="18">
						<afv:HeaderdInputFieldsControl Title="PROFILE NAME"
													   Text="{Binding UserProfileModel.Title, FallbackValue=NAME}" />

						<afv:HeaderdInputFieldsControl Title="PROXY CONFIGURATION"
													   Header="False">
							<afv:HeaderdInputFieldsControl.TextBoxes>
								<TextBox Text="{Binding Path=UserProfileModel.Proxy.Host}" />
								<TextBox Text="{Binding Path=UserProfileModel.Proxy.PortString}"  />
								<TextBox Text="{Binding Path=UserProfileModel.Proxy.UserName}" />
								<TextBox Text="{Binding Path=UserProfileModel.Proxy.Password}"  />
							</afv:HeaderdInputFieldsControl.TextBoxes>
						</afv:HeaderdInputFieldsControl>

						<afv:HeaderdInputFieldsControl Title="NOTES"
													   Text="{Binding UserProfileModel.Notes, FallbackValue=Notes}" />

						<!--<afv:HeaderdInputFieldsControl Title="CANVAS VALUE"
													   Text="{Binding UserProfileModel.WebBrowser.Canvas, FallbackValue=Canvas}" />-->


						<!--<TextBlock Text="BROWSER SPOOF SETTINGS" />
						<UniformGrid>
							<CheckBox Content="Audio Context"
							  IsChecked="{Binding Path=UserProfileModel.WebBrowser.AudioContext}" />
							<CheckBox Content="Web RTC off"
									  IsChecked="{Binding Path=!UserProfileModel.WebBrowser.WebRTC}" />
							<CheckBox Content="Web GL off"
									  IsChecked="{Binding Path=!UserProfileModel.WebBrowser.WebGL}" />
							<CheckBox Content="Do Not Track"
									  IsChecked="{Binding Path=!UserProfileModel.WebBrowser.Tracking}" />
							<CheckBox Content="Flash"
									  IsChecked="{Binding Path=!UserProfileModel.WebBrowser.Flash}" />
						</UniformGrid>-->

						<!--
						TODO: theres no current setting for this so its confusing
						<TextBlock Text="USER AGENT" />
						<StackPanel>
							<TextBlock Text="User Agent"  />
							<TextBlock Text="Firefox/90.0 Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:90.0) Gecko/20100101 Firefox/90.0"/>
						</StackPanel>-->
					</StackPanel>
				</TabItem.Content>
			</TabItem>
			<TabItem>
				<TabItem.Header>
					<HeaderedContentControl
						Content="profile-persons"
						Header="Persons"
						Theme="{StaticResource TheseTabHeaderPanels}"/>
				</TabItem.Header>
				<TabItem.Content>
					<Panel>
						<HeaderedContentControl Theme="{StaticResource HasNoItemsTheme}"
												IsVisible="{Binding !HasNoItems}" />
						<Grid RowDefinitions="Auto,*">
							<HeaderedContentControl
								Theme="{StaticResource TheseOptionsHeaderPanels}"
								Header="{Binding Persons.Count, StringFormat='You have {0} persons added.'}"
								Content="Add Person"
								Tag="AddPerson" />

							<ItemsControl Classes="TheseItemControls"
										  ItemsSource="{Binding Path=Persons}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Expander Classes="TheseExpanders">
											<StackPanel Spacing="18">
												<afv:HeaderdInputFieldsControl Title="Title"
																					 Text="{Binding Title, FallbackValue=Title}" />

												<afv:HeaderdInputFieldsControl Title="Name first, middle, last"
																					 Header="False">
													<afv:HeaderdInputFieldsControl.TextBoxes>
														<TextBox  Text="{Binding FirstName,FallbackValue=first}" />
														<TextBox  Text="{Binding MiddleName,FallbackValue=middle}"  />
														<TextBox Text="{Binding LastName,FallbackValue=last}" />
													</afv:HeaderdInputFieldsControl.TextBoxes>
												</afv:HeaderdInputFieldsControl>

												<afv:HeaderdInputFieldsControl Title="Job Title"
																			   Text="{Binding JobTitle, FallbackValue=JobTitle}" />

												<afv:HeaderdInputFieldsControl Title="Phone Number"
																			   Text="{Binding PhoneNumber, FallbackValue=PhoneNumber}" />

												<UniformGrid Rows="1">
													<ListBox ItemsSource="{ReflectionBinding GenderTypeList}"
															 SelectedItem="{Binding Gender}"
															 Classes="RadioButtonListBox"/>
													<!--<Border HorizontalAlignment="Stretch" Padding="15 0 22 0">
														<RadioButton
															GroupName="rbgGender"
															IsChecked="{Binding GenderMale}">
															<RadioButton.Content>
																<TextBlock Text="Male"  />
															</RadioButton.Content>
														</RadioButton>
													</Border>
													<Border Grid.Column="1" Padding="15 0 22 0">
														<RadioButton GroupName="rbgGender"
															IsChecked="{Binding GenderFeMale}">
															<RadioButton.Content>
																<TextBlock Text="Female"  />
															</RadioButton.Content>
														</RadioButton>
													</Border>-->
												</UniformGrid>

												<DatePicker SelectedDate="{Binding BirthDateOffset, FallbackValue=1/2/23}"
															Margin="0"/>

												<afv:HeaderdInputFieldsControl Title="BirthPlace"
																					 Text="{Binding BirthPlace, FallbackValue=BirthPlace}" />

												<afv:HeaderdInputFieldsControl Title="Notes"
																			   Text="{Binding Notes, FallbackValue=Notes}" />

												<Button Classes="TheseDeleteBtns"
														Command="{ReflectionBinding Path=$parent[ItemsControl].DataContext.DeletePersonCommand}" />
											</StackPanel>
										</Expander>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</Panel>
				</TabItem.Content>
			</TabItem>
			<TabItem>
				<TabItem.Header>
					<HeaderedContentControl
						Content="profile-businesses"
						Header="Businesses"
						Theme="{StaticResource TheseTabHeaderPanels}"/>
				</TabItem.Header>
				<TabItem.Content>
					<Panel>
						<HeaderedContentControl Theme="{StaticResource HasNoItemsTheme}"
												IsVisible="{Binding !HasNoBusinessItems}" />
						<Grid RowDefinitions="Auto,*">
							<HeaderedContentControl
								Theme="{StaticResource TheseOptionsHeaderPanels}"
								Header="{Binding Businesses.Count, StringFormat='You have {0} businesses added.'}"
								Content="Add Business"
								Tag="AddBusiness" />

							<ItemsControl Classes="TheseItemControls"
										  ItemsSource="{Binding Path=Businesses}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Expander Classes="TheseExpanders">
											<StackPanel Spacing="18">
												<afv:HeaderdInputFieldsControl Title="Title"
																			   Text="{Binding Title, FallbackValue=Title}" />

												<afv:HeaderdInputFieldsControl Title="Company Name"
																			   Text="{Binding CompanyName, FallbackValue=CompanyName}" />

												<afv:HeaderdInputFieldsControl Title="Department"
																			   Text="{Binding Department, FallbackValue=Department}" />

												<afv:HeaderdInputFieldsControl Title="Phone Number"
																			   Text="{Binding PhoneNumber, FallbackValue=PhoneNumber}" />

												<afv:HeaderdInputFieldsControl Title="Web Site"
																			   Text="{Binding WebSite, FallbackValue=WebSite}" />

												<afv:HeaderdInputFieldsControl Title="Notes"
																			   Text="{Binding Notes, FallbackValue=Notes}" />

												<Button Classes="TheseDeleteBtns"
														Command="{ReflectionBinding Path=$parent[ItemsControl].DataContext.DeleteBusinessCommand}" />
											</StackPanel>
										</Expander>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</Panel>
				</TabItem.Content>
			</TabItem>
			<TabItem>
				<TabItem.Header>
					<HeaderedContentControl
						Content="profile-addresses"
						Header="Addresses"
						Theme="{StaticResource TheseTabHeaderPanels}"/>
				</TabItem.Header>
				<TabItem.Content>
					<Panel>
						<HeaderedContentControl Theme="{StaticResource HasNoItemsTheme}"
												IsVisible="{Binding !HasNoAddressesItems}" />
						<Grid RowDefinitions="Auto,*">
							<HeaderedContentControl
								Theme="{StaticResource TheseOptionsHeaderPanels}"
								Header="{Binding Addresses.Count, StringFormat='You have {0} addresses added.'}"
								Content="Add Address"
								Tag="AddAddress" />

							<ItemsControl Classes="TheseItemControls"
										  ItemsSource="{Binding Path=Addresses}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Expander Classes="TheseExpanders">
											<StackPanel Spacing="18">
												<afv:HeaderdInputFieldsControl Title="Title"
																			   Text="{Binding Title, FallbackValue=Title}" />

												<afv:HeaderdInputFieldsControl Title="AddressLine1"
																			   Text="{Binding AddressLine1, FallbackValue=AddressLine1}" />

												<afv:HeaderdInputFieldsControl Title="AddressLine2"
																			   Text="{Binding AddressLine2, FallbackValue=AddressLine2}" />

												<afv:HeaderdInputFieldsControl Title="City"
																			   Text="{Binding City, FallbackValue=City}" />

												<afv:HeaderdInputFieldsControl Title="State"
																			   Text="{Binding State, FallbackValue=State}" />

												<afv:HeaderdInputFieldsControl Title="Zip"
																			   Text="{Binding Zip, FallbackValue=Zip}" />

												<ComboBox ItemsSource="{ReflectionBinding Path=$parent[ItemsControl].DataContext.Countries}"
														  SelectedItem="{ReflectionBinding SelectedCountry}"
														  Margin="0 0 6 0"
														  PlaceholderText="Country"
														  HorizontalAlignment="Stretch">
													<ComboBox.ItemTemplate>
														<DataTemplate>
															<TextBlock Text="{ReflectionBinding Name}" />
 														</DataTemplate>
													</ComboBox.ItemTemplate>
												</ComboBox>

												<afv:HeaderdInputFieldsControl Title="Notes"
																			   Text="{Binding Notes, FallbackValue=Notes}" />

												<Button Classes="TheseDeleteBtns"
														Command="{ReflectionBinding Path=$parent[ItemsControl].DataContext.DeleteAddressCommand}" />
											</StackPanel>
										</Expander>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</Panel>
				</TabItem.Content>
			</TabItem>
			<TabItem>
				<TabItem.Header>
					<HeaderedContentControl
						Content="profile-logins"
						Header="Logins"
						Theme="{StaticResource TheseTabHeaderPanels}"/>
				</TabItem.Header>
				<TabItem.Content>
					<Panel>
						<HeaderedContentControl Theme="{StaticResource HasNoItemsTheme}"
												IsVisible="{Binding !HasNoLoginsItems}" />
						<Grid RowDefinitions="Auto,*">
							<HeaderedContentControl
								Theme="{StaticResource TheseOptionsHeaderPanels}"
								Header="{Binding Logins.Count, StringFormat='You have {0} logins added.'}"
								Content="Add Login"
								Tag="AddLogin" />

							<ItemsControl Classes="TheseItemControls"
										  ItemsSource="{Binding Path=Logins}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Expander Classes="TheseExpanders">
											<StackPanel Spacing="18">
												<afv:HeaderdInputFieldsControl Title="Title"
																			   Text="{Binding Title, FallbackValue=Title}" />

												<afv:HeaderdInputFieldsControl Title="WebSite"
																			   Text="{Binding WebSite, FallbackValue=WebSite}" />

												<afv:HeaderdInputFieldsControl Title="Email"
																			   Text="{Binding Email, FallbackValue=Email}" />

												<afv:HeaderdInputFieldsControl Title="UserName"
																			   Text="{Binding UserName, FallbackValue=UserName}" />

												<afv:HeaderdInputFieldsControl Title="Password"
																			   Text="{Binding Password, FallbackValue=Password}" />

												<afv:HeaderdInputFieldsControl Title="Notes"
																			   Text="{Binding Notes, FallbackValue=Notes}" />

												<Button Classes="TheseDeleteBtns"
														Command="{ReflectionBinding Path=$parent[ItemsControl].DataContext.DeleteLoginCommand}" />
											</StackPanel>
										</Expander>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</Panel>
				</TabItem.Content>
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>
